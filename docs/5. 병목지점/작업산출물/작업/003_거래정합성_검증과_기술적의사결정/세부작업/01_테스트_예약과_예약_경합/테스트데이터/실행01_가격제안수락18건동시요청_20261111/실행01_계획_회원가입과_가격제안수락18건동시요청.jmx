        </hashTree>
        <LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="흥정 구매자 18명마다 판매자의 대화 상세 조회(요청 전 상태)" enabled="true">
          <stringProp name="LoopController.loops">18</stringProp>
          <boolProp name="LoopController.continue_forever">true</boolProp>
        </LoopController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="판매자의 흥정 구매자 ${cur_no} 대화 상세 조회(요청 전 상태)" enabled="true">
            <stringProp name="TestPlan.comments">판매자가 이 흥정 구매자의 대화 상세를 조회해 가격 제안이 응답 대기인지, 예약과 주문이 없는지 확인한다.</stringProp>
            <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
            <stringProp name="HTTPSampler.path">/ChatService/api/conversations/${cur_conv}</stringProp>
            <stringProp name="HTTPSampler.method">GET</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
              <collectionProp name="Arguments.arguments"/>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="이번 반복의 흥정 구매자 정하기" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">// 이번 반복에서 대화 상세를 조회할 흥정 구매자를 정한다.
int n = (vars.get(&apos;check_index&apos;) as int) + 1
vars.put(&apos;check_index&apos;, String.valueOf(n))
vars.put(&apos;cur_no&apos;, String.format(&apos;%02d&apos;, n))
vars.put(&apos;cur_conv&apos;, vars.get(&apos;conv_&apos; + n))
</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
            <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="판매자 로그인 쿠키" enabled="true">
              <collectionProp name="HeaderManager.headers">
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">Cookie</stringProp>
                  <stringProp name="Header.value">Authorization=${seller_token}</stringProp>
                </elementProp>
              </collectionProp>
            </HeaderManager>
            <hashTree/>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="응답 코드 200" enabled="true">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="49586">200</stringProp>
              </collectionProp>
              <stringProp name="Assertion.custom_message"></stringProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">8</intProp>
            </ResponseAssertion>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="가격 제안 상태와 예약, 주문을 변수에 넣고 응답 본문 저장(실행 폴더의 요청전_흥정구매자번호_대화상세응답.json)" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
// 판매자가 본 대화 상세에서 이 흥정 구매자의 가격 제안 상태와 수량, 예약, 주문을 변수에 넣고, 응답 본문을 실행 폴더에 저장한다.
String n = vars.get(&apos;check_index&apos;)
String body = prev.getResponseDataAsString()
new File(vars.get(&apos;outDir&apos;), &apos;요청전_흥정구매자&apos; + vars.get(&apos;cur_no&apos;) + &apos;_대화상세응답.json&apos;).setText(body, &apos;UTF-8&apos;)
try {
    def j = new JsonSlurper().parseText(body)
    def offer = j.offers?.find { String.valueOf(it.offerId) == vars.get(&apos;offer_&apos; + n) }
    vars.put(&apos;pre_offer_status_&apos; + n, offer ? String.valueOf(offer.status) : &apos;없음&apos;)
    vars.put(&apos;pre_offer_qty_&apos; + n, offer ? String.valueOf(offer.quantity) : &apos;없음&apos;)
    vars.put(&apos;pre_reservation_&apos; + n, j.reservation ? String.valueOf(j.reservation.reservationId) : &apos;-&apos;)
    vars.put(&apos;pre_order_count_&apos; + n, String.valueOf(j.orders ? j.orders.size() : 0))
} catch (Exception e) {
    [&apos;pre_offer_status_&apos;, &apos;pre_offer_qty_&apos;, &apos;pre_reservation_&apos;, &apos;pre_order_count_&apos;].each { vars.put(it + n, &apos;확인못함&apos;) }
}
</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>
        </hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="요청 전 상태 확인과 수락 경합에 넘길 값 정하기(실행 폴더의 준비_ID와_요청전상태.csv, 준비_요청전상태_요약.csv)" enabled="true">
          <stringProp name="TestPlan.comments">흥정 구매자 18명의 회원 ID, 대화 ID, 제안 ID, 제안 수량, 요청 전 가격 제안 상태와 예약·주문, 서버 로그용 요청 ID를 준비_ID와_요청전상태.csv에 쓴다. 남은 수량과 구매 가능 수량이 50개이고, 응답 대기 제안이 18건이고, 제안 수량 합계가 60개이고, 예약과 주문이 없으면 「기본 구성과 같음」으로 표시한다. 다르더라도 다음 그룹은 그대로 실행한다.</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import java.net.URLEncoder

// 흥정 구매자 18명의 ID와 요청 전 상태를 실행 폴더의 준비_ID와_요청전상태.csv에 쓰고, 요청 전 상태가 기본 구성과 같은지 확인한다.
// 속성에는 빈 값을 넣을 수 없으므로 값이 없으면 「-」를 넣는다.
def put = { String key, Object value -&gt; props.put(key, value == null ? &apos;-&apos; : value.toString()) }
long expectedQty = (vars.get(&apos;productQuantity&apos;) as long)
StringBuilder csv = new StringBuilder(&apos;﻿buyer_no,buyer_id,conversation_id,offer_id,offer_quantity,offer_status,reservation_id,order_count,request_log_id\n&apos;)
int pending = 0
long qtySum = 0
int reservations = 0
long orders = 0
boolean readable = true
for (int n = 1; n &lt;= 18; n++) {
    String no = String.format(&apos;%02d&apos;, n)
    String reqId = &apos;accept-&apos; + no
    List row = [no, vars.get(&apos;buyer_id_&apos; + n), vars.get(&apos;conv_&apos; + n), vars.get(&apos;offer_&apos; + n), vars.get(&apos;pre_offer_qty_&apos; + n),
                vars.get(&apos;pre_offer_status_&apos; + n), vars.get(&apos;pre_reservation_&apos; + n), vars.get(&apos;pre_order_count_&apos; + n), reqId]
    csv.append(row.join(&apos;,&apos;)).append(&apos;\n&apos;)
    if (vars.get(&apos;pre_offer_status_&apos; + n) == &apos;PENDING&apos;) pending++
    if ((vars.get(&apos;pre_offer_qty_&apos; + n) ?: &apos;&apos;).isLong()) qtySum += (vars.get(&apos;pre_offer_qty_&apos; + n) as long) else readable = false
    if (vars.get(&apos;pre_reservation_&apos; + n) != &apos;-&apos;) reservations++
    if ((vars.get(&apos;pre_order_count_&apos; + n) ?: &apos;&apos;).isLong()) orders += (vars.get(&apos;pre_order_count_&apos; + n) as long) else readable = false
    // 수락 경합 그룹과 저장 상태 확인 그룹이 쓸 값을 속성에 넣는다. 판매자의 로그인 토큰은 로그인 그룹이 속성에 넣는다.
    put(&apos;rsv.buyer_&apos; + n, vars.get(&apos;buyer_id_&apos; + n))
    put(&apos;rsv.conv_&apos; + n, vars.get(&apos;conv_&apos; + n))
    put(&apos;rsv.offer_&apos; + n, vars.get(&apos;offer_&apos; + n))
    put(&apos;rsv.qty_&apos; + n, vars.get(&apos;pre_offer_qty_&apos; + n))
}
long expectedOfferSum = (1..18).collect { (vars.get(&apos;offer_qty_&apos; + it) as long) }.sum()
put(&apos;rsv.product_id&apos;, vars.get(&apos;product_id&apos;))
put(&apos;rsv.run_log_id&apos;, vars.get(&apos;run_log_id&apos;))
put(&apos;rsv.test_log_name&apos;, URLEncoder.encode(vars.get(&apos;testLogName&apos;), &apos;UTF-8&apos;))
new File(vars.get(&apos;outDir&apos;), &apos;준비_ID와_요청전상태.csv&apos;).setText(csv.toString(), &apos;UTF-8&apos;)

boolean same = readable &amp;&amp; vars.get(&apos;pre_remaining&apos;) == String.valueOf(expectedQty) &amp;&amp; vars.get(&apos;pre_available&apos;) == String.valueOf(expectedQty) &amp;&amp;
        pending == 18 &amp;&amp; qtySum == expectedOfferSum &amp;&amp; reservations == 0 &amp;&amp; orders == 0
String result = same ? &apos;기본 구성과 같음&apos; : &apos;기본 구성과 다름&apos;
List summary = [vars.get(&apos;product_id&apos;), vars.get(&apos;pre_remaining&apos;), vars.get(&apos;pre_available&apos;), pending, qtySum, reservations, orders, result]
new File(vars.get(&apos;outDir&apos;), &apos;준비_요청전상태_요약.csv&apos;).setText(
        &apos;﻿product_id,remaining_quantity,available_quantity,pending_offer_count,offer_quantity_sum,reservation_count,order_count,check_result\n&apos; + summary.join(&apos;,&apos;) + &apos;\n&apos;, &apos;UTF-8&apos;)
SampleResult.setSuccessful(same)
SampleResult.setResponseMessage(&apos;요청 전 상태: &apos; + result)
SampleResult.setResponseData(&apos;상품ID=&apos; + vars.get(&apos;product_id&apos;) + &apos;, 남은 수량=&apos; + vars.get(&apos;pre_remaining&apos;) + &apos;, 판매자가 본 구매 가능 수량=&apos; + vars.get(&apos;pre_available&apos;) +
        &apos;, 응답 대기 제안=&apos; + pending + &apos;건, 제안 수량 합계=&apos; + qtySum + &apos;개, 예약=&apos; + reservations + &apos;건, 주문=&apos; + orders + &apos;건, 판정=&apos; + result + &apos;, 실행ID=&apos; + vars.get(&apos;run_log_id&apos;), &apos;UTF-8&apos;)
</stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="수락 경합: 판매자의 가격 제안 수락 18건을 같은 순간에 보냄" enabled="true">
        <stringProp name="TestPlan.comments">스레드 18개가 각각 흥정 구매자 한 명의 가격 제안을 맡는다. 동기화 타이머로 18개 요청을 같은 순간에 보낸다. 요청을 같은 순간에 보냈다는 사실만으로 서버의 수량 확인과 예약 저장이 겹쳤다고 보지 않고, 서버 로그로 확인한다.</stringProp>
