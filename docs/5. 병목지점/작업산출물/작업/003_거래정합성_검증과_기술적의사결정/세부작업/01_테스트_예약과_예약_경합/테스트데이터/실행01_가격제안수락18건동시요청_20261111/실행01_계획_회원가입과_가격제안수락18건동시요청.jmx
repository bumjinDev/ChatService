      <SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup" testname="회원 가입 준비: 가입 결과 CSV 새로 만들기">
        <stringProp name="TestPlan.comments">이 실행의 회원 가입 결과를 기록할 CSV 파일을 새로 만든다. 「회원 가입: 판매자 1명과 흥정 구매자 18명」 그룹보다 먼저 실행한다.</stringProp>
        <intProp name="ThreadGroup.num_threads">1</intProp>
