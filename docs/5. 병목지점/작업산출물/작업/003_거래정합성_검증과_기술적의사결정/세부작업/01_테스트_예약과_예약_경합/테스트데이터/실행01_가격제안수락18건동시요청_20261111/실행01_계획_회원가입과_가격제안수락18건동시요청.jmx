        <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="CSV 데이터 셋 설정(회원 CSV를 한 줄씩 읽기, 끝나면 멈춤)" enabled="true">
          <stringProp name="filename">${memberFile}</stringProp>
