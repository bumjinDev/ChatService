        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="실행 ${run_id} ${role} 가입(${member_id})" enabled="true">
          <stringProp name="TestPlan.comments">회원 CSV의 한 줄에 있는 회원 ID와 비밀번호로 가입시킨다. 같은 회원이 이미 가입되어 있으면 409로 거절된다.</stringProp>
          <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
          <stringProp name="HTTPSampler.path">/ChatService/members/join</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{&quot;id&quot;:&quot;${member_id}&quot;,&quot;pw&quot;:&quot;${password}&quot;,&quot;nickName&quot;:&quot;${member_id}&quot;,&quot;tel&quot;:&quot;010-0000-0000&quot;,&quot;email&quot;:&quot;${member_id}@example.com&quot;}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="응답 코드 200" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49586">200</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message"></stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">8</intProp>
          </ResponseAssertion>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="가입 결과 CSV에 이 회원의 줄 쓰기" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">// 가입 결과 CSV 끝에 이 회원의 줄을 붙인다.
List row = [vars.get(&apos;run_id&apos;), vars.get(&apos;role&apos;), vars.get(&apos;buyer_no&apos;), vars.get(&apos;member_id&apos;), prev.getResponseCode()]
new File(vars.get(&apos;joinResultFile&apos;)).append(row.join(&apos;,&apos;) + &apos;\n&apos;, &apos;UTF-8&apos;)
</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="로그인: 판매자 1명과 흥정 구매자 18명">
        <stringProp name="TestPlan.comments">판매자와 흥정 구매자 18명이 로그인하고, 로그인 토큰을 JMeter 속성에 넣는다. 토큰은 파일에 쓰지 않는다. 같은 JMeter 창에서 이 그룹만 다시 실행하면 준비한 상품과 가격 제안은 그대로 두고 로그인 토큰만 새로 받는다.</stringProp>
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">0</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="회원 CSV에서 판매자와 흥정 구매자 18명의 ID와 비밀번호 읽기" enabled="true">
          <stringProp name="TestPlan.comments">회원 CSV에서 이 실행 번호의 판매자와 흥정 구매자 18명의 ID와 비밀번호를 읽는다. 준비 그룹이 속성에 넣은 값은 지우지 않는다.</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">// 회원 CSV에서 run_id가 runId와 같은 줄을 모두 읽는다.
String runId = vars.get(&apos;runId&apos;)
List&lt;String&gt; lines = new File(vars.get(&apos;memberFile&apos;)).readLines(&apos;UTF-8&apos;)
List&lt;String&gt; cols = (lines[0].replace(&apos;﻿&apos;, &apos;&apos;).trim().split(&apos;,&apos;) as List)
List&lt;Map&lt;String, String&gt;&gt; rows = []
for (String line : lines.drop(1)) {
    if (line.trim().isEmpty()) continue
    List&lt;String&gt; vals = (line.trim().split(&apos;,&apos;, -1) as List)
    Map&lt;String, String&gt; row = [:]
    for (int i = 0; i &lt; cols.size(); i++) { row[cols[i]] = vals[i] }
    if (row[&apos;run_id&apos;] == runId) rows &lt;&lt; row
}
Map&lt;String, String&gt; seller = rows.find { it[&apos;role&apos;] == &apos;판매자&apos; }
List&lt;Map&lt;String, String&gt;&gt; buyers = rows.findAll { it[&apos;role&apos;] == &apos;흥정 구매자&apos; }.sort { it[&apos;buyer_no&apos;] as int }
if (seller == null || buyers.size() != 18) {
    throw new IllegalStateException(&apos;회원 CSV에 실행 번호 &apos; + runId + &apos;의 판매자 1명과 흥정 구매자 18명이 없습니다. 판매자 &apos; + (seller == null ? 0 : 1) + &apos;명, 흥정 구매자 &apos; + buyers.size() + &apos;명&apos;)
}
vars.put(&apos;seller_id&apos;, seller[&apos;member_id&apos;])
vars.put(&apos;seller_pw&apos;, seller[&apos;password&apos;])
buyers.eachWithIndex { b, idx -&gt;
    int n = idx + 1
    vars.put(&apos;buyer_id_&apos; + n, b[&apos;member_id&apos;])
    vars.put(&apos;buyer_pw_&apos; + n, b[&apos;password&apos;])
    vars.put(&apos;offer_qty_&apos; + n, b[&apos;offer_quantity&apos;])
}

// 준비 그룹이 속성에 넣은 상품·대화·가격 제안·실행 ID는 지우지 않는다. 이 그룹은 로그인 토큰 속성만 새로 쓴다.
vars.put(&apos;login_index&apos;, &apos;0&apos;)
SampleResult.setResponseData(&apos;runId=&apos; + runId + &apos;, 판매자=&apos; + seller[&apos;member_id&apos;] + &apos;, 흥정 구매자=&apos; + buyers.size() + &apos;명&apos;, &apos;UTF-8&apos;)
</stringProp>
        </JSR223Sampler>
