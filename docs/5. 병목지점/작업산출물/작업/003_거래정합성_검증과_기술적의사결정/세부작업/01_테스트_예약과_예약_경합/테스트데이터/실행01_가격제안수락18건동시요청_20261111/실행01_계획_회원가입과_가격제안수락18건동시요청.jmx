        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="스레드 번호로 수락할 가격 제안 정하기" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">// 이 스레드가 수락할 가격 제안을 스레드 번호로 정한다. 스레드 1은 흥정 구매자 01의 제안을, 스레드 18은 흥정 구매자 18의 제안을 수락한다.
int n = ctx.getThreadNum() + 1
String no = String.format(&apos;%02d&apos;, n)
vars.put(&apos;cur_no&apos;, no)
vars.put(&apos;cur_offer&apos;, (props.get(&apos;rsv.offer_&apos; + n) ?: &apos;NOT_FOUND&apos;) as String)
vars.put(&apos;cur_qty&apos;, (props.get(&apos;rsv.qty_&apos; + n) ?: &apos;&apos;) as String)
vars.put(&apos;seller_token&apos;, (props.get(&apos;rsv.seller_token&apos;) ?: &apos;&apos;) as String)
vars.put(&apos;run_log_id&apos;, (props.get(&apos;rsv.run_log_id&apos;) ?: &apos;&apos;) as String)
vars.put(&apos;test_log_name&apos;, (props.get(&apos;rsv.test_log_name&apos;) ?: &apos;&apos;) as String)
vars.put(&apos;req_log_id&apos;, &apos;accept-&apos; + no)
</stringProp>
