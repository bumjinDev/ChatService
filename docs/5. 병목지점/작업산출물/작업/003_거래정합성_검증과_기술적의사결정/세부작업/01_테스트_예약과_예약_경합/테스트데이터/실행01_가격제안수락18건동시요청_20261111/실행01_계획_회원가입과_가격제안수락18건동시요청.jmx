            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">이번 실행의 결과 폴더 전체 경로(실행결과_원본의 실행 폴더). 실행마다 바꾼다</stringProp>
          </elementProp>
