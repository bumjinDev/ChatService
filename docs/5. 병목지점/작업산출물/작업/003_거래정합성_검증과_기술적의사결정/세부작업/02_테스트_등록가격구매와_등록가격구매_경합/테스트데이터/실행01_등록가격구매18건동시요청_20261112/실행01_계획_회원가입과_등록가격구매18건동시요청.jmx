        </hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="요청 전 상태 확인과 구매 경합에 넘길 값 정하기(실행 폴더의 준비_ID와_요청전상태.csv, 준비_요청전상태_요약.csv)">
          <stringProp name="TestPlan.comments">등록 가격 구매자 18명의 회원 ID, 대화 ID, 구매 수량, 결제 금액, 충전 뒤 잔액, 요청 전 가격 제안 수·예약·주문 수, 서버 로그용 요청 ID를 준비_ID와_요청전상태.csv에 쓴다. 남은 수량과 구매 가능 수량이 50개이고, 대화가 18건이고, 18명 모두 잔액이 결제 금액과 같고, 가격 제안·예약·주문이 없으면 「기본 구성과 같음」으로 표시한다. 다르더라도 다음 그룹은 그대로 실행한다.</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import java.net.URLEncoder

// 등록 가격 구매자 18명의 ID와 요청 전 상태를 실행 폴더의 준비_ID와_요청전상태.csv에 쓰고, 요청 전 상태가 기본 구성과 같은지 확인한다.
// 속성에는 빈 값을 넣을 수 없으므로 값이 없으면 「-」를 넣는다.
def put = { String key, Object value -&gt; props.put(key, value == null ? &apos;-&apos; : value.toString()) }
long expectedQty = (vars.get(&apos;productQuantity&apos;) as long)
StringBuilder csv = new StringBuilder(&apos;﻿buyer_no,buyer_id,conversation_id,purchase_quantity,payment_amount,balance,offer_count,reservation_id,order_count,request_log_id\n&apos;)
int conversations = 0
int balanceMatches = 0
long offers = 0
int reservations = 0
long orders = 0
boolean readable = true
for (int n = 1; n &lt;= 18; n++) {
    String no = String.format(&apos;%02d&apos;, n)
    String reqId = &apos;buy-&apos; + no
    List row = [no, vars.get(&apos;buyer_id_&apos; + n), vars.get(&apos;conv_&apos; + n), vars.get(&apos;qty_&apos; + n), vars.get(&apos;charge_&apos; + n),
                vars.get(&apos;pre_balance_&apos; + n), vars.get(&apos;pre_offer_count_&apos; + n), vars.get(&apos;pre_reservation_&apos; + n), vars.get(&apos;pre_order_count_&apos; + n), reqId]
    csv.append(row.join(&apos;,&apos;)).append(&apos;\n&apos;)
    if ((vars.get(&apos;conv_&apos; + n) ?: &apos;NOT_FOUND&apos;) != &apos;NOT_FOUND&apos;) conversations++
    if (vars.get(&apos;pre_balance_&apos; + n) == vars.get(&apos;charge_&apos; + n)) balanceMatches++
    if ((vars.get(&apos;pre_offer_count_&apos; + n) ?: &apos;&apos;).isLong()) offers += (vars.get(&apos;pre_offer_count_&apos; + n) as long) else readable = false
    if (vars.get(&apos;pre_reservation_&apos; + n) != &apos;-&apos;) reservations++
    if ((vars.get(&apos;pre_order_count_&apos; + n) ?: &apos;&apos;).isLong()) orders += (vars.get(&apos;pre_order_count_&apos; + n) as long) else readable = false
    // 구매 경합 그룹과 저장 상태 확인 그룹이 쓸 값을 속성에 넣는다. 로그인 토큰은 로그인 그룹이 속성에 넣는다.
    put(&apos;buy.buyer_&apos; + n, vars.get(&apos;buyer_id_&apos; + n))
    put(&apos;buy.conv_&apos; + n, vars.get(&apos;conv_&apos; + n))
    put(&apos;buy.qty_&apos; + n, vars.get(&apos;qty_&apos; + n))
    put(&apos;buy.charge_&apos; + n, vars.get(&apos;charge_&apos; + n))
}
put(&apos;buy.product_id&apos;, vars.get(&apos;product_id&apos;))
put(&apos;buy.run_log_id&apos;, vars.get(&apos;run_log_id&apos;))
put(&apos;buy.test_log_name&apos;, URLEncoder.encode(vars.get(&apos;testLogName&apos;), &apos;UTF-8&apos;))
new File(vars.get(&apos;outDir&apos;), &apos;준비_ID와_요청전상태.csv&apos;).setText(csv.toString(), &apos;UTF-8&apos;)

boolean same = readable &amp;&amp; vars.get(&apos;pre_remaining&apos;) == String.valueOf(expectedQty) &amp;&amp; vars.get(&apos;pre_available&apos;) == String.valueOf(expectedQty) &amp;&amp;
        conversations == 18 &amp;&amp; balanceMatches == 18 &amp;&amp; offers == 0 &amp;&amp; reservations == 0 &amp;&amp; orders == 0
String result = same ? &apos;기본 구성과 같음&apos; : &apos;기본 구성과 다름&apos;
List summary = [vars.get(&apos;product_id&apos;), vars.get(&apos;pre_remaining&apos;), vars.get(&apos;pre_available&apos;), conversations, balanceMatches, offers, reservations, orders, result]
new File(vars.get(&apos;outDir&apos;), &apos;준비_요청전상태_요약.csv&apos;).setText(
        &apos;﻿product_id,remaining_quantity,available_quantity,conversation_count,balance_match_count,offer_count,reservation_count,order_count,check_result\n&apos; + summary.join(&apos;,&apos;) + &apos;\n&apos;, &apos;UTF-8&apos;)
SampleResult.setSuccessful(same)
SampleResult.setResponseMessage(&apos;요청 전 상태: &apos; + result)
SampleResult.setResponseData(&apos;상품ID=&apos; + vars.get(&apos;product_id&apos;) + &apos;, 남은 수량=&apos; + vars.get(&apos;pre_remaining&apos;) + &apos;, 판매자가 본 구매 가능 수량=&apos; + vars.get(&apos;pre_available&apos;) +
        &apos;, 대화=&apos; + conversations + &apos;건, 잔액이 결제 금액과 같은 구매자=&apos; + balanceMatches + &apos;명, 가격 제안=&apos; + offers + &apos;건, 예약=&apos; + reservations + &apos;건, 주문=&apos; + orders +
        &apos;건, 확인 결과=&apos; + result + &apos;, 실행ID=&apos; + vars.get(&apos;run_log_id&apos;), &apos;UTF-8&apos;)
</stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="구매 경합: 등록 가격 구매 18건을 같은 순간에 보냄">
        <stringProp name="TestPlan.comments">스레드 18개가 각각 등록 가격 구매자 한 명의 결제를 맡는다. 동기화 타이머로 18개 요청을 같은 순간에 보낸다. 요청을 같은 순간에 보냈다는 사실만으로 서버의 수량 확인과 저장이 겹쳤다고 보지 않고, 서버 로그로 확인한다.</stringProp>
        <intProp name="ThreadGroup.num_threads">18</intProp>
        <intProp name="ThreadGroup.ramp_time">0</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <SyncTimer guiclass="TestBeanGUI" testclass="SyncTimer" testname="동기화 타이머(18개 요청이 모두 준비되면 같은 순간에 보냄, 최대 10초 대기)">
          <stringProp name="TestPlan.comments">스레드 18개가 모두 요청 직전에 도착하면 18개 요청을 같은 순간에 보낸다. 10초 안에 모이지 않으면 더 기다리지 않고 보낸다.</stringProp>
          <intProp name="groupSize">18</intProp>
          <longProp name="timeoutInMs">10000</longProp>
        </SyncTimer>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="등록 가격 구매자 ${cur_no} 등록 가격 결제(${cur_qty}개)">
          <stringProp name="TestPlan.comments">이 스레드에 정해진 등록 가격 구매자가 가격 제안 없이 등록 가격으로 구매 수량만큼 결제한다. 결제가 성공하면 주문이 저장되고 잔액과 남은 수량이 줄어든다. 요청 헤더에 서버 로그의 테스트명, 실행 ID, 요청 ID를 담는다. 수량 부족으로 거절되거나 응답을 받지 못해도 다시 보내지 않는다.</stringProp>
          <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
          <stringProp name="HTTPSampler.path">/ChatService/api/orders</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{&quot;productId&quot;:${product_id},&quot;quantity&quot;:${cur_qty},&quot;recipientName&quot;:&quot;등록 가격 구매자 ${cur_no}&quot;,&quot;shippingAddress&quot;:&quot;${shippingAddress}&quot;,&quot;requestId&quot;:&quot;${__UUID()}&quot;}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="스레드 번호로 결제할 등록 가격 구매자 정하기">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">// 이 스레드가 결제할 등록 가격 구매자를 스레드 번호로 정한다. 스레드 1은 등록 가격 구매자 01이, 스레드 18은 등록 가격 구매자 18이 결제한다.
int n = ctx.getThreadNum() + 1
String no = String.format(&apos;%02d&apos;, n)
vars.put(&apos;cur_no&apos;, no)
vars.put(&apos;cur_qty&apos;, (props.get(&apos;buy.qty_&apos; + n) ?: &apos;&apos;) as String)
vars.put(&apos;cur_token&apos;, (props.get(&apos;buy.buyer_token_&apos; + n) ?: &apos;&apos;) as String)
vars.put(&apos;product_id&apos;, (props.get(&apos;buy.product_id&apos;) ?: &apos;NOT_FOUND&apos;) as String)
vars.put(&apos;run_log_id&apos;, (props.get(&apos;buy.run_log_id&apos;) ?: &apos;&apos;) as String)
vars.put(&apos;test_log_name&apos;, (props.get(&apos;buy.test_log_name&apos;) ?: &apos;&apos;) as String)
vars.put(&apos;req_log_id&apos;, &apos;buy-&apos; + no)
</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="JSON 헤더, 등록 가격 구매자 로그인 쿠키, 서버 로그용 테스트명·실행 ID·요청 ID">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Content-Type</stringProp>
                <stringProp name="Header.value">application/json</stringProp>
              </elementProp>
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Cookie</stringProp>
                <stringProp name="Header.value">Authorization=${cur_token}</stringProp>
              </elementProp>
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">X-Test-Log-Name</stringProp>
                <stringProp name="Header.value">${test_log_name}</stringProp>
              </elementProp>
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">X-Test-Log-Run-Id</stringProp>
                <stringProp name="Header.value">${run_log_id}</stringProp>
              </elementProp>
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">X-Test-Log-Request-Id</stringProp>
                <stringProp name="Header.value">${req_log_id}</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="응답 코드, 오류 코드, 주문 ID를 속성에 넣고 응답 본문 저장(실행 폴더의 구매_등록가격구매자번호_응답)">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper
// 응답 코드, 오류 코드, 응답에 담긴 주문 ID, 요청 시각과 걸린 시간을 속성에 넣고, 응답 본문을 실행 폴더에 저장한다.
int n = ctx.getThreadNum() + 1
String body = prev.getResponseDataAsString()
String errorCode = &apos;-&apos;
String orderId = &apos;-&apos;
boolean isJson = false
try {
    def j = new JsonSlurper().parseText(body)
    isJson = true
    if (j instanceof Map) {
        if (j.code) errorCode = String.valueOf(j.code)
        if (j.orderId != null) orderId = String.valueOf(j.orderId)
    }
} catch (Exception ignored) {
}
props.put(&apos;buy.buy_code_&apos; + n, prev.getResponseCode() ?: &apos;&apos;)
props.put(&apos;buy.buy_error_&apos; + n, errorCode)
props.put(&apos;buy.buy_order_&apos; + n, orderId)
props.put(&apos;buy.buy_start_&apos; + n, String.valueOf(prev.getStartTime()))
props.put(&apos;buy.buy_elapsed_&apos; + n, String.valueOf(prev.getTime()))
new File(vars.get(&apos;outDir&apos;), &apos;구매_등록가격구매자&apos; + vars.get(&apos;cur_no&apos;) + &apos;_응답&apos; + (isJson ? &apos;.json&apos; : &apos;.txt&apos;)).setText(body, &apos;UTF-8&apos;)
</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="응답 구분: 성공과 수량 부족은 통과, 기타 오류와 응답 미확인은 실패로 표시">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper
// 성공(201)과 수량 부족(409이고 오류 코드가 남은 수량 부족·구매 가능 수량 부족·판매 종료 가운데 하나)은 통과로, 그 밖의 응답과 응답을 받지 못한 요청은 실패로 표시한다.
List&lt;String&gt; shortageCodes = [&apos;INSUFFICIENT_STOCK&apos;, &apos;PRODUCT_RESERVED&apos;, &apos;PRODUCT_NOT_ON_SALE&apos;]
String code = SampleResult.getResponseCode()
String errorCode = &apos;-&apos;
try {
    def j = new JsonSlurper().parseText(SampleResult.getResponseDataAsString())
    if (j instanceof Map &amp;&amp; j.code) errorCode = String.valueOf(j.code)
} catch (Exception ignored) {
}
if (code == &apos;201&apos;) {
    SampleResult.setResponseMessage(&apos;성공&apos;)
} else if (code == &apos;409&apos; &amp;&amp; shortageCodes.contains(errorCode)) {
    SampleResult.setSuccessful(true)
    SampleResult.setResponseMessage(&apos;수량부족: &apos; + errorCode)
} else {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage((code ==~ /\d{3}/ ? &apos;기타오류: &apos; : &apos;미확인: &apos;) + code + &apos; &apos; + errorCode)
}
</stringProp>
          </JSR223Assertion>
          <hashTree/>
        </hashTree>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="구매 경합 뒤 저장 상태 확인: 판매자의 대화 상세 18건과 등록 가격 구매자의 잔액 18건 조회" enabled="true">
        <stringProp name="TestPlan.comments">구매 요청 18건이 모두 끝난 뒤 판매자의 대화 상세 18건과 등록 가격 구매자의 잔액 18건을 조회한다. 응답을 받지 못한 요청도 다시 보내지 않고 저장된 상태부터 확인한다.</stringProp>
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">0</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="구매 경합 결과와 확인에 쓸 값 읽기" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">// 구매 경합 그룹이 속성에 남긴 값과 로그인 그룹·준비 그룹이 넘긴 값을 이 스레드의 변수로 읽는다.
// 이 그룹을 같은 JMeter 창에서 다시 실행할 때 이전 확인 결과가 섞이지 않도록 저장 상태 확인 속성을 지운다.
props.keySet().findAll { it.toString().startsWith(&apos;buy.post_&apos;) }.each { props.remove(it) }
vars.put(&apos;seller_token&apos;, (props.get(&apos;buy.seller_token&apos;) ?: &apos;&apos;) as String)
vars.put(&apos;product_id&apos;, (props.get(&apos;buy.product_id&apos;) ?: &apos;NOT_FOUND&apos;) as String)
vars.put(&apos;check_index&apos;, &apos;0&apos;)
vars.put(&apos;wallet_index&apos;, &apos;0&apos;)
int got = (1..18).count { props.get(&apos;buy.buy_code_&apos; + it) != null }
SampleResult.setResponseData(&apos;구매 응답을 기록한 요청 &apos; + got + &apos;건, 상품ID=&apos; + vars.get(&apos;product_id&apos;), &apos;UTF-8&apos;)
</stringProp>
        </JSR223Sampler>
        <hashTree/>
        <LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="등록 가격 구매자 18명마다 판매자의 대화 상세 조회(구매 경합 뒤)" enabled="true">
          <stringProp name="LoopController.loops">18</stringProp>
          <boolProp name="LoopController.continue_forever">true</boolProp>
        </LoopController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="판매자의 등록 가격 구매자 ${cur_no} 대화 상세 조회(구매 경합 뒤)" enabled="true">
            <stringProp name="TestPlan.comments">판매자가 이 등록 가격 구매자의 대화 상세를 조회해 저장된 주문과 상품의 남은 수량·판매 상태를 확인한다. 판매 종료 상품도 조회된다.</stringProp>
            <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
            <stringProp name="HTTPSampler.path">/ChatService/api/conversations/${cur_conv}</stringProp>
            <stringProp name="HTTPSampler.method">GET</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
              <collectionProp name="Arguments.arguments"/>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="이번 반복의 등록 가격 구매자 정하기" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">// 이번 반복에서 판매자가 대화 상세를 조회할 등록 가격 구매자를 정한다.
int n = (vars.get(&apos;check_index&apos;) as int) + 1
vars.put(&apos;check_index&apos;, String.valueOf(n))
vars.put(&apos;cur_no&apos;, String.format(&apos;%02d&apos;, n))
vars.put(&apos;cur_conv&apos;, (props.get(&apos;buy.conv_&apos; + n) ?: &apos;NOT_FOUND&apos;) as String)
</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
            <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="판매자 로그인 쿠키" enabled="true">
              <collectionProp name="HeaderManager.headers">
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">Cookie</stringProp>
                  <stringProp name="Header.value">Authorization=${seller_token}</stringProp>
                </elementProp>
              </collectionProp>
            </HeaderManager>
            <hashTree/>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="응답 코드 200" enabled="true">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="49586">200</stringProp>
              </collectionProp>
              <stringProp name="Assertion.custom_message"></stringProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">8</intProp>
            </ResponseAssertion>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="주문과 상품의 남은 수량·판매 상태를 속성에 넣고 응답 본문 저장(실행 폴더의 종료후_등록가격구매자번호_대화상세응답.json)" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
// 구매 경합 뒤 판매자가 본 대화 상세에서 이 등록 가격 구매자의 주문과 상품의 남은 수량·판매 상태를 속성에 넣고, 응답 본문을 실행 폴더에 저장한다.
String n = vars.get(&apos;check_index&apos;)
String body = prev.getResponseDataAsString()
new File(vars.get(&apos;outDir&apos;), &apos;종료후_등록가격구매자&apos; + vars.get(&apos;cur_no&apos;) + &apos;_대화상세응답.json&apos;).setText(body, &apos;UTF-8&apos;)
try {
    def j = new JsonSlurper().parseText(body)
    if (!(j instanceof Map) || j.product == null) throw new IllegalStateException(&apos;대화 상세 응답이 아님&apos;)
    List orders = (j.orders ?: []) as List
    props.put(&apos;buy.post_order_count_&apos; + n, String.valueOf(orders.size()))
    props.put(&apos;buy.post_order_id_&apos; + n, orders ? orders.collect { String.valueOf(it.orderId) }.join(&apos;·&apos;) : &apos;-&apos;)
    props.put(&apos;buy.post_order_qty_&apos; + n, orders ? String.valueOf(orders.collect { (it.quantity ?: 0) as long }.sum()) : &apos;-&apos;)
    props.put(&apos;buy.post_order_paid_&apos; + n, orders ? String.valueOf(orders.collect { (it.paidAmount ?: 0) as long }.sum()) : &apos;-&apos;)
    props.put(&apos;buy.post_order_status_&apos; + n, orders ? orders.collect { String.valueOf(it.tradeStatus) }.join(&apos;·&apos;) : &apos;-&apos;)
    props.put(&apos;buy.post_remaining_&apos; + n, String.valueOf(j.product.remainingQuantity))
    props.put(&apos;buy.post_status_&apos; + n, String.valueOf(j.product.status))
    props.put(&apos;buy.post_read_&apos; + n, &apos;Y&apos;)
} catch (Exception e) {
    props.put(&apos;buy.post_read_&apos; + n, &apos;N&apos;)
}
</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>
        </hashTree>
        <LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="등록 가격 구매자 18명마다 잔액 조회(구매 경합 뒤)" enabled="true">
          <stringProp name="LoopController.loops">18</stringProp>
          <boolProp name="LoopController.continue_forever">true</boolProp>
        </LoopController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="등록 가격 구매자 ${cur_no} 잔액 조회(구매 경합 뒤)" enabled="true">
            <stringProp name="TestPlan.comments">등록 가격 구매자가 자기 잔액을 조회한다.</stringProp>
            <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
            <stringProp name="HTTPSampler.path">/ChatService/api/wallet</stringProp>
            <stringProp name="HTTPSampler.method">GET</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
              <collectionProp name="Arguments.arguments"/>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="이번 반복의 등록 가격 구매자 정하기" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">// 이번 반복에서 잔액을 조회할 등록 가격 구매자를 정한다. 로그인 토큰은 로그인 그룹이 넣은 속성에서 읽는다.
int n = (vars.get(&apos;wallet_index&apos;) as int) + 1
vars.put(&apos;wallet_index&apos;, String.valueOf(n))
vars.put(&apos;cur_no&apos;, String.format(&apos;%02d&apos;, n))
vars.put(&apos;cur_token&apos;, (props.get(&apos;buy.buyer_token_&apos; + n) ?: &apos;NOT_FOUND&apos;) as String)
</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
            <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="등록 가격 구매자 로그인 쿠키" enabled="true">
              <collectionProp name="HeaderManager.headers">
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">Cookie</stringProp>
                  <stringProp name="Header.value">Authorization=${cur_token}</stringProp>
                </elementProp>
              </collectionProp>
            </HeaderManager>
            <hashTree/>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="응답 코드 200" enabled="true">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="49586">200</stringProp>
              </collectionProp>
              <stringProp name="Assertion.custom_message"></stringProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">8</intProp>
            </ResponseAssertion>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="잔액을 속성에 넣고 응답 본문 저장(실행 폴더의 종료후_등록가격구매자번호_잔액응답.json)" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
// 구매 경합 뒤 이 등록 가격 구매자의 잔액을 속성에 넣고, 응답 본문을 실행 폴더에 저장한다.
String n = vars.get(&apos;wallet_index&apos;)
String body = prev.getResponseDataAsString()
new File(vars.get(&apos;outDir&apos;), &apos;종료후_등록가격구매자&apos; + vars.get(&apos;cur_no&apos;) + &apos;_잔액응답.json&apos;).setText(body, &apos;UTF-8&apos;)
try {
    def j = new JsonSlurper().parseText(body)
    if (!(j instanceof Map) || j.balance == null) throw new IllegalStateException(&apos;잔액 응답이 아님&apos;)
    props.put(&apos;buy.post_balance_&apos; + n, String.valueOf(j.balance))
    props.put(&apos;buy.post_wallet_read_&apos; + n, &apos;Y&apos;)
} catch (Exception e) {
    props.put(&apos;buy.post_wallet_read_&apos; + n, &apos;N&apos;)
}
</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>
        </hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="요청별종료후확인과 전체종료후확인 쓰기(실행 폴더의 종료후확인.log)" enabled="true">
          <stringProp name="TestPlan.comments">요청마다 응답 코드와 저장된 주문·잔액을 맞춰 보고, 실행 전체의 주문 수량 합계, 주문 건수, 남은 수량, 상품 상태, 응답 구분별 건수, 결과 확인 기준 위반을 서버 로그와 같은 형식으로 종료후확인.log에 쓴다. 결과 확인 기준 위반이 있으면 이 표본을 실패로 표시한다.</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import java.net.URLDecoder
import java.time.OffsetDateTime
import java.time.ZoneId
import java.time.format.DateTimeFormatter
import org.apache.jmeter.services.FileServer

// 요청마다 응답과 저장된 주문·잔액을 맞춰 본 줄(요청별종료후확인)과 실행 전체를 확인한 줄(전체종료후확인)을
// 서버 로그와 같은 형식으로 실행 폴더의 종료후확인.log에 쓴다. 항목은 작업명세 05의 「3.10 요청별종료후확인, 전체종료후확인」을 따른다.
String runLogId = (props.get(&apos;buy.run_log_id&apos;) ?: &apos;-&apos;) as String
String testName = URLDecoder.decode((props.get(&apos;buy.test_log_name&apos;) ?: &apos;-&apos;) as String, &apos;UTF-8&apos;)
String jmxName = FileServer.getFileServer().getScriptName()
long saleQty = (vars.get(&apos;productQuantity&apos;) as long)
def fmt = DateTimeFormatter.ofPattern(&quot;yyyy-MM-dd&apos;T&apos;HH:mm:ss.SSSSSSXXX&quot;)
def line = { String stage, String reqId, List items -&gt;
    StringBuilder sb = new StringBuilder()
    sb.append(OffsetDateTime.now(ZoneId.of(&apos;Asia/Seoul&apos;)).format(fmt)).append(&apos; - &apos;).append(testName).append(&apos; - 결제 - &apos;)
      .append(jmxName).append(&apos; - 구매 경합 뒤 저장 상태 확인 | 실행ID=&apos;).append(runLogId).append(&apos; 요청ID=&apos;).append(reqId)
      .append(&apos; 단계=&apos;).append(stage).append(&apos; |&apos;)
    for (int i = 0; i + 1 &lt; items.size(); i += 2) { sb.append(&apos; &apos;).append(items[i]).append(&apos;=&apos;).append(items[i + 1]) }
    sb.toString()
}
def p = { String key -&gt; (props.get(&apos;buy.&apos; + key) ?: &apos;-&apos;) as String }
List&lt;String&gt; shortageCodes = [&apos;INSUFFICIENT_STOCK&apos;, &apos;PRODUCT_RESERVED&apos;, &apos;PRODUCT_NOT_ON_SALE&apos;]

List&lt;String&gt; out = []
int success = 0, shortage = 0, otherError = 0, unknown = 0
long orderQtySum = 0
int orderCount = 0
boolean allRead = true
String remaining = &apos;-&apos;
String productStatus = &apos;-&apos;
List&lt;String&gt; noOrderOnSuccess = []   // 성공했는데 주문이 없거나 주문 수량이 요청 수량과 다른 구매자
List&lt;String&gt; mismatch = []           // 주문과 잔액이 맞지 않는 구매자
List&lt;String&gt; leftover = []           // 수량 부족으로 거절됐는데 주문이 남은 구매자
for (int n = 1; n &lt;= 18; n++) {
    String no = String.format(&apos;%02d&apos;, n)
    String buyerId = p(&apos;buyer_&apos; + n)
    String qty = p(&apos;qty_&apos; + n)
    String charge = p(&apos;charge_&apos; + n)
    String code = p(&apos;buy_code_&apos; + n)
    String error = p(&apos;buy_error_&apos; + n)
    String kind
    if (props.get(&apos;buy.buy_code_&apos; + n) == null) kind = &apos;미확인&apos;
    else if (code == &apos;201&apos;) kind = &apos;성공&apos;
    else if (code == &apos;409&apos; &amp;&amp; shortageCodes.contains(error)) kind = &apos;수량부족&apos;
    else if (code ==~ /\d{3}/) kind = &apos;기타오류&apos;
    else kind = &apos;미확인&apos;
    switch (kind) { case &apos;성공&apos;: success++; break; case &apos;수량부족&apos;: shortage++; break; case &apos;기타오류&apos;: otherError++; break; default: unknown++ }

    boolean convRead = p(&apos;post_read_&apos; + n) == &apos;Y&apos;
    boolean walletRead = p(&apos;post_wallet_read_&apos; + n) == &apos;Y&apos;
    if (!convRead || !walletRead) allRead = false
    if (convRead &amp;&amp; remaining == &apos;-&apos;) {
        remaining = p(&apos;post_remaining_&apos; + n)
        productStatus = p(&apos;post_status_&apos; + n)
    }
    String countText = p(&apos;post_order_count_&apos; + n)
    int count = (convRead &amp;&amp; countText.isInteger()) ? (countText as int) : 0
    String orderId = convRead ? p(&apos;post_order_id_&apos; + n) : &apos;확인못함&apos;
    String orderQty = convRead ? p(&apos;post_order_qty_&apos; + n) : &apos;확인못함&apos;
    String paid = convRead ? p(&apos;post_order_paid_&apos; + n) : &apos;확인못함&apos;
    String tradeStatus = convRead ? p(&apos;post_order_status_&apos; + n) : &apos;확인못함&apos;
    String balance = walletRead ? p(&apos;post_balance_&apos; + n) : &apos;확인못함&apos;
    if (convRead) {
        orderCount += count
        if (orderQty.isLong()) orderQtySum += (orderQty as long)
    }

    // 주문잔액일치: 주문이 있으면 잔액이 「충전 금액 − 결제금액」, 주문이 없으면 잔액이 충전 금액일 때 일치
    boolean match = false
    if (convRead &amp;&amp; walletRead &amp;&amp; balance.isLong() &amp;&amp; charge.isLong()) {
        long b = balance as long
        long c = charge as long
        match = (count &gt; 0) ? (paid.isLong() &amp;&amp; b == c - (paid as long)) : (b == c)
    }
    if (convRead &amp;&amp; walletRead &amp;&amp; !match) mismatch &lt;&lt; buyerId
    if (kind == &apos;성공&apos; &amp;&amp; !(convRead &amp;&amp; count &gt; 0 &amp;&amp; orderQty == qty)) noOrderOnSuccess &lt;&lt; buyerId
    if (kind == &apos;수량부족&apos; &amp;&amp; convRead &amp;&amp; count &gt; 0) leftover &lt;&lt; buyerId

    // HTTP 응답 코드를 받지 못한 요청은 응답상태를 「응답없음(예외 이름)」으로 적는다.
    String shownCode = (code ==~ /\d{3}/) ? code : (&apos;응답없음(&apos; + (code.contains(&apos;.&apos;) ? code.substring(code.lastIndexOf(&apos;.&apos;) + 1) : code) + &apos;)&apos;)
    out &lt;&lt; line(&apos;요청별종료후확인&apos;, &apos;buy-&apos; + no, [&apos;구매자ID&apos;, buyerId, &apos;요청수량&apos;, qty, &apos;응답상태&apos;, shownCode, &apos;오류코드&apos;, error, &apos;응답구분&apos;, kind,
            &apos;주문ID&apos;, orderId, &apos;주문수량&apos;, orderQty, &apos;결제금액&apos;, paid, &apos;거래상태&apos;, tradeStatus, &apos;잔액&apos;, balance, &apos;주문잔액일치&apos;, match ? &apos;일치&apos; : &apos;불일치&apos;])
}

List&lt;String&gt; violations = []
if (orderQtySum &gt; saleQty) violations &lt;&lt; (&apos;주문 수량 합계가 판매 수량 &apos; + saleQty + &apos;개를 넘음&apos;)
if (!remaining.isLong() || (remaining as long) != saleQty - orderQtySum) violations &lt;&lt; &apos;상품의 남은 수량이 판매 수량에서 주문 수량 합계를 뺀 값과 다름&apos;
if (remaining.isLong()) {
    String expectedStatus = ((remaining as long) == 0) ? &apos;SOLD&apos; : &apos;ON_SALE&apos;
    if (productStatus != expectedStatus) violations &lt;&lt; &apos;상품 상태가 남은 수량과 맞지 않음&apos;
}
if (!noOrderOnSuccess.isEmpty()) violations &lt;&lt; (&apos;성공한 구매에 주문이 없거나 주문 수량이 요청 수량과 다름(구매자ID &apos; + noOrderOnSuccess.join(&apos;·&apos;) + &apos;)&apos;)
if (!mismatch.isEmpty()) violations &lt;&lt; (&apos;주문과 잔액이 맞지 않음(구매자ID &apos; + mismatch.join(&apos;·&apos;) + &apos;)&apos;)
if (!leftover.isEmpty()) violations &lt;&lt; (&apos;수량 부족으로 거절된 요청에 주문이 남음(구매자ID &apos; + leftover.join(&apos;·&apos;) + &apos;)&apos;)
if (!allRead) violations &lt;&lt; &apos;저장 상태를 읽지 못한 대화나 잔액 조회 있음&apos;
out &lt;&lt; line(&apos;전체종료후확인&apos;, &apos;-&apos;, [&apos;주문수량합계&apos;, orderQtySum, &apos;주문건수&apos;, orderCount, &apos;남은수량&apos;, remaining, &apos;상품상태&apos;, productStatus,
        &apos;성공수&apos;, success, &apos;수량부족수&apos;, shortage, &apos;기타오류수&apos;, otherError, &apos;미확인수&apos;, unknown,
        &apos;결과확인기준위반&apos;, violations.isEmpty() ? &apos;없음&apos; : violations.join(&apos;; &apos;)])

new File(vars.get(&apos;outDir&apos;), &apos;종료후확인.log&apos;).setText(out.join(&apos;\n&apos;) + &apos;\n&apos;, &apos;UTF-8&apos;)
SampleResult.setSuccessful(violations.isEmpty())
SampleResult.setResponseMessage(violations.isEmpty() ? &apos;결과 확인 기준 위반 없음&apos; : &apos;결과 확인 기준 위반 있음&apos;)
SampleResult.setResponseData(out.join(&apos;\n&apos;), &apos;UTF-8&apos;)
</stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
