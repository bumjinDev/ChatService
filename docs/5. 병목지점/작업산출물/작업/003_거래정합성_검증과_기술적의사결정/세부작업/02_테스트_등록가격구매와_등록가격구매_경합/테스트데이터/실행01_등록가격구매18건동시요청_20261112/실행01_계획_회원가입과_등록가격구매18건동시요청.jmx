          <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor" testname="응답 헤더의 로그인 쿠키(Authorization)를 변수 seller_token에 저장" enabled="true">
            <stringProp name="RegexExtractor.useHeaders">true</stringProp>
