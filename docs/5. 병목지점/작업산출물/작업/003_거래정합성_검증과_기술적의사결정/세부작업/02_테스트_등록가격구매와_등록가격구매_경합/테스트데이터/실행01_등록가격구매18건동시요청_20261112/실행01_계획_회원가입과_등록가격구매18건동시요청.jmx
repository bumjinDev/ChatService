      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="준비: 상품 등록, 대화 시작 18건, 충전 18건, 요청 전 상태 확인">
        <stringProp name="TestPlan.comments">판매자가 상품을 등록하고, 등록 가격 구매자마다 대화를 시작하고 결제 금액만큼 충전한다. 로그인 토큰은 로그인 그룹이 넣은 속성에서 읽는다. 이 그룹의 요청은 구매 경합의 요청 수에 들어가지 않는다. 준비가 끝나면 요청 전 상태를 확인한다.</stringProp>
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">0</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="로그인 토큰 확인, 실행 폴더 만들기, 회원 CSV에서 판매자와 등록 가격 구매자 18명 읽기, 실행 ID 정하기" enabled="true">
          <stringProp name="TestPlan.comments">로그인 그룹이 속성에 넣은 판매자와 등록 가격 구매자 18명의 로그인 토큰이 있는지 확인한다. 하나라도 없으면 상품을 등록하지 않고 이 그룹을 멈춘다. 토큰이 모두 있으면 실행 폴더를 만들고, 회원 CSV에서 이 실행 번호의 판매자와 등록 가격 구매자 18명의 ID와 구매 수량을 읽고, 서버 로그에서 이번 실행을 구분할 실행 ID를 정한다. 같은 JMeter 창에서 다시 실행할 때 이전 실행이 속성에 남긴 값을 지우되, 로그인 토큰은 남긴다.</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import java.time.LocalDateTime
import java.time.format.DateTimeFormatter

// 회원 CSV에서 run_id가 runId와 같은 줄을 모두 읽는다. 엑셀로 저장하면 「01」이 「1」로 바뀌므로 숫자로 비교한다.
String runId = vars.get(&apos;runId&apos;)
def sameRun = { String v -&gt; (v != null &amp;&amp; v.isInteger() &amp;&amp; runId.isInteger()) ? (v as int) == (runId as int) : v == runId }
List&lt;String&gt; lines = new File(vars.get(&apos;memberFile&apos;)).readLines(&apos;UTF-8&apos;)
List&lt;String&gt; cols = (lines[0].replace(&apos;﻿&apos;, &apos;&apos;).trim().split(&apos;,&apos;) as List)
List&lt;Map&lt;String, String&gt;&gt; rows = []
for (String line : lines.drop(1)) {
    if (line.trim().isEmpty()) continue
    List&lt;String&gt; vals = (line.trim().split(&apos;,&apos;, -1) as List)
    Map&lt;String, String&gt; row = [:]
    for (int i = 0; i &lt; cols.size(); i++) { row[cols[i]] = vals[i] }
    if (sameRun(row[&apos;run_id&apos;])) rows &lt;&lt; row
}
Map&lt;String, String&gt; seller = rows.find { it[&apos;role&apos;] == &apos;판매자&apos; }
List&lt;Map&lt;String, String&gt;&gt; buyers = rows.findAll { it[&apos;role&apos;] == &apos;등록 가격 구매자&apos; }.sort { it[&apos;buyer_no&apos;] as int }
if (seller == null || buyers.size() != 18) {
    throw new IllegalStateException(&apos;회원 CSV에 실행 번호 &apos; + runId + &apos;의 판매자 1명과 등록 가격 구매자 18명이 없습니다. 판매자 &apos; + (seller == null ? 0 : 1) + &apos;명, 등록 가격 구매자 &apos; + buyers.size() + &apos;명&apos;)
}
vars.put(&apos;seller_id&apos;, seller[&apos;member_id&apos;])
vars.put(&apos;seller_pw&apos;, seller[&apos;password&apos;])
buyers.eachWithIndex { b, idx -&gt;
    int n = idx + 1
    vars.put(&apos;buyer_id_&apos; + n, b[&apos;member_id&apos;])
    vars.put(&apos;buyer_pw_&apos; + n, b[&apos;password&apos;])
    vars.put(&apos;qty_&apos; + n, b[&apos;purchase_quantity&apos;])
}

// 로그인 그룹이 속성에 넣은 로그인 토큰을 읽는다. 하나라도 없으면 상품을 등록하지 않고 이 그룹을 멈춘다.
String sellerToken = (props.get(&apos;buy.seller_token&apos;) ?: &apos;NOT_FOUND&apos;) as String
List&lt;String&gt; missing = []
if (sellerToken == &apos;NOT_FOUND&apos;) missing &lt;&lt; &apos;판매자&apos;
for (int n = 1; n &lt;= 18; n++) {
    if (((props.get(&apos;buy.buyer_token_&apos; + n) ?: &apos;NOT_FOUND&apos;) as String) == &apos;NOT_FOUND&apos;) missing &lt;&lt; (&apos;등록 가격 구매자 &apos; + String.format(&apos;%02d&apos;, n))
}
if (!missing.isEmpty()) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseMessage(&apos;로그인 토큰 없음: &apos; + missing.join(&apos;, &apos;) + &apos;. 같은 JMeter 창에서 「로그인」 그룹을 먼저 실행해야 한다&apos;)
    SampleResult.setStopThread(true)
    return
}
// 같은 JMeter 창에서 다시 실행할 때 이전 실행이 속성에 남긴 값이 섞이지 않도록 지운다. 로그인 그룹이 넣은 로그인 토큰은 남긴다.
props.keySet().findAll { String k = it.toString(); k.startsWith(&apos;buy.&apos;) &amp;&amp; k != &apos;buy.seller_token&apos; &amp;&amp; !k.startsWith(&apos;buy.buyer_token_&apos;) }.each { props.remove(it) }
vars.put(&apos;seller_token&apos;, sellerToken)
// 이번 실행의 결과를 남길 실행 폴더를 만든다. 이미 있으면 그대로 둔다.
new File(vars.get(&apos;outDir&apos;)).mkdirs()
// 실행 ID: 서버 로그에서 이번 실행을 구분하는 값. 실행 번호와 지금 시각으로 만든다.
String runLogId = &apos;run&apos; + runId + &apos;-&apos; + LocalDateTime.now().format(DateTimeFormatter.ofPattern(&apos;yyyyMMdd-HHmmss&apos;))
vars.put(&apos;run_log_id&apos;, runLogId)
