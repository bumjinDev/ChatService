          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="가입 결과 CSV에 이 회원의 줄 쓰기" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">// 가입 결과 CSV 끝에 이 회원의 줄을 붙인다.
List row = [vars.get(&apos;run_id&apos;), vars.get(&apos;role&apos;), vars.get(&apos;buyer_no&apos;), vars.get(&apos;member_id&apos;), prev.getResponseCode()]
new File(vars.get(&apos;joinResultFile&apos;)).append(row.join(&apos;,&apos;) + &apos;\n&apos;, &apos;UTF-8&apos;)
</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
