          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="판매자의 로그인 토큰을 속성에 넣기" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">// 판매자의 로그인 토큰을 속성에 넣는다. 준비 그룹과 구매 경합 뒤 저장 상태 확인 그룹이 이 속성을 읽는다. 토큰은 파일에 쓰지 않는다.
String token = vars.get(&apos;seller_token&apos;)
props.put(&apos;buy.seller_token&apos;, token ?: &apos;NOT_FOUND&apos;)
if (token == null || token == &apos;NOT_FOUND&apos;) {
    prev.setSuccessful(false)
    prev.setResponseMessage(&apos;판매자의 로그인 토큰을 받지 못함&apos;)
}
</stringProp>
