            <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor" testname="응답 헤더의 로그인 쿠키(Authorization)를 변수 cur_token에 저장" enabled="true">
              <stringProp name="RegexExtractor.useHeaders">true</stringProp>
              <stringProp name="RegexExtractor.refname">cur_token</stringProp>
              <stringProp name="RegexExtractor.regex">Authorization=([^;\s]+)</stringProp>
              <stringProp name="RegexExtractor.template">$1$</stringProp>
              <stringProp name="RegexExtractor.default">NOT_FOUND</stringProp>
              <boolProp name="RegexExtractor.default_empty_value">false</boolProp>
              <stringProp name="RegexExtractor.match_number">1</stringProp>
            </RegexExtractor>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="등록 가격 구매자의 로그인 토큰을 번호별 속성에 넣기" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">// 이 등록 가격 구매자의 로그인 토큰을 번호별 속성에 넣는다. 준비 그룹이 대화 시작과 충전에, 구매 경합 그룹이 결제에,
// 구매 경합 뒤 저장 상태 확인 그룹이 잔액 조회에 쓴다. 토큰은 파일에 쓰지 않는다.
String n = vars.get(&apos;login_index&apos;)
String token = vars.get(&apos;cur_token&apos;)
props.put(&apos;buy.buyer_token_&apos; + n, token ?: &apos;NOT_FOUND&apos;)
if (token == null || token == &apos;NOT_FOUND&apos;) {
    prev.setSuccessful(false)
    prev.setResponseMessage(&apos;등록 가격 구매자 &apos; + vars.get(&apos;cur_no&apos;) + &apos;의 로그인 토큰을 받지 못함&apos;)
}
</stringProp>
            </JSR223PostProcessor>
