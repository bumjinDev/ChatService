              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
// 판매자가 본 대화 상세에서 이 등록 가격 구매자의 가격 제안 수, 예약, 주문 수를 변수에 넣고, 응답 본문을 실행 폴더에 저장한다.
String n = vars.get(&apos;check_index&apos;)
String body = prev.getResponseDataAsString()
new File(vars.get(&apos;outDir&apos;), &apos;요청전_등록가격구매자&apos; + vars.get(&apos;cur_no&apos;) + &apos;_대화상세응답.json&apos;).setText(body, &apos;UTF-8&apos;)
try {
    def j = new JsonSlurper().parseText(body)
    vars.put(&apos;pre_offer_count_&apos; + n, String.valueOf(j.offers ? j.offers.size() : 0))
    vars.put(&apos;pre_reservation_&apos; + n, j.reservation ? String.valueOf(j.reservation.reservationId) : &apos;-&apos;)
    vars.put(&apos;pre_order_count_&apos; + n, String.valueOf(j.orders ? j.orders.size() : 0))
} catch (Exception e) {
    [&apos;pre_offer_count_&apos;, &apos;pre_reservation_&apos;, &apos;pre_order_count_&apos;].each { vars.put(it + n, &apos;확인못함&apos;) }
