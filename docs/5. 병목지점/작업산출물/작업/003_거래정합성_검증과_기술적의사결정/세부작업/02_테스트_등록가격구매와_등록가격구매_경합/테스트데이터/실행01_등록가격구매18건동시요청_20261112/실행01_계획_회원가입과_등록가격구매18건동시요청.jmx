          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="이번 반복의 등록 가격 구매자 정하기" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">// 이번 반복에서 로그인할 등록 가격 구매자를 정한다.
int n = (vars.get(&apos;login_index&apos;) as int) + 1
vars.put(&apos;login_index&apos;, String.valueOf(n))
vars.put(&apos;cur_no&apos;, String.format(&apos;%02d&apos;, n))
vars.put(&apos;cur_buyer_id&apos;, vars.get(&apos;buyer_id_&apos; + n))
vars.put(&apos;cur_buyer_pw&apos;, vars.get(&apos;buyer_pw_&apos; + n))
</stringProp>
