          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="응답 확인(5. 새 등록 가격 구매자에게 20,000원 충전)" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters">5|새 등록 가격 구매자에게 20,000원 충전|200|준비_새등록가격구매자_구매목록응답.json|size=0|</stringProp>
