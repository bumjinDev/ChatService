    [&apos;product_id&apos;, &apos;conv_order&apos;, &apos;conv_rsv&apos;, &apos;conv_offer&apos;, &apos;conv_buy&apos;, &apos;offer_rsv&apos;, &apos;offer_new&apos;, &apos;order_id&apos;, &apos;rsv_id&apos;, &apos;run_log_id&apos;, &apos;test_log_name&apos;].each { k -&gt; vars.put(k, (getp(k) ?: &apos;NOT_FOUND&apos;) as String) } }
try {

if (getp(&apos;prep_failed&apos;) != null) { SampleResult.setSuccessful(false); SampleResult.setStopTest(true); return }
List convs = [&apos;order&apos;, &apos;rsv&apos;, &apos;offer&apos;, &apos;buy&apos;].collect { getp(&apos;conv_&apos; + it) }
if (convs.contains(null) || convs.toSet().size() != 4) { failRun(SampleResult, &apos;3&apos;, &apos;구매자 네 명이 상품의 대화를 각각 시작&apos;, &apos;서로 다른 대화 4개가 아님: &apos; + convs); return }
stepOk(&apos;3&apos;, &apos;구매자 네 명이 상품의 대화를 각각 시작&apos;, &apos;새 대화 4개(201): &apos; + [&apos;order&apos;, &apos;rsv&apos;, &apos;offer&apos;, &apos;buy&apos;].collect { ROLE_KO[it] + &apos; &apos; + getp(&apos;conv_&apos; + it) }.join(&apos;, &apos;) + &apos;, 모두 상품 &apos; + getp(&apos;product_id&apos;))
setp(&apos;stage&apos;, &apos;G3&apos;)

} catch (Throwable t) {
failRun(SampleResult, &apos;3&apos;, &apos;구매자 네 명이 상품의 대화를 각각 시작&apos;, &apos;확인 스크립트 오류: &apos; + t)
}
