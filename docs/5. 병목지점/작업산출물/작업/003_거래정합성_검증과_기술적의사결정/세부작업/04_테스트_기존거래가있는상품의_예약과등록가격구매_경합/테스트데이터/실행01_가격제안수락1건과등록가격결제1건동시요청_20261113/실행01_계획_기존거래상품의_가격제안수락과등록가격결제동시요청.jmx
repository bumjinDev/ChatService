            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput
import java.time.Duration
import java.time.Instant
import java.time.ZoneId
import java.time.format.DateTimeFormatter
import java.util.concurrent.BrokenBarrierException
import java.util.concurrent.CyclicBarrier
import java.util.concurrent.TimeUnit
import java.util.concurrent.TimeoutException

// ---- 공통 도우미. JMeter 속성 이름은 모두 「exrb.」로 시작한다.
String PFX = &apos;exrb.&apos;
def getp = { String k -&gt; props.get(PFX + k) }
def setp = { String k, Object v -&gt; if (v == null) { props.remove(PFX + k) } else { props.put(PFX + k, v) } }
File outDir = new File(vars.get(&apos;outDir&apos;))
ZoneId KST = ZoneId.of(&apos;Asia/Seoul&apos;)
def fmtMs = { long ms -&gt; DateTimeFormatter.ofPattern(&quot;yyyy-MM-dd&apos;T&apos;HH:mm:ss.SSSXXX&quot;).withZone(KST).format(Instant.ofEpochMilli(ms)) }
def nowText = { -&gt; fmtMs(System.currentTimeMillis()) }
def cell = { Object v -&gt; String s = (v == null ? &apos;&apos; : String.valueOf(v)); (s.contains(&apos;,&apos;) || s.contains(&apos;&quot;&apos;) || s.contains(&apos;\n&apos;)) ? (&apos;&quot;&apos; + s.replace(&apos;&quot;&apos;, &apos;&quot;&quot;&apos;) + &apos;&quot;&apos;) : s }
def appendCsv = { String name, List header, List row -&gt;
    synchronized (props) {
        File f = new File(outDir, name)
        if (!f.exists()) { f.setText(&apos;﻿&apos; + header.collect { cell(it) }.join(&apos;,&apos;) + &apos;\n&apos;, &apos;UTF-8&apos;) }
        f.append(row.collect { cell(it) }.join(&apos;,&apos;) + &apos;\n&apos;, &apos;UTF-8&apos;)
    }
}
def writeCsv = { String name, List header, List rows -&gt;
    StringBuilder sb = new StringBuilder(&apos;﻿&apos; + header.collect { cell(it) }.join(&apos;,&apos;) + &apos;\n&apos;)
    rows.each { r -&gt; sb.append(r.collect { cell(it) }.join(&apos;,&apos;)).append(&apos;\n&apos;) }
    new File(outDir, name).setText(sb.toString(), &apos;UTF-8&apos;)
}
def saveText = { String name, String text -&gt; new File(outDir, name).setText(text == null ? &apos;&apos; : text, &apos;UTF-8&apos;) }
def parse = { String body -&gt; try { return new JsonSlurper().parseText(body) } catch (Exception e) { return null } }
List ROLE_KEYS = [&apos;seller&apos;, &apos;order&apos;, &apos;rsv&apos;, &apos;offer&apos;, &apos;buy&apos;]
Map ROLE_KO = [seller: &apos;판매자&apos;, order: &apos;기존 주문 구매자&apos;, rsv: &apos;기존 예약 구매자&apos;, offer: &apos;새 흥정 구매자&apos;, buy: &apos;새 등록 가격 구매자&apos;]
Map ROLE_FILE = [seller: &apos;판매자&apos;, order: &apos;기존주문구매자&apos;, rsv: &apos;기존예약구매자&apos;, offer: &apos;새흥정구매자&apos;, buy: &apos;새등록가격구매자&apos;]
List STEP_HEADER = [&apos;순서&apos;, &apos;행동&apos;, &apos;결과&apos;, &apos;확인한 내용&apos;, &apos;확인 시각(이 PC)&apos;]
def stepOk = { String no, String action, String detail -&gt; appendCsv(&apos;준비_단계별확인.csv&apos;, STEP_HEADER, [no, action, &apos;통과&apos;, detail, nowText()]) }
def writeSummary = { Map m -&gt;
    StringBuilder sb = new StringBuilder(&apos;﻿항목,값\n&apos;)
    m.each { k, v -&gt; sb.append(cell(k)).append(&apos;,&apos;).append(cell(v)).append(&apos;\n&apos;) }
    saveText(&apos;실행_요약.csv&apos;, sb.toString())
}
// 준비나 요청 전 확인이 실패하면 실패 내용을 남기고 실행 전체를 멈춘다. 뒤의 그룹(검증 요청 포함)은 실행되지 않는다.
def failRun = { def res, String no, String action, String detail -&gt;
    appendCsv(&apos;준비_단계별확인.csv&apos;, STEP_HEADER, [no, action, &apos;실패&apos;, detail, nowText()])
    setp(&apos;prep_failed&apos;, no + &apos;. &apos; + action + &apos;: &apos; + detail)
    writeSummary([&apos;시나리오&apos;: vars.get(&apos;scenario&apos;), &apos;실행 번호&apos;: vars.get(&apos;runId&apos;), &apos;실행 ID&apos;: (getp(&apos;run_log_id&apos;) ?: &apos;-&apos;),
                  &apos;준비 상태&apos;: &apos;실패(&apos; + no + &apos;. &apos; + action + &apos;)&apos;, &apos;준비 실패 내용&apos;: detail,
                  &apos;검증 요청 전송 건수&apos;: &apos;0&apos;, &apos;새 가격 제안 수락 응답 분류&apos;: &apos;보내지 않음&apos;, &apos;새 등록 가격 결제 응답 분류&apos;: &apos;보내지 않음&apos;,
                  &apos;저장 결과&apos;: &apos;확인하지 않음&apos;, &apos;판정&apos;: &apos;검증 미완료(준비 또는 요청 전 확인 실패로 검증 요청을 보내지 않음)&apos;])
    res.setSuccessful(false)
    res.setResponseMessage(no + &apos;. &apos; + action + &apos; 실패: &apos; + detail)
    res.setStopTest(true)
}
// 실행 시작 그룹의 실패: 서버로 요청을 보내기 전이므로 실행 폴더에 아무 파일도 쓰지 않고, 화면의 결과와 계획_결과.jtl에만 남긴 뒤 멈춘다.
// 같은 실행 번호로 다시 시작할 수 있다.
def failStart = { def res, String detail -&gt;
    setp(&apos;prep_failed&apos;, &apos;0. 실행 시작: &apos; + detail)
    res.setSuccessful(false)
    res.setResponseMessage(&apos;실행 시작 실패(서버 요청 0건, 실행 폴더에 쓴 파일 없음): &apos; + detail)
    res.setResponseData(&apos;실행 시작 실패(서버 요청 0건, 실행 폴더에 쓴 파일 없음): &apos; + detail, &apos;UTF-8&apos;)
    res.setStopTest(true)
}
// 그룹을 앞 단계가 끝난 뒤에만 실행한다. 앞 단계가 실패했거나 이 그룹이 이미 실행됐으면 아무 요청도 보내지 않고 멈춘다.
def requireStage = { def res, String expected, String groupName -&gt;
    String failed = getp(&apos;prep_failed&apos;)
    String stage = getp(&apos;stage&apos;)
    if (failed != null || stage != expected) {
        res.setSuccessful(false)
        res.setResponseMessage(groupName + &apos; 실행 안 함: &apos; + (failed != null ? (&apos;앞 단계 실패(&apos; + failed + &apos;)&apos;) : (&apos;앞 그룹이 끝난 상태가 아님(현재 &apos; + stage + &apos;, 필요 &apos; + expected + &apos;)&apos;)))
        res.setStopTest(true)
        return false
    }
    return true
}
def loadIds = { -&gt; ROLE_KEYS.each { k -&gt; vars.put(&apos;id_&apos; + k, (getp(&apos;id_&apos; + k) ?: &apos;NOT_FOUND&apos;) as String); vars.put(&apos;tok_&apos; + k, (getp(&apos;token_&apos; + k) ?: &apos;NOT_FOUND&apos;) as String) }
    [&apos;product_id&apos;, &apos;conv_order&apos;, &apos;conv_rsv&apos;, &apos;conv_offer&apos;, &apos;conv_buy&apos;, &apos;offer_rsv&apos;, &apos;offer_new&apos;, &apos;order_id&apos;, &apos;rsv_id&apos;, &apos;run_log_id&apos;, &apos;test_log_name&apos;].each { k -&gt; vars.put(k, (getp(k) ?: &apos;NOT_FOUND&apos;) as String) } }
try {

String[] a = Parameters.split(&apos;\\|&apos;, -1)
String no = a[0], action = a[1], expectCode = a[2], file = a[3]
String checks = a.length &gt; 4 ? a[4] : &apos;&apos;
String keeps = a.length &gt; 5 ? a[5] : &apos;&apos;
String body = prev.getResponseDataAsString()
String code = prev.getResponseCode()
if (file) saveText(file, body)
def j = parse(body)
def pathGet = { def obj, String path -&gt;
    def cur = obj
    for (String part : path.split(&apos;\\.&apos;)) {
        if (cur == null) return null
        if (part ==~ /\d+/) { cur = (cur instanceof List &amp;&amp; cur.size() &gt; (part as int)) ? cur[part as int] : null }
        else if (part == &apos;size&apos;) { cur = (cur instanceof List) ? cur.size() : null }
        else { cur = (cur instanceof Map) ? cur[part] : null }
    }
    return cur
}
def expand = { String v -&gt; v.replaceAll(/\{([a-z_]+)\}/) { all, k -&gt; String.valueOf(getp(k)) } }
List&lt;String&gt; problems = []
if (code != expectCode) problems &lt;&lt; (&apos;응답 &apos; + code + &apos;(기대 &apos; + expectCode + &apos;)&apos; + ((j instanceof Map &amp;&amp; j.code) ? (&apos;, 오류 코드 &apos; + j.code) : &apos;&apos;))
else if (j == null &amp;&amp; (checks || keeps)) problems &lt;&lt; &apos;응답 본문을 읽지 못함&apos;
if (problems.isEmpty()) {
    for (String c : checks.split(&apos;;&apos;)) {
        if (!c.trim()) continue
        int i = c.indexOf(&apos;=&apos;)
        String path = c.substring(0, i)
        String want = expand(c.substring(i + 1))
        def got = pathGet(j, path)
        String gotText = (got == null ? &apos;null&apos; : String.valueOf(got))
        if (gotText != want) problems &lt;&lt; (path + &apos;=&apos; + gotText + &apos;(기대 &apos; + want + &apos;)&apos;)
    }
}
if (!problems.isEmpty()) { failRun(prev, no, action, (file ? file + &apos;: &apos; : &apos;&apos;) + problems.join(&apos;, &apos;)); return }
for (String kv : keeps.split(&apos;;&apos;)) {
    if (!kv.trim()) continue
    int i = kv.indexOf(&apos;=&apos;)
    setp(kv.substring(i + 1), String.valueOf(pathGet(j, kv.substring(0, i))))
}

} catch (Throwable t) {
String[] a2 = Parameters.split(&apos;\\|&apos;, -1)
failRun(prev, a2[0], a2[1], &apos;확인 스크립트 오류: &apos; + t)
}
