            respIssues &lt;&lt; (&apos;성공한 새 결제의 응답과 저장 결과 불일치(주문 &apos; + ordText(newOrd) + &apos;, 응답 주문 ID &apos; + respOid + &apos;, 잔액 &apos; + buyBal + &apos;, 결제 내역 &apos; + buyPurch.size() + &apos;건)&apos;)
    } else if (clsB == &apos;수량부족&apos; || clsB == &apos;기타오류&apos;) {
        if (!newOrd.isEmpty() || (buyBal as long) != 20000 || !buyPurch.isEmpty()) respIssues &lt;&lt; (&apos;거절된 새 결제에 상태 변경이 남음(주문 &apos; + ordText(newOrd) + &apos;, 잔액 &apos; + buyBal + &apos;)&apos;)
    }
}
