String jmx = org.apache.jmeter.services.FileServer.getFileServer().getScriptName()
def fmt6 = DateTimeFormatter.ofPattern(&quot;yyyy-MM-dd&apos;T&apos;HH:mm:ss.SSSSSSXXX&quot;)
def line = { String feature, String stage, String reqId, List items -&gt;
    StringBuilder sb = new StringBuilder(java.time.OffsetDateTime.now(KST).format(fmt6)).append(&apos; - &apos;).append(testName).append(&apos; - &apos;).append(feature).append(&apos; - &apos;)
        .append(jmx).append(&apos; - 결과 집계 | 실행ID=&apos;).append(getp(&apos;run_log_id&apos;)).append(&apos; 요청ID=&apos;).append(reqId).append(&apos; 단계=&apos;).append(stage).append(&apos; |&apos;)
    for (int i = 0; i + 1 &lt; items.size(); i += 2) sb.append(&apos; &apos;).append(items[i]).append(&apos;=&apos;).append(items[i + 1] == null ? &apos;-&apos; : items[i + 1])
    sb.toString()
}
