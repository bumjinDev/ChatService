<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="세부 작업 04: 기존 거래가 있는 상품의 새 가격 제안 수락과 새 등록 가격 결제 동시 요청">
      <stringProp name="TestPlan.comments">작업 003 세부 작업 04 「기존 거래가 있는 상품의 예약–등록 가격 구매 경합」의 테스트다(작업명세 07). 판매 수량 10개, 개당 10,000원인 상품에 기존 주문 3개와 기존 예약 구매자의 유효 예약 4개를 만든 뒤, 판매자의 새 가격 제안 2개 수락과 새 등록 가격 구매자의 등록 가격 결제 2개를 함께 보낸다. 새로 확보할 수 있는 수량은 3개이므로 둘 중 하나만 성공해야 하고, 기존 주문과 예약은 그대로 남아야 한다.
JMeter 화면에서 이 파일을 열고 시작하면 스레드 그룹이 위에서부터 하나씩 차례로 실행된다. 그룹을 하나씩 골라 차례로 실행해도 된다. 준비와 요청 전 확인에서 하나라도 실패하면 실행 전체를 멈추고 검증 요청을 보내지 않는다. 앞 그룹이 끝나지 않은 상태에서 뒤 그룹을 실행하면 요청을 보내지 않고 멈춘다. 검증 요청은 한 실행에서 한 번만 보낸다.
실행 시작 그룹이 DB 계정과 비밀번호를 묻는 창을 띄운다. 비밀번호는 JMeter 메모리에만 두고 파일에 쓰지 않는다. DB는 읽기 전용 트랜잭션에서 SELECT만 실행한다. 실행 시작 그룹에서 멈추면 서버 요청은 0건이고 실행 폴더에 파일을 쓰지 않으므로, 같은 실행 번호로 다시 시작할 수 있다.
dbMode=review와 reviewStartDelay_accept·reviewStartDelay_buy는 실행 파일 검토(대역 서버)에서만 바꾸는 값이다.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments">
          <elementProp name="scenario" elementType="Argument">
            <stringProp name="Argument.name">scenario</stringProp>
            <stringProp name="Argument.value">${__P(scenario,기존 거래가 있는 상품의 예약–등록 가격 구매)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">실행할 시나리오. 이 파일에는 이 시나리오 하나만 구현되어 있다</stringProp>
          </elementProp>
          <elementProp name="runId" elementType="Argument">
            <stringProp name="Argument.name">runId</stringProp>
            <stringProp name="Argument.value">${__P(runId,01)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">실행 번호 두 자리. 회원 CSV의 run_id, 상품명, 서버 로그의 실행 ID에 쓴다. 실행마다 바꾼다</stringProp>
          </elementProp>
          <elementProp name="outDir" elementType="Argument">
            <stringProp name="Argument.name">outDir</stringProp>
            <stringProp name="Argument.value">${__P(outDir,E:/devSpace/SpringBootProjects/ChatService/docs/5. 병목지점/작업산출물/작업/003_거래정합성_검증과_기술적의사결정/세부작업/04_테스트_기존거래가있는상품의_예약과등록가격구매_경합/실행결과_원본/실행01_가격제안수락1건과등록가격결제1건동시요청_20261113)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
