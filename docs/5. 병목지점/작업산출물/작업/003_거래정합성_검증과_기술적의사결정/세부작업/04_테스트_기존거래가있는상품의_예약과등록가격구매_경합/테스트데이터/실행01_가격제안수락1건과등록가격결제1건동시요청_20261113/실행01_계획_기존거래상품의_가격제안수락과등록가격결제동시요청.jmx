    [&apos;product_id&apos;, &apos;conv_order&apos;, &apos;conv_rsv&apos;, &apos;conv_offer&apos;, &apos;conv_buy&apos;, &apos;offer_rsv&apos;, &apos;offer_new&apos;, &apos;order_id&apos;, &apos;rsv_id&apos;, &apos;run_log_id&apos;, &apos;test_log_name&apos;].each { k -&gt; vars.put(k, (getp(k) ?: &apos;NOT_FOUND&apos;) as String) } }
