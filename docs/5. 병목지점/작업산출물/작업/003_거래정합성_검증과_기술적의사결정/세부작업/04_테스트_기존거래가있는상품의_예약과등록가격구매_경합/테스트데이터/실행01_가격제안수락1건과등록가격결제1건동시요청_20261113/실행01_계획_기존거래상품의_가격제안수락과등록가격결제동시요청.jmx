    [&apos;product_id&apos;, &apos;conv_order&apos;, &apos;conv_rsv&apos;, &apos;conv_offer&apos;, &apos;conv_buy&apos;, &apos;offer_rsv&apos;, &apos;offer_new&apos;, &apos;order_id&apos;, &apos;rsv_id&apos;, &apos;run_log_id&apos;, &apos;test_log_name&apos;].each { k -&gt; vars.put(k, (getp(k) ?: &apos;NOT_FOUND&apos;) as String) } }
try {

String code = prev.getResponseCode()
new File(vars.get(&apos;joinResultFile&apos;)).append([vars.get(&apos;runId&apos;), vars.get(&apos;cur_role&apos;), vars.get(&apos;cur_id&apos;), code].join(&apos;,&apos;) + &apos;\n&apos;, &apos;UTF-8&apos;)
if (code != &apos;200&apos;) {
    failRun(prev, &apos;1&apos;, &apos;다섯 회원 가입과 로그인&apos;, vars.get(&apos;cur_role&apos;) + &apos; &apos; + vars.get(&apos;cur_id&apos;) + &apos; 가입 응답 &apos; + code + &apos;(기대 200)&apos;)
}

} catch (Throwable t) {
failRun(prev, &apos;1&apos;, &apos;다섯 회원 가입과 로그인&apos;, &apos;확인 스크립트 오류: &apos; + t)
