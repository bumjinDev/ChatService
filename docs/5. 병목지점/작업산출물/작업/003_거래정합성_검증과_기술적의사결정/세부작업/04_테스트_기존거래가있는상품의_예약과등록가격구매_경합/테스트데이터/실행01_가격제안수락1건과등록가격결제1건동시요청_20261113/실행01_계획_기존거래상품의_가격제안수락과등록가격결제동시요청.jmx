    long ordQty = (snap.PURCHASE_ORDER.sum { it.QUANTITY as long } ?: 0), rsvQty = (validRows(snap).sum { it.QUANTITY as long } ?: 0)
    if (ordQty + rsvQty &gt; 10) violations &lt;&lt; (&apos;수량 초과: 주문 &apos; + ordQty + &apos;개 + 유효 예약 &apos; + rsvQty + &apos;개 = &apos; + (ordQty + rsvQty) + &apos;개 &gt; 판매 수량 10개&apos;)
    if ((snap.PRODUCT[0].REMAINING_QUANTITY as long) != 10 - ordQty) violations &lt;&lt; (&apos;남은 수량 &apos; + snap.PRODUCT[0].REMAINING_QUANTITY + &apos;개 ≠ 10 − 주문 수량 &apos; + ordQty + &apos;개&apos;)
}
if (rows.any { it[0] == &apos;기존 주문 전후 대조&apos; &amp;&amp; it[6] == &apos;불일치&apos; }) violations &lt;&lt; &apos;기존 주문 변경&apos;
if (rows.any { it[0] == &apos;기존 예약 전후 대조&apos; &amp;&amp; it[6] == &apos;불일치&apos; } &amp;&amp; !rsvExpiredByTime) violations &lt;&lt; &apos;기존 예약 침해(변경·해제·주문 전환)&apos;
violations.addAll(respIssues)
if (rows.any { it[0] == &apos;공통 규칙&apos; &amp;&amp; it[1].contains(&apos;구매 가능 수량&apos;) &amp;&amp; it[6] == &apos;불일치&apos; }) violations &lt;&lt; &apos;상품 상세의 구매 가능 수량이 정의와 다름&apos;
if (clsA == &apos;성공&apos; &amp;&amp; clsB == &apos;성공&apos;) violations &lt;&lt; &apos;두 새 요청이 모두 성공(새로 확보 가능한 3개보다 많은 4개를 확보)&apos;
if (clsA == &apos;수량부족&apos; &amp;&amp; clsB == &apos;수량부족&apos;) investigate &lt;&lt; &apos;두 새 요청이 모두 수량 부족으로 거절됨(새로 확보 가능한 3개를 쓰지 못한 판단 조사)&apos;
List abRows = rows.findAll { it[0] in [&apos;전체 상태&apos;, &apos;잔액&apos;, &apos;구매 가능 수량&apos;, &apos;새 수락&apos;, &apos;새 결제&apos;] }
String stored
if (abRows.any { it[6] == &apos;확인 못함&apos; }) stored = &apos;확인 못함(조회하지 못한 항목 있음)&apos;
else if (abRows.every { it[6] in [&apos;A&apos;, &apos;A·B&apos;] }) stored = &apos;A: 새 수락 성공·새 결제 거절과 같음&apos;
else if (abRows.every { it[6] in [&apos;B&apos;, &apos;A·B&apos;] }) stored = &apos;B: 새 수락 거절·새 결제 성공과 같음&apos;
else {
    def names = { String k -&gt; abRows.findAll { it[6] == k }.collect { it[1] } }
    stored = &apos;허용 결과와 다름(A에만 맞는 항목: &apos; + (names(&apos;A&apos;) ?: [&apos;없음&apos;]).join(&apos;, &apos;) + &apos; / B에만 맞는 항목: &apos; + (names(&apos;B&apos;) ?: [&apos;없음&apos;]).join(&apos;, &apos;) +
             &apos; / 어느 쪽에도 맞지 않는 항목: &apos; + (names(&apos;어느 쪽도 아님&apos;) ?: [&apos;없음&apos;]).join(&apos;, &apos;) + &apos;)&apos;
}
String verdict
if (!violations.isEmpty()) verdict = &apos;규칙 위반 확인&apos;
else if (!incomplete.isEmpty()) verdict = &apos;검증 미완료&apos;
else if (stored.startsWith(&apos;A&apos;) || stored.startsWith(&apos;B&apos;)) verdict = &apos;허용 결과 &apos; + stored.substring(0, 1) + &apos;(저장 상태 기준 규칙 준수). 두 요청의 처리가 겹쳤는지는 서버 로그로 따로 확인&apos;
