        &apos;주문건수&apos;, snap?.PURCHASE_ORDER?.size(), &apos;주문수량합계&apos;, snap == null ? null : (snap.PURCHASE_ORDER.sum { it.QUANTITY as long } ?: 0), &apos;남은수량&apos;, snap?.PRODUCT?.getAt(0)?.REMAINING_QUANTITY,
        &apos;상품상태&apos;, snap?.PRODUCT?.getAt(0)?.STATUS, &apos;저장결과&apos;, stored, &apos;결과확인기준위반&apos;, violations ? violations.join(&apos;; &apos;) : &apos;없음&apos;, &apos;미확인&apos;, incomplete ? incomplete.join(&apos;; &apos;) : &apos;없음&apos;, &apos;판정&apos;, verdict])]
saveText(&apos;종료후확인.log&apos;, logLines.join(&apos;\n&apos;) + &apos;\n&apos;)
writeSummary([&apos;시나리오&apos;: vars.get(&apos;scenario&apos;), &apos;실행 번호&apos;: vars.get(&apos;runId&apos;), &apos;실행 ID&apos;: getp(&apos;run_log_id&apos;),
              &apos;준비 상태&apos;: &apos;통과(준비 9단계와 요청 전 확인 일치)&apos;,
              &apos;검증 요청 전송 건수&apos;: String.valueOf([getp(&apos;sent_accept&apos;), getp(&apos;sent_buy&apos;)].count { it != null }),
              &apos;두 요청의 전송 시작 시각 차이(ms)&apos;: startGap,
              &apos;새 가격 제안 수락 응답 분류&apos;: clsA + (ra ? (&apos; (HTTP &apos; + ra.code + &apos;, &apos; + ra.reason + &apos;)&apos;) : &apos;&apos;),
              &apos;새 등록 가격 결제 응답 분류&apos;: clsB + (rb ? (&apos; (HTTP &apos; + rb.code + &apos;, &apos; + rb.reason + &apos;)&apos;) : &apos;&apos;),
              &apos;새 가격 제안 수락의 저장 결과&apos;: getp(&apos;saved_accept&apos;) ?: &apos;확인 못함&apos;, &apos;새 등록 가격 결제의 저장 결과&apos;: getp(&apos;saved_buy&apos;) ?: &apos;확인 못함&apos;,
              &apos;전체 저장 결과&apos;: stored, &apos;규칙 위반&apos;: violations ? violations.join(&apos;; &apos;) : &apos;없음&apos;, &apos;검증 미완료 사유&apos;: incomplete ? incomplete.join(&apos;; &apos;) : &apos;없음&apos;,
              &apos;조사할 사항&apos;: investigate ? investigate.join(&apos;; &apos;) : &apos;없음&apos;,
              &apos;경합 확인&apos;: &apos;서버 로그(판단값과 커밋 순서)로 따로 확인. 이 파일은 전송 시각만으로 겹침을 판단하지 않음&apos;, &apos;판정&apos;: verdict])
SampleResult.setResponseData(verdict + &apos; / 저장 결과 &apos; + stored + &apos; / 위반 &apos; + violations + &apos; / 미확인 &apos; + incomplete, &apos;UTF-8&apos;)
if (!violations.isEmpty() || !incomplete.isEmpty()) SampleResult.setSuccessful(false)

} catch (Throwable t) {
writeSummary([&apos;시나리오&apos;: vars.get(&apos;scenario&apos;), &apos;실행 ID&apos;: getp(&apos;run_log_id&apos;), &apos;판정&apos;: &apos;집계 스크립트 오류로 판정하지 못함: &apos; + t])
SampleResult.setSuccessful(false); SampleResult.setResponseMessage(&apos;집계 스크립트 오류: &apos; + t)
}
