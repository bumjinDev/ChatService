          </elementProp>
          <elementProp name="memberFile" elementType="Argument">
            <stringProp name="Argument.name">memberFile</stringProp>
            <stringProp name="Argument.value">${__P(memberFile,E:/devSpace/SpringBootProjects/ChatService/docs/5. 병목지점/작업산출물/작업/003_거래정합성_검증과_기술적의사결정/세부작업/04_테스트_기존거래가있는상품의_예약과등록가격구매_경합/테스트데이터/실행01_가격제안수락1건과등록가격결제1건동시요청_20261113/실행01_회원.csv)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">판매자와 구매자 네 명의 ID와 비밀번호가 있는 회원 CSV</stringProp>
          </elementProp>
          <elementProp name="joinResultFile" elementType="Argument">
            <stringProp name="Argument.name">joinResultFile</stringProp>
            <stringProp name="Argument.value">${__P(joinResultFile,E:/devSpace/SpringBootProjects/ChatService/docs/5. 병목지점/작업산출물/작업/003_거래정합성_검증과_기술적의사결정/세부작업/04_테스트_기존거래가있는상품의_예약과등록가격구매_경합/테스트데이터/실행01_가격제안수락1건과등록가격결제1건동시요청_20261113/실행01_회원가입결과.csv)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">가입 결과를 쓸 CSV 파일(비밀번호는 쓰지 않는다)</stringProp>
          </elementProp>
          <elementProp name="serverHost" elementType="Argument">
