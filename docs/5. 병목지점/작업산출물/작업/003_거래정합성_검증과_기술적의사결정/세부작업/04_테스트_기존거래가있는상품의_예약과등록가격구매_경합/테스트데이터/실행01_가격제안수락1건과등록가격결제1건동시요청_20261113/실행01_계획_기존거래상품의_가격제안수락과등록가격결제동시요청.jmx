// ---- 판정
List&lt;String&gt; violations = [], incomplete = [], investigate = []
boolean qf = rows.any { it[6] == &apos;확인 못함&apos; }
if (dbError != null) incomplete &lt;&lt; (&apos;DB 조회 실패: &apos; + dbError)
if (qf) incomplete &lt;&lt; (&apos;조회하지 못한 항목 &apos; + rows.count { it[6] == &apos;확인 못함&apos; } + &apos;개(없는 것으로 계산하지 않음)&apos;)
[[&apos;새 가격 제안 수락&apos;, clsA], [&apos;새 등록 가격 결제&apos;, clsB]].each { p -&gt; if (p[1] == &apos;미확인&apos;) incomplete &lt;&lt; (p[0] + &apos; 응답 미확인(서버 처리 완료 여부를 서버 로그로 확인하기 전까지 판정 보류)&apos;) }
[[&apos;새 가격 제안 수락&apos;, clsA, ra], [&apos;새 등록 가격 결제&apos;, clsB, rb]].each { p -&gt;
    if (p[1] == &apos;기타오류&apos;) investigate &lt;&lt; (p[0] + &apos; 기타 오류: &apos; + p[2].reason)
    if (p[1] == &apos;수량부족&apos; &amp;&amp; !p[2].reason.contains(&apos;허용하는&apos;)) investigate &lt;&lt; (p[0] + &apos; 예상과 다른 거절 사유: &apos; + p[2].reason)
}
if (clsA == &apos;보내지 않음&apos; || clsB == &apos;보내지 않음&apos;) incomplete &lt;&lt; &apos;검증 요청 일부만 보냄(계획한 경합의 완료로 보지 않음)&apos;
boolean rsvExpiredByTime = false
