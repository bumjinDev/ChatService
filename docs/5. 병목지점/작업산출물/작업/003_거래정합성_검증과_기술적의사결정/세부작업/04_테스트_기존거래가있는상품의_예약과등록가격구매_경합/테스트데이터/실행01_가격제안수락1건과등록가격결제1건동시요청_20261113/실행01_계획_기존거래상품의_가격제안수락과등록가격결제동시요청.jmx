        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="${cur_role} 로그인" enabled="true">
            <stringProp name="TestPlan.comments">로그인해 로그인 쿠키를 받는다. 토큰은 JMeter 속성에만 두고 파일에 쓰지 않는다.</stringProp>
            <intProp name="HTTPSampler.connect_timeout">5000</intProp>
            <intProp name="HTTPSampler.response_timeout">30000</intProp>
            <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
