    res.setSuccessful(false)
    res.setResponseMessage(no + &apos;. &apos; + action + &apos; 실패: &apos; + detail)
    res.setStopTest(true)
}
// 실행 시작 그룹의 실패: 서버로 요청을 보내기 전이므로 실행 폴더에 아무 파일도 쓰지 않고, 화면의 결과와 계획_결과.jtl에만 남긴 뒤 멈춘다.
// 같은 실행 번호로 다시 시작할 수 있다.
def failStart = { def res, String detail -&gt;
    setp(&apos;prep_failed&apos;, &apos;0. 실행 시작: &apos; + detail)
    res.setSuccessful(false)
    res.setResponseMessage(&apos;실행 시작 실패(서버 요청 0건, 실행 폴더에 쓴 파일 없음): &apos; + detail)
    res.setResponseData(&apos;실행 시작 실패(서버 요청 0건, 실행 폴더에 쓴 파일 없음): &apos; + detail, &apos;UTF-8&apos;)
    res.setStopTest(true)
}
// 그룹을 앞 단계가 끝난 뒤에만 실행한다. 앞 단계가 실패했거나 이 그룹이 이미 실행됐으면 아무 요청도 보내지 않고 멈춘다.
def requireStage = { def res, String expected, String groupName -&gt;
    String failed = getp(&apos;prep_failed&apos;)
    String stage = getp(&apos;stage&apos;)
    if (failed != null || stage != expected) {
        res.setSuccessful(false)
        res.setResponseMessage(groupName + &apos; 실행 안 함: &apos; + (failed != null ? (&apos;앞 단계 실패(&apos; + failed + &apos;)&apos;) : (&apos;앞 그룹이 끝난 상태가 아님(현재 &apos; + stage + &apos;, 필요 &apos; + expected + &apos;)&apos;)))
        res.setStopTest(true)
        return false
    }
    return true
}
def loadIds = { -&gt; ROLE_KEYS.each { k -&gt; vars.put(&apos;id_&apos; + k, (getp(&apos;id_&apos; + k) ?: &apos;NOT_FOUND&apos;) as String); vars.put(&apos;tok_&apos; + k, (getp(&apos;token_&apos; + k) ?: &apos;NOT_FOUND&apos;) as String) }
    [&apos;product_id&apos;, &apos;conv_order&apos;, &apos;conv_rsv&apos;, &apos;conv_offer&apos;, &apos;conv_buy&apos;, &apos;offer_rsv&apos;, &apos;offer_new&apos;, &apos;order_id&apos;, &apos;rsv_id&apos;, &apos;run_log_id&apos;, &apos;test_log_name&apos;].each { k -&gt; vars.put(k, (getp(k) ?: &apos;NOT_FOUND&apos;) as String) } }

Map COLS = [
    PRODUCT: [&apos;PRODUCT_ID&apos;, &apos;SELLER_ID&apos;, &apos;NAME&apos;, &apos;CATEGORY&apos;, &apos;PRICE&apos;, &apos;INITIAL_QUANTITY&apos;, &apos;REMAINING_QUANTITY&apos;, &apos;STATUS&apos;, &apos;CREATED_AT&apos;, &apos;SOLD_AT&apos;],
    CONVERSATION: [&apos;CONVERSATION_ID&apos;, &apos;PRODUCT_ID&apos;, &apos;BUYER_ID&apos;, &apos;SELLER_ID&apos;, &apos;CREATED_BY_SYSTEM&apos;, &apos;CREATED_AT&apos;],
    PRICE_OFFER: [&apos;OFFER_ID&apos;, &apos;CONVERSATION_ID&apos;, &apos;PRODUCT_ID&apos;, &apos;BUYER_ID&apos;, &apos;SELLER_ID&apos;, &apos;AMOUNT&apos;, &apos;QUANTITY&apos;, &apos;STATUS&apos;, &apos;REQUEST_ID&apos;, &apos;CREATED_AT&apos;, &apos;RESPONDED_AT&apos;],
    RESERVATION: [&apos;RESERVATION_ID&apos;, &apos;PRODUCT_ID&apos;, &apos;CONVERSATION_ID&apos;, &apos;BUYER_ID&apos;, &apos;SELLER_ID&apos;, &apos;OFFER_ID&apos;, &apos;QUANTITY&apos;, &apos;STATUS&apos;, &apos;RESERVED_AT&apos;, &apos;EXPIRES_AT&apos;, &apos;ENDED_AT&apos;, &apos;RELEASED_BY&apos;, &apos;FULFILLED_ORDER_ID&apos;],
    PURCHASE_ORDER: [&apos;ORDER_ID&apos;, &apos;PRODUCT_ID&apos;, &apos;BUYER_ID&apos;, &apos;SELLER_ID&apos;, &apos;QUANTITY&apos;, &apos;UNIT_PRICE&apos;, &apos;PAID_AMOUNT&apos;, &apos;PRICE_SOURCE&apos;, &apos;OFFER_ID&apos;, &apos;SHIPPING_STATUS&apos;, &apos;TRADE_STATUS&apos;, &apos;CONFIRMED_AT&apos;, &apos;SHIP_DEADLINE_AT&apos;, &apos;REQUEST_ID&apos;],
    WALLET: [&apos;MEMBER_ID&apos;, &apos;BALANCE&apos;, &apos;UPDATED_AT&apos;],
    BALANCE_TRANSACTION: [&apos;TRANSACTION_ID&apos;, &apos;MEMBER_ID&apos;, &apos;TYPE&apos;, &apos;AMOUNT&apos;, &apos;BALANCE_AFTER&apos;, &apos;ORDER_ID&apos;, &apos;REQUEST_ID&apos;, &apos;CREATED_AT&apos;]]
Map TABLE_KO = [PRODUCT: &apos;상품&apos;, CONVERSATION: &apos;대화&apos;, PRICE_OFFER: &apos;가격제안&apos;, RESERVATION: &apos;예약&apos;, PURCHASE_ORDER: &apos;주문&apos;, WALLET: &apos;잔액&apos;, BALANCE_TRANSACTION: &apos;잔액변동&apos;]
List TS_COLS = [&apos;CREATED_AT&apos;, &apos;SOLD_AT&apos;, &apos;RESPONDED_AT&apos;, &apos;RESERVED_AT&apos;, &apos;EXPIRES_AT&apos;, &apos;ENDED_AT&apos;, &apos;CONFIRMED_AT&apos;, &apos;SHIP_DEADLINE_AT&apos;, &apos;UPDATED_AT&apos;]
String TS_FMT = &apos;\&apos;YYYY-MM-DD&quot;T&quot;HH24:MI:SS.FF6&quot;Z&quot;\&apos;&apos;
// DB 계정과 비밀번호를 받아 JMeter 속성(메모리)에 둔다. 실행 파일 검토(dbMode=review)에서는 받지 않는다.
// JMeter 화면에서 실행하면 입력 창을 띄우고, 명령줄 실행이면 환경변수 EXRB_DB_USER, EXRB_DB_PASSWORD를 읽는다. 실패하면 사유를, 성공하면 null을 돌려준다.
def askDbCredentials = { -&gt;
    if (vars.get(&apos;dbMode&apos;) == &apos;review&apos;) { setp(&apos;db_user&apos;, &apos;대역 DB&apos;); return null }
    if (getp(&apos;db_pw&apos;) != null) return null
    if (org.apache.jmeter.gui.GuiPackage.getInstance() != null) {
        Map got = [:]
        javax.swing.SwingUtilities.invokeAndWait({
            def userField = new javax.swing.JTextField(vars.get(&apos;dbUser&apos;), 20)
            def pwField = new javax.swing.JPasswordField(20)
            def panel = new javax.swing.JPanel(new java.awt.GridLayout(0, 1, 0, 4))
            panel.add(new javax.swing.JLabel(&apos;읽기 전용 DB 조회에 쓸 계정과 비밀번호(파일에 저장하지 않음)&apos;))
            panel.add(new javax.swing.JLabel(&apos;DB 계정&apos;)); panel.add(userField)
            panel.add(new javax.swing.JLabel(&apos;DB 비밀번호&apos;)); panel.add(pwField)
            def frame = org.apache.jmeter.gui.GuiPackage.getInstance().getMainFrame()
            def pane = new javax.swing.JOptionPane(panel, javax.swing.JOptionPane.PLAIN_MESSAGE, javax.swing.JOptionPane.OK_CANCEL_OPTION)
            def dialog = pane.createDialog(frame, &apos;실행 시작: DB 계정과 비밀번호 입력&apos;)
            dialog.addWindowFocusListener(new java.awt.event.WindowAdapter() { void windowGainedFocus(java.awt.event.WindowEvent e) { pwField.requestFocusInWindow() } })
            dialog.setVisible(true)
            if (pane.getValue() == javax.swing.JOptionPane.OK_OPTION) { got.user = userField.getText().trim(); got.pw = new String(pwField.getPassword()) }
            dialog.dispose()
        } as Runnable)
        if (!got.user || !got.pw) return &apos;DB 계정과 비밀번호를 입력하지 않음(입력 창을 취소함)&apos;
        setp(&apos;db_user&apos;, got.user); setp(&apos;db_pw&apos;, got.pw)
        return null
    }
    String user = System.getenv(&apos;EXRB_DB_USER&apos;) ?: vars.get(&apos;dbUser&apos;), pw = System.getenv(&apos;EXRB_DB_PASSWORD&apos;)
    if (!pw) return &apos;명령줄 실행인데 DB 비밀번호 환경변수(EXRB_DB_PASSWORD)가 없음&apos;
    setp(&apos;db_user&apos;, user); setp(&apos;db_pw&apos;, pw)
    return null
}
// 읽기 전용 트랜잭션을 열어 body(q)를 실행하고 연결을 닫는다. q는 SELECT를 실행해 행 목록(열 이름은 대문자)을 돌려준다.
def withReadOnlyDb = { Closure body -&gt;
    if (getp(&apos;db_pw&apos;) == null) {
        String err = askDbCredentials()
        if (err != null) throw new IllegalStateException(err)
    }
    def loader = new URLClassLoader([new File(vars.get(&apos;ojdbcJar&apos;)).toURI().toURL()] as URL[], this.class.classLoader)
    def driver = loader.loadClass(&apos;oracle.jdbc.OracleDriver&apos;).getDeclaredConstructor().newInstance()
    Properties info = new Properties()
    info.put(&apos;user&apos;, getp(&apos;db_user&apos;))
    info.put(&apos;password&apos;, getp(&apos;db_pw&apos;))
    info.put(&apos;oracle.net.CONNECT_TIMEOUT&apos;, &apos;5000&apos;)
    info.put(&apos;oracle.jdbc.ReadTimeout&apos;, &apos;30000&apos;)
    java.sql.Connection c = driver.connect(vars.get(&apos;dbUrl&apos;), info)
    if (c == null) throw new IllegalStateException(&apos;Oracle 드라이버가 접속 주소를 받지 않음&apos;)
    try {
        c.setAutoCommit(false)
        // 읽기 전용 트랜잭션: 이 안의 SELECT는 모두 트랜잭션 시작 시점의 같은 상태를 읽고, 데이터를 바꾸는 문장은 실행할 수 없다.
        def st = c.createStatement(); st.execute(&apos;SET TRANSACTION READ ONLY&apos;); st.close()
        def q = { String sql, List params -&gt;
            def ps = c.prepareStatement(sql)
            ps.setQueryTimeout(30)
            params.eachWithIndex { v, i -&gt; ps.setObject(i + 1, v) }
            def rs = ps.executeQuery()
            def md = rs.getMetaData()
            List out = []
            while (rs.next()) {
                Map m = [:]
                for (int i = 1; i &lt;= md.getColumnCount(); i++) {
                    def v = rs.getObject(i)
                    if (v instanceof BigDecimal) { v = (v.stripTrailingZeros().scale() &lt;= 0) ? v.longValueExact() : v }
                    m[md.getColumnLabel(i).toUpperCase()] = v
                }
                out &lt;&lt; m
            }
            rs.close(); ps.close()
            return out
        }
        return body(q)
    } finally {
        try { c.rollback() } catch (Exception ignore) { }
        c.close()
    }
}
def reviewGet = { String pathAndQuery -&gt;
    def conn = new URL(&apos;http://&apos; + vars.get(&apos;serverHost&apos;) + &apos;:&apos; + vars.get(&apos;serverPort&apos;) + pathAndQuery).openConnection()
    conn.setConnectTimeout(5000)
    conn.setReadTimeout(30000)
    int code = conn.responseCode
    if (code != 200) throw new IllegalStateException(&apos;대역 DB 조회 응답 &apos; + code)
    return new JsonSlurper().parse(conn.inputStream, &apos;UTF-8&apos;)
}
// 상품 ID 목록의 PRODUCT 행(ID와 이름). 실행 시작 그룹이 DB 계정을 확인할 때 쓴다.
def dbProducts = { List&lt;Long&gt; ids -&gt;
    if (vars.get(&apos;dbMode&apos;) == &apos;review&apos;) return reviewGet(&apos;/__review_db/products?ids=&apos; + ids.join(&apos;,&apos;)) as List
    return withReadOnlyDb { q -&gt; q(&apos;SELECT PRODUCT_ID, NAME FROM PRODUCT WHERE PRODUCT_ID IN (&apos; + ids.collect { &apos;?&apos; }.join(&apos;, &apos;) + &apos;)&apos;, ids) }
}
def dbSnapshot = { String phase, String pid, List&lt;String&gt; members -&gt;
    if (vars.get(&apos;dbMode&apos;) == &apos;review&apos;) {
        Map snap = reviewGet(&apos;/__review_db/snapshot?productId=&apos; + pid + &apos;&amp;members=&apos; + members.join(&apos;,&apos;) + &apos;&amp;phase=&apos; + URLEncoder.encode(phase, &apos;UTF-8&apos;))
        snap.mode = &apos;대역 서버의 DB 모양 응답&apos;
        return snap
    }
    return withReadOnlyDb { q -&gt;
        Map snap = [:]
        snap.db_now = q(&apos;SELECT TO_CHAR(SYS_EXTRACT_UTC(SYSTIMESTAMP), &apos; + TS_FMT + &apos;) AS DB_NOW FROM DUAL&apos;, [])[0].DB_NOW
        try { snap.version = q(&apos;SELECT PRODUCT || \&apos; \&apos; || VERSION AS V FROM PRODUCT_COMPONENT_VERSION&apos;, []).collect { it.V }.join(&apos;; &apos;) }
        catch (Exception e) { snap.version = &apos;조회 못함(&apos; + e.getClass().getSimpleName() + &apos;)&apos; }
        String memberIn = members.collect { &apos;?&apos; }.join(&apos;, &apos;)
        COLS.each { String table, List cols -&gt;
            String select = cols.collect { TS_COLS.contains(it) ? (&apos;TO_CHAR(&apos; + it + &apos;, &apos; + TS_FMT + &apos;) AS &apos; + it) : it }.join(&apos;, &apos;)
            boolean byMember = table in [&apos;WALLET&apos;, &apos;BALANCE_TRANSACTION&apos;]
            String where = byMember ? (&apos; WHERE MEMBER_ID IN (&apos; + memberIn + &apos;)&apos;) : (&apos; WHERE PRODUCT_ID = ?&apos;)
            List params = byMember ? members : [pid as long]
            snap[table] = q(&apos;SELECT &apos; + select + &apos; FROM &apos; + table + where + &apos; ORDER BY &apos; + cols[0], params)
        }
        snap.db_now_end = q(&apos;SELECT TO_CHAR(SYS_EXTRACT_UTC(SYSTIMESTAMP), &apos; + TS_FMT + &apos;) AS DB_NOW FROM DUAL&apos;, [])[0].DB_NOW
        snap.mode = &apos;읽기 전용 트랜잭션&apos;
        return snap
    }
}
def saveDbCsv = { String phaseKo, Map snap, long localStart, long localEnd -&gt;
    COLS.each { String table, List cols -&gt;
        List rows = (snap[table] ?: []).collect { Map r -&gt; cols.collect { r[it] } }
        writeCsv(phaseKo + &apos;_DB_&apos; + TABLE_KO[table] + &apos;.csv&apos;, cols, rows)
    }
    writeCsv(phaseKo + &apos;_DB_조회시각과버전.csv&apos;, [&apos;항목&apos;, &apos;값&apos;], [
        [&apos;DB 시각(조회 시작, UTC)&apos;, snap.db_now], [&apos;DB 시각(조회 끝, UTC)&apos;, snap.db_now_end],
        [&apos;이 PC 시각(조회 시작)&apos;, fmtMs(localStart)], [&apos;이 PC 시각(조회 끝)&apos;, fmtMs(localEnd)],
        [&apos;DB 버전&apos;, snap.version], [&apos;조회 방식&apos;, snap.mode]])
}

String NA = &apos;해당 없음&apos;
String QF = &apos;조회 실패&apos;
def sv = { v -&gt; (v == null) ? &apos;null&apos; : String.valueOf(v) }
def isoN = { v -&gt; (v == null) ? &apos;null&apos; : Instant.parse(String.valueOf(v)).toString() }
def apiBody = { Map api, String k -&gt; Map m = api?.get(k); (m == null || m.failed) ? null : m.body }
def apiVal = { Map api, String k, Closure f -&gt; def b = apiBody(api, k); if (b == null) return QF; try { return f(b) } catch (Exception e) { return QF } }
def dbVal = { Map snap, Closure f -&gt; if (snap == null) return QF; try { return f(snap) } catch (Exception e) { return QF } }
def validAt = { Map r, String now -&gt; r != null &amp;&amp; r.STATUS == &apos;ACTIVE&apos; &amp;&amp; Instant.parse(r.EXPIRES_AT as String).isAfter(Instant.parse(now)) }
def txText = { List txs -&gt; txs.collect { it.TYPE + &apos; &apos; + it.AMOUNT + &apos; 잔액 &apos; + it.BALANCE_AFTER + (it.ORDER_ID == null ? &apos;&apos; : (&apos; 주문 &apos; + it.ORDER_ID)) }.join(&apos; / &apos;) }
def apiTxText = { List txs -&gt; txs.sort { it.transactionId }.collect { it.type + &apos; &apos; + it.amount + &apos; 잔액 &apos; + it.balanceAfter + (it.orderId == null ? &apos;&apos; : (&apos; 주문 &apos; + it.orderId)) }.join(&apos; / &apos;) }
try {

// 요청 전 확인: API 조회 결과와 읽기 전용 DB 조회 결과를 출발 상태와 대조한다. 모두 맞을 때만 준비 완료를 표시한다.
if (getp(&apos;prep_failed&apos;) != null || getp(&apos;stage&apos;) != &apos;G7&apos;) { SampleResult.setSuccessful(false); SampleResult.setStopTest(true); return }
Map api = getp(&apos;pre_api&apos;) ?: [:]
Map ids = [:]; ROLE_KEYS.each { ids[it] = getp(&apos;id_&apos; + it) }
String pid = getp(&apos;product_id&apos;)
long localStart = System.currentTimeMillis()
Map snap = null
String dbError = null
try { snap = dbSnapshot(&apos;요청전&apos;, pid, ROLE_KEYS.collect { ids[it] }) } catch (Exception e) { dbError = e.getClass().getSimpleName() + &apos;: &apos; + e.getMessage() }
long localEnd = System.currentTimeMillis()
if (snap != null) saveDbCsv(&apos;요청전&apos;, snap, localStart, localEnd)
List rows = []
def chk = { String area, String item, Object want, Object apiV, Object dbV -&gt;
    List vals = [apiV, dbV].findAll { it != NA }
    String result = vals.any { it == QF } ? &apos;확인 못함&apos; : (vals.every { sv(it) == sv(want) } ? &apos;일치&apos; : &apos;불일치&apos;)
    rows &lt;&lt; [area, item, sv(want), sv(apiV), sv(dbV), result]
}
if (dbError != null) rows &lt;&lt; [&apos;DB&apos;, &apos;읽기 전용 조회&apos;, &apos;성공&apos;, NA, dbError, &apos;확인 못함&apos;]
String now = (snap != null) ? snap.db_now : null
def P = { Closure f -&gt; dbVal(snap, { s -&gt; s.PRODUCT.isEmpty() ? &apos;행 없음&apos; : f(s.PRODUCT[0]) }) }
// 서버
chk(&apos;서버&apos;, &apos;처리 기준 시각 고정 여부&apos;, &apos;false&apos;, apiVal(api, &apos;clock&apos;, { it.fixed }), NA)
chk(&apos;서버&apos;, &apos;일시 중지로 멈춰 있는 요청 수&apos;, &apos;0&apos;, apiVal(api, &apos;pauses&apos;, { it.size() }), NA)
// 상품
chk(&apos;상품&apos;, &apos;대상 상품 행 수&apos;, &apos;1&apos;, NA, dbVal(snap, { it.PRODUCT.size() }))
chk(&apos;상품&apos;, &apos;최초 수량&apos;, &apos;10&apos;, apiVal(api, &apos;product_rsv&apos;, { it.initialQuantity }), P { it.INITIAL_QUANTITY })
chk(&apos;상품&apos;, &apos;남은 수량(기존 예약 구매자 조회)&apos;, &apos;7&apos;, apiVal(api, &apos;product_rsv&apos;, { it.remainingQuantity }), P { it.REMAINING_QUANTITY })
chk(&apos;상품&apos;, &apos;남은 수량(새 등록 가격 구매자 조회)&apos;, &apos;7&apos;, apiVal(api, &apos;product_buy&apos;, { it.remainingQuantity }), NA)
chk(&apos;상품&apos;, &apos;상태&apos;, &apos;ON_SALE&apos;, apiVal(api, &apos;product_rsv&apos;, { it.status }), P { it.STATUS })
chk(&apos;상품&apos;, &apos;등록 가격&apos;, &apos;10000&apos;, apiVal(api, &apos;product_rsv&apos;, { it.price }), P { it.PRICE })
chk(&apos;상품&apos;, &apos;판매자&apos;, ids.seller, NA, P { it.SELLER_ID })
// 대화
chk(&apos;대화&apos;, &apos;대상 상품의 대화 수&apos;, &apos;4&apos;, NA, dbVal(snap, { it.CONVERSATION.size() }))
[&apos;order&apos;, &apos;rsv&apos;, &apos;offer&apos;, &apos;buy&apos;].each { k -&gt;
    chk(&apos;대화&apos;, ROLE_KO[k] + &apos;의 대화 ID&apos;, getp(&apos;conv_&apos; + k), apiVal(api, &apos;conv_&apos; + k, { it.conversationId }), dbVal(snap, { s -&gt; s.CONVERSATION.find { it.BUYER_ID == ids[k] }?.CONVERSATION_ID }))
    chk(&apos;대화&apos;, ROLE_KO[k] + &apos;의 대화 판매자&apos;, ids.seller, NA, dbVal(snap, { s -&gt; s.CONVERSATION.find { it.BUYER_ID == ids[k] }?.SELLER_ID }))
}
// 가격 제안
chk(&apos;가격 제안&apos;, &apos;대상 상품의 가격 제안 수&apos;, &apos;2&apos;, NA, dbVal(snap, { it.PRICE_OFFER.size() }))
def offerRow = { Map s, String id -&gt; s.PRICE_OFFER.find { String.valueOf(it.OFFER_ID) == id } }
String oR = getp(&apos;offer_rsv&apos;), oN = getp(&apos;offer_new&apos;)
chk(&apos;가격 제안&apos;, &apos;기존 예약 구매자 제안의 구매자&apos;, ids.rsv, NA, dbVal(snap, { offerRow(it, oR)?.BUYER_ID }))
chk(&apos;가격 제안&apos;, &apos;기존 예약 구매자 제안의 상태&apos;, &apos;ACCEPTED&apos;, apiVal(api, &apos;conv_rsv&apos;, { b -&gt; b.offers.find { String.valueOf(it.offerId) == oR }?.status }), dbVal(snap, { offerRow(it, oR)?.STATUS }))
chk(&apos;가격 제안&apos;, &apos;기존 예약 구매자 제안의 수량&apos;, &apos;4&apos;, apiVal(api, &apos;conv_rsv&apos;, { b -&gt; b.offers.find { String.valueOf(it.offerId) == oR }?.quantity }), dbVal(snap, { offerRow(it, oR)?.QUANTITY }))
chk(&apos;가격 제안&apos;, &apos;기존 예약 구매자 제안의 개당 금액&apos;, &apos;9000&apos;, NA, dbVal(snap, { offerRow(it, oR)?.AMOUNT }))
chk(&apos;가격 제안&apos;, &apos;기존 예약 구매자 제안의 대화&apos;, getp(&apos;conv_rsv&apos;), NA, dbVal(snap, { offerRow(it, oR)?.CONVERSATION_ID }))
chk(&apos;가격 제안&apos;, &apos;새 흥정 구매자 제안의 구매자&apos;, ids.offer, NA, dbVal(snap, { offerRow(it, oN)?.BUYER_ID }))
chk(&apos;가격 제안&apos;, &apos;새 흥정 구매자 제안의 상태&apos;, &apos;PENDING&apos;, apiVal(api, &apos;conv_offer&apos;, { b -&gt; b.offers.find { String.valueOf(it.offerId) == oN }?.status }), dbVal(snap, { offerRow(it, oN)?.STATUS }))
chk(&apos;가격 제안&apos;, &apos;새 흥정 구매자 제안의 수량&apos;, &apos;2&apos;, apiVal(api, &apos;conv_offer&apos;, { b -&gt; b.offers.find { String.valueOf(it.offerId) == oN }?.quantity }), dbVal(snap, { offerRow(it, oN)?.QUANTITY }))
chk(&apos;가격 제안&apos;, &apos;새 흥정 구매자 제안의 개당 금액&apos;, &apos;9000&apos;, NA, dbVal(snap, { offerRow(it, oN)?.AMOUNT }))
chk(&apos;가격 제안&apos;, &apos;새 흥정 구매자 제안의 대화&apos;, getp(&apos;conv_offer&apos;), NA, dbVal(snap, { offerRow(it, oN)?.CONVERSATION_ID }))
// 예약
String rid = getp(&apos;rsv_id&apos;)
def rsvRow = { Map s -&gt; s.RESERVATION.find { String.valueOf(it.RESERVATION_ID) == rid } }
chk(&apos;예약&apos;, &apos;대상 상품의 예약 행 수&apos;, &apos;1&apos;, NA, dbVal(snap, { it.RESERVATION.size() }))
chk(&apos;예약&apos;, &apos;기존 예약 ID&apos;, rid, apiVal(api, &apos;conv_rsv&apos;, { it.reservation?.reservationId }), dbVal(snap, { rsvRow(it)?.RESERVATION_ID }))
chk(&apos;예약&apos;, &apos;기존 예약의 구매자&apos;, ids.rsv, NA, dbVal(snap, { rsvRow(it)?.BUYER_ID }))
chk(&apos;예약&apos;, &apos;기존 예약의 판매자&apos;, ids.seller, NA, dbVal(snap, { rsvRow(it)?.SELLER_ID }))
chk(&apos;예약&apos;, &apos;기존 예약의 수량&apos;, &apos;4&apos;, apiVal(api, &apos;conv_rsv&apos;, { it.reservation?.quantity }), dbVal(snap, { rsvRow(it)?.QUANTITY }))
chk(&apos;예약&apos;, &apos;기존 예약의 상태&apos;, &apos;ACTIVE&apos;, apiVal(api, &apos;conv_rsv&apos;, { it.reservation?.status }), dbVal(snap, { rsvRow(it)?.STATUS }))
chk(&apos;예약&apos;, &apos;기존 예약에 연결된 제안&apos;, oR, apiVal(api, &apos;conv_rsv&apos;, { it.reservation?.offerId }), dbVal(snap, { rsvRow(it)?.OFFER_ID }))
chk(&apos;예약&apos;, &apos;기존 예약에 연결된 대화&apos;, getp(&apos;conv_rsv&apos;), apiVal(api, &apos;conv_rsv&apos;, { it.reservation?.conversationId }), dbVal(snap, { rsvRow(it)?.CONVERSATION_ID }))
chk(&apos;예약&apos;, &apos;기존 예약의 종료 시각&apos;, &apos;null&apos;, apiVal(api, &apos;conv_rsv&apos;, { it.reservation?.endedAt }), dbVal(snap, { rsvRow(it)?.ENDED_AT }))
String dbExp = sv(dbVal(snap, { isoN(rsvRow(it)?.EXPIRES_AT) }))
chk(&apos;예약&apos;, &apos;기존 예약의 만료 시각(API와 DB)&apos;, dbExp, apiVal(api, &apos;conv_rsv&apos;, { isoN(it.reservation?.expiresAt) }), dbExp)
chk(&apos;예약&apos;, &apos;기존 예약이 DB 조회 시각에 유효&apos;, &apos;true&apos;, NA, dbVal(snap, { validAt(rsvRow(it), now) }))
chk(&apos;예약&apos;, &apos;유효 예약 수량 합계&apos;, &apos;4&apos;, NA, dbVal(snap, { s -&gt; s.RESERVATION.findAll { validAt(it, now) }.sum { it.QUANTITY as long } ?: 0 }))
// 주문
String oid = getp(&apos;order_id&apos;)
def ordRow = { Map s -&gt; s.PURCHASE_ORDER.find { String.valueOf(it.ORDER_ID) == oid } }
chk(&apos;주문&apos;, &apos;대상 상품의 주문 행 수&apos;, &apos;1&apos;, NA, dbVal(snap, { it.PURCHASE_ORDER.size() }))
chk(&apos;주문&apos;, &apos;기존 주문 ID&apos;, oid, apiVal(api, &apos;conv_order&apos;, { it.orders.size() == 1 ? it.orders[0].orderId : (&apos;주문 &apos; + it.orders.size() + &apos;건&apos;) }), dbVal(snap, { ordRow(it)?.ORDER_ID }))
chk(&apos;주문&apos;, &apos;기존 주문의 구매자&apos;, ids.order, NA, dbVal(snap, { ordRow(it)?.BUYER_ID }))
chk(&apos;주문&apos;, &apos;기존 주문의 판매자&apos;, ids.seller, NA, dbVal(snap, { ordRow(it)?.SELLER_ID }))
chk(&apos;주문&apos;, &apos;기존 주문의 수량&apos;, &apos;3&apos;, apiVal(api, &apos;order_existing&apos;, { it.quantity }), dbVal(snap, { ordRow(it)?.QUANTITY }))
chk(&apos;주문&apos;, &apos;기존 주문의 단가&apos;, &apos;10000&apos;, apiVal(api, &apos;order_existing&apos;, { it.unitPrice }), dbVal(snap, { ordRow(it)?.UNIT_PRICE }))
chk(&apos;주문&apos;, &apos;기존 주문의 결제 금액&apos;, &apos;30000&apos;, apiVal(api, &apos;order_existing&apos;, { it.paidAmount }), dbVal(snap, { ordRow(it)?.PAID_AMOUNT }))
chk(&apos;주문&apos;, &apos;기존 주문의 가격 출처&apos;, &apos;LISTED&apos;, apiVal(api, &apos;order_existing&apos;, { it.priceSource }), dbVal(snap, { ordRow(it)?.PRICE_SOURCE }))
chk(&apos;주문&apos;, &apos;기존 주문의 제안 ID&apos;, &apos;null&apos;, apiVal(api, &apos;order_existing&apos;, { it.offerId }), dbVal(snap, { ordRow(it)?.OFFER_ID }))
chk(&apos;주문&apos;, &apos;기존 주문의 거래 상태&apos;, &apos;IN_PROGRESS&apos;, apiVal(api, &apos;order_existing&apos;, { it.tradeStatus }), dbVal(snap, { ordRow(it)?.TRADE_STATUS }))
chk(&apos;주문&apos;, &apos;기존 주문의 발송 상태&apos;, &apos;WAITING_SHIPMENT&apos;, apiVal(api, &apos;order_existing&apos;, { it.shippingStatus }), dbVal(snap, { ordRow(it)?.SHIPPING_STATUS }))
String dbShip = sv(dbVal(snap, { isoN(ordRow(it)?.SHIP_DEADLINE_AT) }))
chk(&apos;주문&apos;, &apos;기존 주문의 발송 기한(API와 DB)&apos;, dbShip, apiVal(api, &apos;order_existing&apos;, { isoN(it.shipDeadlineAt) }), dbShip)
// 기한 여유: DB 시각 기준. 검증 요청 직전에는 이 값에서 지난 시간을 빼서 다시 확인한다.
long marginRsv = -1, marginShip = -1
try { marginRsv = Duration.between(Instant.parse(now), Instant.parse(rsvRow(snap).EXPIRES_AT as String)).toMillis() } catch (Exception ignore) { }
try { marginShip = Duration.between(Instant.parse(now), Instant.parse(ordRow(snap).SHIP_DEADLINE_AT as String)).toMillis() } catch (Exception ignore) { }
chk(&apos;기한&apos;, &apos;기존 예약 만료까지 5분 이상(DB 시각 기준 &apos; + marginRsv.intdiv(1000) + &apos;초)&apos;, &apos;true&apos;, NA, snap == null ? QF : (marginRsv &gt;= 300000))
chk(&apos;기한&apos;, &apos;기존 주문 발송 기한까지 5분 이상(DB 시각 기준 &apos; + marginShip.intdiv(60000) + &apos;분)&apos;, &apos;true&apos;, NA, snap == null ? QF : (marginShip &gt;= 300000))
// 구매 가능 수량 = 남은 수량 − 조회자 본인이 아닌 구매자의 유효 예약 수량
def availFor = { Map s, String viewer -&gt; (s.PRODUCT[0].REMAINING_QUANTITY as long) - ((s.RESERVATION.findAll { validAt(it, now) &amp;&amp; it.BUYER_ID != viewer }.sum { it.QUANTITY as long }) ?: 0) }
chk(&apos;구매 가능 수량&apos;, &apos;기존 예약 구매자가 보는 구매 가능 수량&apos;, &apos;7&apos;, apiVal(api, &apos;product_rsv&apos;, { it.availableQuantity }), dbVal(snap, { availFor(it, ids.rsv) }))
chk(&apos;구매 가능 수량&apos;, &apos;새 등록 가격 구매자가 보는 구매 가능 수량&apos;, &apos;3&apos;, apiVal(api, &apos;product_buy&apos;, { it.availableQuantity }), dbVal(snap, { availFor(it, ids.buy) }))
// 잔액과 잔액 변동. 지갑 행이 없으면 잔액 0으로 본다(서버도 지갑이 없으면 잔액 0으로 처리한다).
Map wantBal = [order: &apos;0&apos;, rsv: &apos;0&apos;, offer: &apos;0&apos;, buy: &apos;20000&apos;]
Map wantTx = [order: &apos;CHARGE 30000 잔액 30000 / PURCHASE -30000 잔액 0 주문 &apos; + oid, rsv: &apos;&apos;, offer: &apos;&apos;, buy: &apos;CHARGE 20000 잔액 20000&apos;]
[&apos;order&apos;, &apos;rsv&apos;, &apos;offer&apos;, &apos;buy&apos;].each { k -&gt;
    chk(&apos;잔액&apos;, ROLE_KO[k] + &apos;의 잔액&apos;, wantBal[k], apiVal(api, &apos;wallet_&apos; + k, { it.balance }), dbVal(snap, { s -&gt; (s.WALLET.find { it.MEMBER_ID == ids[k] }?.BALANCE) ?: 0 }))
    chk(&apos;잔액 변동&apos;, ROLE_KO[k] + &apos;의 잔액 변동 내역&apos;, wantTx[k], apiVal(api, &apos;tx_&apos; + k, { apiTxText(it) }), dbVal(snap, { s -&gt; txText(s.BALANCE_TRANSACTION.findAll { it.MEMBER_ID == ids[k] }) }))
}
writeCsv(&apos;요청전_확인결과.csv&apos;, [&apos;영역&apos;, &apos;항목&apos;, &apos;기대값&apos;, &apos;API 값&apos;, &apos;DB 값&apos;, &apos;결과&apos;], rows)
List bad = rows.findAll { it[5] != &apos;일치&apos; }
if (!bad.isEmpty()) {
    failRun(SampleResult, &apos;9&apos;, &apos;네 구매자의 거래·잔액과 상품을 조회하고 전체 DB 상태 대조&apos;, &apos;출발 상태와 다른 항목 &apos; + bad.size() + &apos;개: &apos; + bad.take(6).collect { it[0] + &apos; &apos; + it[1] + &apos;(&apos; + it[5] + &apos;, API &apos; + it[3] + &apos;, DB &apos; + it[4] + &apos;)&apos; }.join(&apos;; &apos;))
    return
}
// 요청 전 기준값: 기존 주문·예약·제안의 행 전체와 잔액·잔액 변동을 그대로 남긴다(합계만 남기지 않는다).
setp(&apos;base&apos;, snap)
saveText(&apos;요청전_기준값.json&apos;, JsonOutput.prettyPrint(JsonOutput.toJson([
    &apos;실행 ID&apos;: getp(&apos;run_log_id&apos;), &apos;회원&apos;: ids, &apos;상품 ID&apos;: pid,
    &apos;대화 ID&apos;: [&apos;order&apos;, &apos;rsv&apos;, &apos;offer&apos;, &apos;buy&apos;].collectEntries { [(it): getp(&apos;conv_&apos; + it)] },
    &apos;기존 예약 구매자의 제안 ID&apos;: oR, &apos;새 흥정 구매자의 제안 ID&apos;: oN, &apos;기존 주문 ID&apos;: oid, &apos;기존 예약 ID&apos;: rid,
    &apos;서버 시각 조회(API)&apos;: apiBody(api, &apos;clock&apos;), &apos;DB 조회 시각(UTC)&apos;: snap.db_now,
    &apos;기존 예약 만료까지(ms, DB 시각 기준)&apos;: marginRsv, &apos;기존 주문 발송 기한까지(ms, DB 시각 기준)&apos;: marginShip,
    &apos;DB 조회 결과&apos;: snap])))
setp(&apos;ready_local_ms&apos;, String.valueOf(localStart))
setp(&apos;margin_rsv_ms&apos;, String.valueOf(marginRsv))
setp(&apos;margin_ship_ms&apos;, String.valueOf(marginShip))
props.put(PFX + &apos;barrier&apos;, new CyclicBarrier(2))
setp(&apos;ready&apos;, getp(&apos;run_log_id&apos;))
stepOk(&apos;9&apos;, &apos;네 구매자의 거래·잔액과 상품을 조회하고 전체 DB 상태 대조&apos;, &apos;확인 항목 &apos; + rows.size() + &apos;개 모두 일치(요청전_확인결과.csv). 준비 완료 표시&apos;)
setp(&apos;stage&apos;, &apos;G8&apos;)
SampleResult.setResponseData(&apos;요청 전 확인 &apos; + rows.size() + &apos;개 항목 일치, 기존 예약 만료까지 &apos; + marginRsv.intdiv(1000) + &apos;초&apos;, &apos;UTF-8&apos;)

} catch (Throwable t) {
failRun(SampleResult, &apos;9&apos;, &apos;네 구매자의 거래·잔액과 상품을 조회하고 전체 DB 상태 대조&apos;, &apos;확인 스크립트 오류: &apos; + t)
}
</stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="검증 요청: 새 가격 제안 수락과 새 등록 가격 결제를 함께 보냄" enabled="true">
        <stringProp name="TestPlan.comments">요청을 함께 보냈다는 사실만으로 서버의 수량 판단과 저장이 겹쳤다고 보지 않고, 서버 로그로 따로 확인한다.</stringProp>
        <intProp name="ThreadGroup.num_threads">2</intProp>
        <intProp name="ThreadGroup.ramp_time">0</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="출발 조건 확인과 두 요청 출발 맞추기(최대 10초, 모이지 않으면 둘 다 보내지 않음)">
          <stringProp name="TestPlan.comments">스레드 1은 수락, 스레드 2는 결제를 맡는다. 준비 완료 표시, 로그인 토큰, 기존 예약 만료와 발송 기한까지 5분 이상 남았는지 확인한 뒤 두 요청이 모두 준비되면 함께 출발한다. 이 샘플러의 시간은 검증 요청의 응답 시간에 넣지 않는다.</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput
import java.time.Duration
import java.time.Instant
import java.time.ZoneId
import java.time.format.DateTimeFormatter
import java.util.concurrent.BrokenBarrierException
import java.util.concurrent.CyclicBarrier
import java.util.concurrent.TimeUnit
import java.util.concurrent.TimeoutException

// ---- 공통 도우미. JMeter 속성 이름은 모두 「exrb.」로 시작한다.
String PFX = &apos;exrb.&apos;
def getp = { String k -&gt; props.get(PFX + k) }
def setp = { String k, Object v -&gt; if (v == null) { props.remove(PFX + k) } else { props.put(PFX + k, v) } }
File outDir = new File(vars.get(&apos;outDir&apos;))
ZoneId KST = ZoneId.of(&apos;Asia/Seoul&apos;)
def fmtMs = { long ms -&gt; DateTimeFormatter.ofPattern(&quot;yyyy-MM-dd&apos;T&apos;HH:mm:ss.SSSXXX&quot;).withZone(KST).format(Instant.ofEpochMilli(ms)) }
def nowText = { -&gt; fmtMs(System.currentTimeMillis()) }
def cell = { Object v -&gt; String s = (v == null ? &apos;&apos; : String.valueOf(v)); (s.contains(&apos;,&apos;) || s.contains(&apos;&quot;&apos;) || s.contains(&apos;\n&apos;)) ? (&apos;&quot;&apos; + s.replace(&apos;&quot;&apos;, &apos;&quot;&quot;&apos;) + &apos;&quot;&apos;) : s }
def appendCsv = { String name, List header, List row -&gt;
    synchronized (props) {
        File f = new File(outDir, name)
        if (!f.exists()) { f.setText(&apos;﻿&apos; + header.collect { cell(it) }.join(&apos;,&apos;) + &apos;\n&apos;, &apos;UTF-8&apos;) }
        f.append(row.collect { cell(it) }.join(&apos;,&apos;) + &apos;\n&apos;, &apos;UTF-8&apos;)
    }
}
def writeCsv = { String name, List header, List rows -&gt;
    StringBuilder sb = new StringBuilder(&apos;﻿&apos; + header.collect { cell(it) }.join(&apos;,&apos;) + &apos;\n&apos;)
    rows.each { r -&gt; sb.append(r.collect { cell(it) }.join(&apos;,&apos;)).append(&apos;\n&apos;) }
    new File(outDir, name).setText(sb.toString(), &apos;UTF-8&apos;)
}
def saveText = { String name, String text -&gt; new File(outDir, name).setText(text == null ? &apos;&apos; : text, &apos;UTF-8&apos;) }
def parse = { String body -&gt; try { return new JsonSlurper().parseText(body) } catch (Exception e) { return null } }
List ROLE_KEYS = [&apos;seller&apos;, &apos;order&apos;, &apos;rsv&apos;, &apos;offer&apos;, &apos;buy&apos;]
Map ROLE_KO = [seller: &apos;판매자&apos;, order: &apos;기존 주문 구매자&apos;, rsv: &apos;기존 예약 구매자&apos;, offer: &apos;새 흥정 구매자&apos;, buy: &apos;새 등록 가격 구매자&apos;]
Map ROLE_FILE = [seller: &apos;판매자&apos;, order: &apos;기존주문구매자&apos;, rsv: &apos;기존예약구매자&apos;, offer: &apos;새흥정구매자&apos;, buy: &apos;새등록가격구매자&apos;]
List STEP_HEADER = [&apos;순서&apos;, &apos;행동&apos;, &apos;결과&apos;, &apos;확인한 내용&apos;, &apos;확인 시각(이 PC)&apos;]
def stepOk = { String no, String action, String detail -&gt; appendCsv(&apos;준비_단계별확인.csv&apos;, STEP_HEADER, [no, action, &apos;통과&apos;, detail, nowText()]) }
def writeSummary = { Map m -&gt;
    StringBuilder sb = new StringBuilder(&apos;﻿항목,값\n&apos;)
    m.each { k, v -&gt; sb.append(cell(k)).append(&apos;,&apos;).append(cell(v)).append(&apos;\n&apos;) }
    saveText(&apos;실행_요약.csv&apos;, sb.toString())
}
// 준비나 요청 전 확인이 실패하면 실패 내용을 남기고 실행 전체를 멈춘다. 뒤의 그룹(검증 요청 포함)은 실행되지 않는다.
def failRun = { def res, String no, String action, String detail -&gt;
    appendCsv(&apos;준비_단계별확인.csv&apos;, STEP_HEADER, [no, action, &apos;실패&apos;, detail, nowText()])
    setp(&apos;prep_failed&apos;, no + &apos;. &apos; + action + &apos;: &apos; + detail)
    writeSummary([&apos;시나리오&apos;: vars.get(&apos;scenario&apos;), &apos;실행 번호&apos;: vars.get(&apos;runId&apos;), &apos;실행 ID&apos;: (getp(&apos;run_log_id&apos;) ?: &apos;-&apos;),
                  &apos;준비 상태&apos;: &apos;실패(&apos; + no + &apos;. &apos; + action + &apos;)&apos;, &apos;준비 실패 내용&apos;: detail,
                  &apos;검증 요청 전송 건수&apos;: &apos;0&apos;, &apos;새 가격 제안 수락 응답 분류&apos;: &apos;보내지 않음&apos;, &apos;새 등록 가격 결제 응답 분류&apos;: &apos;보내지 않음&apos;,
                  &apos;저장 결과&apos;: &apos;확인하지 않음&apos;, &apos;판정&apos;: &apos;검증 미완료(준비 또는 요청 전 확인 실패로 검증 요청을 보내지 않음)&apos;])
    res.setSuccessful(false)
    res.setResponseMessage(no + &apos;. &apos; + action + &apos; 실패: &apos; + detail)
    res.setStopTest(true)
}
// 실행 시작 그룹의 실패: 서버로 요청을 보내기 전이므로 실행 폴더에 아무 파일도 쓰지 않고, 화면의 결과와 계획_결과.jtl에만 남긴 뒤 멈춘다.
// 같은 실행 번호로 다시 시작할 수 있다.
def failStart = { def res, String detail -&gt;
    setp(&apos;prep_failed&apos;, &apos;0. 실행 시작: &apos; + detail)
    res.setSuccessful(false)
    res.setResponseMessage(&apos;실행 시작 실패(서버 요청 0건, 실행 폴더에 쓴 파일 없음): &apos; + detail)
    res.setResponseData(&apos;실행 시작 실패(서버 요청 0건, 실행 폴더에 쓴 파일 없음): &apos; + detail, &apos;UTF-8&apos;)
    res.setStopTest(true)
}
// 그룹을 앞 단계가 끝난 뒤에만 실행한다. 앞 단계가 실패했거나 이 그룹이 이미 실행됐으면 아무 요청도 보내지 않고 멈춘다.
def requireStage = { def res, String expected, String groupName -&gt;
    String failed = getp(&apos;prep_failed&apos;)
    String stage = getp(&apos;stage&apos;)
    if (failed != null || stage != expected) {
        res.setSuccessful(false)
        res.setResponseMessage(groupName + &apos; 실행 안 함: &apos; + (failed != null ? (&apos;앞 단계 실패(&apos; + failed + &apos;)&apos;) : (&apos;앞 그룹이 끝난 상태가 아님(현재 &apos; + stage + &apos;, 필요 &apos; + expected + &apos;)&apos;)))
        res.setStopTest(true)
        return false
    }
    return true
}
def loadIds = { -&gt; ROLE_KEYS.each { k -&gt; vars.put(&apos;id_&apos; + k, (getp(&apos;id_&apos; + k) ?: &apos;NOT_FOUND&apos;) as String); vars.put(&apos;tok_&apos; + k, (getp(&apos;token_&apos; + k) ?: &apos;NOT_FOUND&apos;) as String) }
    [&apos;product_id&apos;, &apos;conv_order&apos;, &apos;conv_rsv&apos;, &apos;conv_offer&apos;, &apos;conv_buy&apos;, &apos;offer_rsv&apos;, &apos;offer_new&apos;, &apos;order_id&apos;, &apos;rsv_id&apos;, &apos;run_log_id&apos;, &apos;test_log_name&apos;].each { k -&gt; vars.put(k, (getp(k) ?: &apos;NOT_FOUND&apos;) as String) } }
try {

// 출발 조건을 확인하고, 두 요청이 모두 준비되면 함께 출발한다. 하나라도 조건을 통과하지 못하거나 10초 안에 모이지 않으면 둘 다 보내지 않는다.
String role = (ctx.getThreadNum() == 0) ? &apos;accept&apos; : &apos;buy&apos;
String roleKo = role == &apos;accept&apos; ? &apos;새 가격 제안 수락&apos; : &apos;새 등록 가격 결제&apos;
vars.put(&apos;req_role&apos;, role)
vars.put(&apos;go&apos;, &apos;false&apos;)
vars.put(&apos;send_accept&apos;, &apos;false&apos;)
vars.put(&apos;send_buy&apos;, &apos;false&apos;)
List&lt;String&gt; problems = []
String runLogId = getp(&apos;run_log_id&apos;)
if (getp(&apos;prep_failed&apos;) != null) problems &lt;&lt; (&apos;준비 실패: &apos; + getp(&apos;prep_failed&apos;))
if (getp(&apos;ready&apos;) == null || getp(&apos;ready&apos;) != runLogId) problems &lt;&lt; &apos;요청 전 확인의 준비 완료 표시 없음&apos;
if (getp(&apos;contention_started&apos;) != null) problems &lt;&lt; &apos;이 실행의 검증 요청을 이미 보냄(다시 보내지 않음)&apos;
String token = (role == &apos;accept&apos;) ? getp(&apos;token_seller&apos;) : getp(&apos;token_buy&apos;)
String target = (role == &apos;accept&apos;) ? getp(&apos;offer_new&apos;) : getp(&apos;product_id&apos;)
if (token == null) problems &lt;&lt; &apos;로그인 토큰 없음&apos;
if (target == null) problems &lt;&lt; ((role == &apos;accept&apos;) ? &apos;새 흥정 구매자의 제안 ID 없음&apos; : &apos;상품 ID 없음&apos;)
long now0 = System.currentTimeMillis()
long elapsed = now0 - ((getp(&apos;ready_local_ms&apos;) ?: String.valueOf(now0)) as long)
long rsvLeft = ((getp(&apos;margin_rsv_ms&apos;) ?: &apos;-1&apos;) as long) - elapsed
long shipLeft = ((getp(&apos;margin_ship_ms&apos;) ?: &apos;-1&apos;) as long) - elapsed
if (rsvLeft &lt; 300000) problems &lt;&lt; (&apos;기존 예약 만료까지 5분 미만(&apos; + rsvLeft.intdiv(1000) + &apos;초)&apos;)
if (shipLeft &lt; 300000) problems &lt;&lt; &apos;기존 주문 발송 기한까지 5분 미만&apos;
long loginAge = now0 - ((getp(&apos;login_ms&apos;) ?: &apos;0&apos;) as long)
if (loginAge &gt; 25L * 60 * 1000) problems &lt;&lt; &apos;로그인한 지 25분이 지남(서버가 로그인 정보를 30분만 보관)&apos;
vars.put(&apos;cur_token&apos;, token ?: &apos;NOT_FOUND&apos;)
vars.put(&apos;cur_target&apos;, target ?: &apos;NOT_FOUND&apos;)
vars.put(&apos;run_log_id&apos;, runLogId ?: &apos;-&apos;)
vars.put(&apos;test_log_name&apos;, (getp(&apos;test_log_name&apos;) ?: &apos;-&apos;) as String)
// 실행 파일 검토에서만 쓰는 값: 한 요청의 준비를 늦춘다(실제 실행에서는 0).
long delay = ((vars.get(&apos;reviewStartDelay_&apos; + role) ?: &apos;0&apos;) as long)
if (delay &gt; 0) Thread.sleep(delay)
if (getp(&apos;cancel_send&apos;) != null) problems &lt;&lt; &apos;상대 요청이 출발 조건을 통과하지 못함&apos;
def barrier = props.get(PFX + &apos;barrier&apos;)
if (barrier == null) problems &lt;&lt; &apos;출발 맞추기가 준비되지 않음&apos;
long waitStart = System.currentTimeMillis()
String outcome
if (!problems.isEmpty()) {
    setp(&apos;cancel_send&apos;, role)
    if (barrier != null) barrier.reset()
    outcome = &apos;보내지 않음&apos;
} else {
    try {
        barrier.await(10, TimeUnit.SECONDS)
        outcome = &apos;출발&apos;
        vars.put(&apos;go&apos;, &apos;true&apos;)
        vars.put(&apos;send_&apos; + role, &apos;true&apos;)
    } catch (TimeoutException e) {
        outcome = &apos;보내지 않음&apos;; problems &lt;&lt; &apos;10초 안에 두 요청이 모두 준비되지 않음&apos;; setp(&apos;cancel_send&apos;, role)
    } catch (BrokenBarrierException e) {
        outcome = &apos;보내지 않음&apos;; problems &lt;&lt; &apos;상대 요청이 준비되지 않아 함께 출발하지 못함&apos;; setp(&apos;cancel_send&apos;, role)
    }
}
long waitEnd = System.currentTimeMillis()
if (outcome == &apos;출발&apos;) { setp(&apos;contention_started&apos;, runLogId); props.remove(PFX + &apos;ready&apos;) }
// 출발 직후에는 값만 남기고, 시각 문자열 만들기와 파일 쓰기는 요청을 보낸 뒤 「출발 기록」에서 한다.
vars.putObject(&apos;go_record&apos;, [roleKo, problems.isEmpty() ? &apos;통과&apos; : &apos;실패&apos;, rsvLeft.intdiv(1000), shipLeft.intdiv(3600000), waitStart, waitEnd, outcome, problems.join(&apos;; &apos;)])
SampleResult.setResponseData(roleKo + &apos;: &apos; + outcome + (problems ? (&apos; (&apos; + problems.join(&apos;; &apos;) + &apos;)&apos;) : &apos;&apos;), &apos;UTF-8&apos;)
if (outcome != &apos;출발&apos;) SampleResult.setSuccessful(false)

} catch (Throwable t) {
vars.put(&apos;send_accept&apos;, &apos;false&apos;); vars.put(&apos;send_buy&apos;, &apos;false&apos;); setp(&apos;cancel_send&apos;, &apos;error&apos;)
def b2 = props.get(PFX + &apos;barrier&apos;); if (b2 != null) b2.reset()
vars.putObject(&apos;go_record&apos;, [vars.get(&apos;req_role&apos;), &apos;오류&apos;, &apos;&apos;, &apos;&apos;, null, null, &apos;보내지 않음&apos;, &apos;출발 확인 스크립트 오류: &apos; + t])
SampleResult.setSuccessful(false); SampleResult.setResponseMessage(&apos;출발 확인 스크립트 오류: &apos; + t)
}
</stringProp>
        </JSR223Sampler>
        <hashTree/>
        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="스레드 1: 출발했으면 새 가격 제안 수락">
          <stringProp name="TestPlan.comments">출발 맞추기를 통과한 수락 스레드만 true다. 출발 직후 스크립트를 실행하지 않도록 미리 정한 변수로 판단한다.</stringProp>
          <stringProp name="IfController.condition">${send_accept}</stringProp>
          <boolProp name="IfController.evaluateAll">false</boolProp>
          <boolProp name="IfController.useExpression">true</boolProp>
        </IfController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="검증 요청: 판매자의 새 가격 제안 수락(2개 예약)">
            <stringProp name="TestPlan.comments">판매자가 새 흥정 구매자의 응답 대기 제안 2개를 수락한다. 응답을 받지 못하거나 오류가 나도 다시 보내지 않는다.</stringProp>
            <intProp name="HTTPSampler.connect_timeout">5000</intProp>
            <intProp name="HTTPSampler.response_timeout">30000</intProp>
            <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
            <stringProp name="HTTPSampler.path">/ChatService/api/offers/${cur_target}/accept</stringProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
              <collectionProp name="Arguments.arguments"/>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="JSON 헤더, 판매자 로그인 쿠키, 서버 로그용 헤더">
              <collectionProp name="HeaderManager.headers">
                <elementProp name="" elementType="Header">
