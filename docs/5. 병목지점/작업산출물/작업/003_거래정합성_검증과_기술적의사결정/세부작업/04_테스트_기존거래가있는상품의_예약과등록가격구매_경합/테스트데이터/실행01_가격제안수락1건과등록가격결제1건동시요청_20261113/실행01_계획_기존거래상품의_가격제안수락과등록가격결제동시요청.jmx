        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="스레드 2: 출발했으면 새 등록 가격 결제">
          <stringProp name="TestPlan.comments">출발 맞추기를 통과한 결제 스레드만 true다.</stringProp>
          <stringProp name="IfController.condition">${send_buy}</stringProp>
          <boolProp name="IfController.evaluateAll">false</boolProp>
          <boolProp name="IfController.useExpression">true</boolProp>
        </IfController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="검증 요청: 새 등록 가격 구매자의 등록 가격 결제(2개)">
            <stringProp name="TestPlan.comments">새 등록 가격 구매자가 제안 없이 등록 가격으로 2개를 결제한다. 응답을 받지 못하거나 오류가 나도 다시 보내지 않는다.</stringProp>
            <intProp name="HTTPSampler.connect_timeout">5000</intProp>
            <intProp name="HTTPSampler.response_timeout">30000</intProp>
            <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
