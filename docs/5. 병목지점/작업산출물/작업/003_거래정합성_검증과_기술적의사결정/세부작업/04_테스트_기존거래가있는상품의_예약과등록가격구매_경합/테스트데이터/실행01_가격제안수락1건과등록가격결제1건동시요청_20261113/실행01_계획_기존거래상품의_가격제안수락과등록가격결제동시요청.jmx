          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="응답 보관과 저장(요청전_새흥정구매자_잔액변동응답.json)" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters">pre|tx_offer|요청전_새흥정구매자_잔액변동응답.json</stringProp>
