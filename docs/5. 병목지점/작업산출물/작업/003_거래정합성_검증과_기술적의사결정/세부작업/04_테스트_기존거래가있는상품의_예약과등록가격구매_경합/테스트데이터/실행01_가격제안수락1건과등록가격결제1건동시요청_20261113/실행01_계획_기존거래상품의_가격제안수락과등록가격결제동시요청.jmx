            respIssues &lt;&lt; (&apos;성공한 새 수락의 응답과 저장 결과 불일치(제안 &apos; + offerSt + &apos;, 예약 &apos; + rsvText(newRsv) + &apos;, 응답 예약 ID &apos; + respRid + &apos;)&apos;)
    } else if (clsA == &apos;수량부족&apos; || clsA == &apos;기타오류&apos;) {
        if (offerSt != &apos;PENDING&apos; || !newRsv.isEmpty()) respIssues &lt;&lt; (&apos;거절된 새 수락에 상태 변경이 남음(제안 &apos; + offerSt + &apos;, 예약 &apos; + rsvText(newRsv) + &apos;)&apos;)
    }
    if (clsB == &apos;성공&apos;) {
