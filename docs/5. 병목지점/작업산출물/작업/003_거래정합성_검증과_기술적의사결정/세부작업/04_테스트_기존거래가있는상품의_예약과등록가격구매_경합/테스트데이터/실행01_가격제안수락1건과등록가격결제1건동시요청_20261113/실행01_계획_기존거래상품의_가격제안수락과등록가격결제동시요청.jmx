// ---- 응답과 저장 결과의 일치
List respIssues = []
if (snap != null) {
    def offerSt = snap.PRICE_OFFER.find { String.valueOf(it.OFFER_ID) == oN }?.STATUS
    List newRsv = snap.RESERVATION.findAll { it.BUYER_ID == ids.offer }
    List newOrd = snap.PURCHASE_ORDER.findAll { it.BUYER_ID == ids.buy }
    def buyBal = (snap.WALLET.find { it.MEMBER_ID == ids.buy }?.BALANCE) ?: 0
    List buyPurch = snap.BALANCE_TRANSACTION.findAll { it.MEMBER_ID == ids.buy &amp;&amp; it.TYPE == &apos;PURCHASE&apos; }
    String savedA = (offerSt == &apos;ACCEPTED&apos; || !newRsv.isEmpty()) ? (&apos;저장됨(제안 &apos; + offerSt + &apos;, 예약 &apos; + newRsv.size() + &apos;건)&apos;) : &apos;저장 안 됨(제안 PENDING, 예약 없음)&apos;
    String savedB = (!newOrd.isEmpty() || buyPurch) ? (&apos;저장됨(주문 &apos; + newOrd.size() + &apos;건, 잔액 &apos; + buyBal + &apos;)&apos;) : (&apos;저장 안 됨(주문 없음, 잔액 &apos; + buyBal + &apos;)&apos;)
    setp(&apos;saved_accept&apos;, savedA); setp(&apos;saved_buy&apos;, savedB)
