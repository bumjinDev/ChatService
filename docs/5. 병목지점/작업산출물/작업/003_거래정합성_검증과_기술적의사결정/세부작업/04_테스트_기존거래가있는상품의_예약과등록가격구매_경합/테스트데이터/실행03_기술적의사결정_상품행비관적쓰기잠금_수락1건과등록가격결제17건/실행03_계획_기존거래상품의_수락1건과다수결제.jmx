        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="판매자 상품 등록(실행 설정의 상품 등록 수량, 개당 10,000원)" enabled="true">
          <stringProp name="TestPlan.comments">실행마다 새 상품을 등록한다. 상품명에 테스트 내용과 실행 번호를 넣는다.</stringProp>
          <stringProp name="HTTPSampler.connect_timeout">${connectTimeoutMs}</stringProp>
          <stringProp name="HTTPSampler.response_timeout">${responseTimeoutMs}</stringProp>
