if (cfg(&apos;quantityCondition&apos;) == &apos;수량부족&apos; &amp;&amp; A != null &amp;&amp; B != null) {
    long left = C - B - 2 * A
    if (pays.any { clsOf(it) == &apos;수량부족&apos; } &amp;&amp; left &gt;= 1) investigate &lt;&lt; (&apos;검증 요청이 끝난 뒤에도 새로 확보할 수 있는 수량이 &apos; + left + &apos;개 남았는데 거절된 결제가 있음&apos;)
    if (clsOf(&apos;accept&apos;) == &apos;수량부족&apos; &amp;&amp; left &gt;= 2) investigate &lt;&lt; (&apos;검증 요청이 끝난 뒤에도 새로 확보할 수 있는 수량이 &apos; + left + &apos;개 남았는데 수락이 거절됨&apos;)
}
if (sent &lt; order.size()) incomplete &lt;&lt; (&apos;출발한 요청 &apos; + sent + &apos;건(요청 합계 &apos; + order.size() + &apos;건)&apos;)
rows.findAll { it[5] == &apos;불일치&apos; &amp;&amp; it[6] == &apos;규칙&apos; }.each { violations &lt;&lt; (it[0] + &apos; &apos; + it[1] + &apos;(기대 &apos; + it[2] + &apos;, API &apos; + it[3] + &apos;, DB &apos; + it[4] + &apos;)&apos;) }
rows.findAll { it[5] == &apos;불일치&apos; &amp;&amp; it[6] == &apos;시간&apos; }.each { incomplete &lt;&lt; (&apos;시간 조건 이탈: &apos; + it[1]) }
rows.findAll { it[5] == &apos;불일치&apos; &amp;&amp; it[6] == &apos;기대&apos; }.each { investigate &lt;&lt; (&apos;기대 결과와 다름: &apos; + it[1] + &apos;(기대 &apos; + it[2] + &apos;, API &apos; + it[3] + &apos;, DB &apos; + it[4] + &apos;)&apos;) }
rows.findAll { it[5] == &apos;확인 못함&apos; }.each { incomplete &lt;&lt; (&apos;확인 못함: &apos; + it[0] + &apos; &apos; + it[1]) }
writeCsv(&apos;종료후_확인결과.csv&apos;, [&apos;영역&apos;, &apos;항목&apos;, &apos;기대값&apos;, &apos;API 값&apos;, &apos;DB 값&apos;, &apos;결과&apos;, &apos;항목 구분&apos;], rows)
String verdict
if (sent == 0) verdict = &apos;검증 미완료(검증 요청을 보내지 않음)&apos;
else if (!violations.isEmpty()) verdict = &apos;규칙 위반 확인&apos;
else if (!incomplete.isEmpty()) verdict = &apos;검증 미완료&apos;
else if (!investigate.isEmpty()) verdict = &apos;기대 결과와 다름(조사 필요)&apos;
else verdict = &apos;기대 결과와 일치(저장 상태 기준 규칙 준수). 요청의 처리가 겹쳤는지는 서버 로그로 따로 확인&apos;
// ---- 검증 요청별 결과
List reqRows = order.collect { k -&gt;
    Map g = (reqs[k]?.get(&apos;출발 기록&apos;) ?: [:]) as Map
    Map r = resOf(k)
    String stored = &apos;확인 못함&apos;
    if (snap != null) {
        if (k == &apos;accept&apos;) { List rs = snap.RESERVATION.findAll { it.BUYER_ID == ids.offer }; stored = offerRow(snap, oN)?.STATUS + &apos;, 예약 &apos; + rs.size() + &apos;건&apos; + (rs ? (&apos; &apos; + rs.collect { it.QUANTITY + &apos;개&apos; }.join(&apos; &apos;)) : &apos;&apos;) }
        else { List os = snap.PURCHASE_ORDER.findAll { it.BUYER_ID == ids[k] }; stored = &apos;주문 &apos; + os.size() + &apos;건&apos; + (os ? (&apos; &apos; + os.collect { it.ORDER_ID }.join(&apos; &apos;)) : &apos;&apos;) }
    }
    [k == &apos;accept&apos; ? &apos;새 가격 제안 수락&apos; : &apos;새 등록 가격 결제&apos;, roleKo(k), k == &apos;accept&apos; ? ids.seller : ids[k], g[&apos;출발 시점(초)&apos;] ?: (slots[slotOf[k] as int][0]), k == &apos;accept&apos; ? 2 : 1,
     reqIdOf(k), g[&apos;결과&apos;] ?: &apos;기록 없음&apos;, g[&apos;출발(ms)&apos;] ? fmtMs(g[&apos;출발(ms)&apos;] as long) : &apos;&apos;, r ? fmtMs(r[&apos;전송 시작(ms)&apos;] as long) : &apos;&apos;, r ? fmtMs(r[&apos;응답 수신 완료(ms)&apos;] as long) : &apos;&apos;,
     r?.get(&apos;걸린 시간(ms)&apos;), r?.get(&apos;연결 시간(ms)&apos;), r?.get(&apos;첫 바이트까지(ms)&apos;), r?.get(&apos;HTTP 응답&apos;) ?: &apos;&apos;, r?.get(&apos;오류 코드&apos;) ?: &apos;&apos;, clsOf(k), r?.get(&apos;분류 사유&apos;) ?: &apos;&apos;, stored]
}
writeCsv(&apos;검증요청_결과.csv&apos;, [&apos;요청&apos;, &apos;요청자&apos;, &apos;회원 ID&apos;, &apos;출발 시점(초)&apos;, &apos;요청 수량&apos;, &apos;서버 로그 요청 ID&apos;, &apos;출발 결과&apos;, &apos;출발(이 PC)&apos;, &apos;전송 시작(이 PC)&apos;, &apos;응답 수신 완료(이 PC)&apos;,
                             &apos;걸린 시간(ms)&apos;, &apos;연결 시간(ms)&apos;, &apos;첫 바이트까지(ms)&apos;, &apos;HTTP 응답&apos;, &apos;오류 코드&apos;, &apos;응답 분류&apos;, &apos;분류 사유&apos;, &apos;저장 결과(종료 후 DB)&apos;], reqRows)
// ---- 응답 시간 요약: 기능과 응답 분류마다 따로 센다. 실행 한 번의 표본이므로 백분위는 여러 실행을 모은 뒤 계산한다.
List timeRows = []
[[&apos;새 가격 제안 수락&apos;, [&apos;accept&apos;]], [&apos;새 등록 가격 결제&apos;, pays]].each { f -&gt;
    [&apos;성공&apos;, &apos;수량부족&apos;, &apos;기타오류&apos;, &apos;미확인&apos;].each { c3 -&gt;
        List ts2 = (f[1] as List).findAll { clsOf(it) == c3 &amp;&amp; resOf(it) != null }.collect { resOf(it)[&apos;걸린 시간(ms)&apos;] as long }.sort()
        if (ts2.isEmpty()) return
        def median = (ts2.size() % 2 == 1) ? ts2[ts2.size().intdiv(2)] : ((ts2[ts2.size().intdiv(2) - 1] + ts2[ts2.size().intdiv(2)]) / 2)
        timeRows &lt;&lt; [f[0], c3, ts2.size(), ts2.count { it &lt;= 1000 }, ts2.first(), median, ts2.last()]
    }
}
writeCsv(&apos;검증요청_응답시간요약.csv&apos;, [&apos;기능&apos;, &apos;응답 분류&apos;, &apos;건수&apos;, &apos;1초 이내 건수&apos;, &apos;가장 짧은 시간(ms)&apos;, &apos;중앙값(ms)&apos;, &apos;가장 긴 시간(ms)&apos;], timeRows)
// ---- 종료후확인.log: 공통 로그 형식(시각 - 테스트명 - 기능명 - 파일명 - 메소드명 | 실행ID 요청ID 단계 | 항목)
String testName = testLogNameOf([payCount: cfg(&apos;payCount&apos;)])
String jmx = org.apache.jmeter.services.FileServer.getFileServer().getScriptName()
def fmt6 = DateTimeFormatter.ofPattern(&quot;yyyy-MM-dd&apos;T&apos;HH:mm:ss.SSSSSSXXX&quot;)
def line = { String feature, String stage, String reqId, List items -&gt;
    StringBuilder sb = new StringBuilder(java.time.OffsetDateTime.now(KST).format(fmt6)).append(&apos; - &apos;).append(testName).append(&apos; - &apos;).append(feature).append(&apos; - &apos;)
        .append(jmx).append(&apos; - 결과 집계 | 실행ID=&apos;).append(vars.get(&apos;run_log_id&apos;)).append(&apos; 요청ID=&apos;).append(reqId).append(&apos; 단계=&apos;).append(stage).append(&apos; |&apos;)
    for (int i = 0; i + 1 &lt; items.size(); i += 2) sb.append(&apos; &apos;).append(items[i]).append(&apos;=&apos;).append(items[i + 1] == null ? &apos;-&apos; : items[i + 1])
    sb.toString()
}
List logLines = []
Map nr = snap?.RESERVATION?.find { it.BUYER_ID == ids.offer } as Map
logLines &lt;&lt; line(&apos;가격 제안 수락&apos;, &apos;요청별종료후확인&apos;, &apos;accept-new&apos;, [&apos;제안ID&apos;, oN, &apos;요청수량&apos;, 2, &apos;응답상태&apos;, resOf(&apos;accept&apos;)?.get(&apos;HTTP 응답&apos;) ?: clsOf(&apos;accept&apos;), &apos;오류코드&apos;, resOf(&apos;accept&apos;)?.get(&apos;오류 코드&apos;),
    &apos;응답구분&apos;, clsOf(&apos;accept&apos;), &apos;제안상태&apos;, offerRow(snap, oN)?.STATUS, &apos;예약ID&apos;, nr?.RESERVATION_ID, &apos;예약수량&apos;, nr?.QUANTITY, &apos;예약상태&apos;, nr?.STATUS])
pays.each { k -&gt;
    Map o2 = (snap == null) ? null : (snap.PURCHASE_ORDER.find { it.BUYER_ID == ids[k] } as Map)
    logLines &lt;&lt; line(&apos;결제&apos;, &apos;요청별종료후확인&apos;, reqIdOf(k), [&apos;구매자ID&apos;, ids[k], &apos;출발시점&apos;, (slots[slotOf[k] as int][0]) + &apos;초&apos;, &apos;요청수량&apos;, 1, &apos;응답상태&apos;, resOf(k)?.get(&apos;HTTP 응답&apos;) ?: clsOf(k),
        &apos;오류코드&apos;, resOf(k)?.get(&apos;오류 코드&apos;), &apos;응답구분&apos;, clsOf(k), &apos;주문ID&apos;, o2?.ORDER_ID, &apos;주문수량&apos;, o2?.QUANTITY, &apos;결제금액&apos;, o2?.PAID_AMOUNT, &apos;거래상태&apos;, o2?.TRADE_STATUS,
        &apos;잔액&apos;, snap == null ? null : ((snap.WALLET.find { it.MEMBER_ID == ids[k] }?.BALANCE) ?: 0)])
}
logLines &lt;&lt; line(&apos;가격 제안 수락과 결제&apos;, &apos;전체종료후확인&apos;, &apos;-&apos;, [&apos;수락성공&apos;, A, &apos;결제성공건수&apos;, B, &apos;유효예약건수&apos;, snap == null ? null : snap.RESERVATION.count { validAt(it, now) },
    &apos;유효예약합계&apos;, rsvQty, &apos;주문건수&apos;, snap?.PURCHASE_ORDER?.size(), &apos;주문수량합계&apos;, ordQty, &apos;남은수량&apos;, snap?.PRODUCT?.getAt(0)?.REMAINING_QUANTITY,
    &apos;상품상태&apos;, snap?.PRODUCT?.getAt(0)?.STATUS, &apos;결과확인기준위반&apos;, violations ? violations.join(&apos;; &apos;) : &apos;없음&apos;, &apos;미확인&apos;, incomplete ? incomplete.join(&apos;; &apos;) : &apos;없음&apos;,
    &apos;조사할사항&apos;, investigate ? investigate.join(&apos;; &apos;) : &apos;없음&apos;, &apos;판정&apos;, verdict])
saveText(&apos;종료후확인.log&apos;, logLines.join(&apos;\n&apos;) + &apos;\n&apos;)
Map cnt = order.groupBy { clsOf(it) }.collectEntries { kk, v -&gt; [(kk): v.size()] }
writeSummary([&apos;실행 번호&apos;: cfg(&apos;runNo&apos;), &apos;실행 ID&apos;: vars.get(&apos;run_log_id&apos;), &apos;실행 폴더&apos;: outDir().getName(),
              &apos;조건&apos;: cfg(&apos;quantityCondition&apos;) + &apos;, 상품 등록 수량 &apos; + S + &apos;개, 요청 합계 &apos; + order.size() + &apos;건, &apos; + (cfg(&apos;startMode&apos;) == &apos;모두함께&apos; ? &apos;모두 함께 출발&apos; : (&apos;입력시간분산 &apos; + cfg(&apos;slots&apos;))),
              &apos;대상 버전&apos;: cfg(&apos;targetVersion&apos;) ?: &apos;(적지 않음)&apos;, &apos;기술 적용 상태&apos;: cfg(&apos;techApplied&apos;) ?: &apos;(적지 않음)&apos;, &apos;반복 조건&apos;: cfg(&apos;repeatNote&apos;) ?: &apos;(적지 않음)&apos;,
              &apos;준비 상태&apos;: (base != null &amp;&amp; (base[&apos;출발 상태와 다른 항목 수&apos;] as int) == 0) ? (&apos;통과(요청 전 확인 일치, &apos; + prePrefix + &apos;_확인결과.csv)&apos;) : (&apos;요청 전 확인 일치하지 않음 또는 파일 없음(&apos; + prePrefix + &apos;_확인결과.csv)&apos;),
              &apos;종료 후 확인 파일&apos;: postPrefix + &apos;_API응답.json, &apos; + postPrefix + &apos;_DB조회.json&apos;,
              &apos;검증 요청 전송 건수&apos;: String.valueOf(sent),
              &apos;새 가격 제안 수락 응답 분류&apos;: clsOf(&apos;accept&apos;) + (resOf(&apos;accept&apos;) ? (&apos; (HTTP &apos; + resOf(&apos;accept&apos;)[&apos;HTTP 응답&apos;] + &apos;, &apos; + resOf(&apos;accept&apos;)[&apos;분류 사유&apos;] + &apos;)&apos;) : &apos;&apos;),
              &apos;새 등록 가격 결제 응답 분류&apos;: pays.groupBy { clsOf(it) }.collect { kk, v -&gt; kk + &apos; &apos; + v.size() + &apos;건&apos; }.join(&apos;, &apos;),
              &apos;수락 성공 여부와 결제 성공 건수&apos;: abText,
              &apos;규칙 위반&apos;: violations ? violations.join(&apos;; &apos;) : &apos;없음&apos;, &apos;검증 미완료 사유&apos;: incomplete ? incomplete.join(&apos;; &apos;) : &apos;없음&apos;,
              &apos;조사할 사항&apos;: investigate ? investigate.join(&apos;; &apos;) : &apos;없음&apos;,
              &apos;경합 확인&apos;: &apos;서버 로그(판단값과 커밋 순서)로 따로 확인. 이 파일은 전송 시각만으로 겹침을 판단하지 않음&apos;, &apos;판정&apos;: verdict])
flushSampleLog()
SampleResult.setResponseData(verdict + &apos; / &apos; + abText + &apos; / 위반 &apos; + violations.size() + &apos;건 / 미확인 &apos; + incomplete.size() + &apos;건 / 조사 &apos; + investigate.size() + &apos;건&apos;, &apos;UTF-8&apos;)
if (!violations.isEmpty() || !incomplete.isEmpty()) SampleResult.setSuccessful(false)

} catch (Throwable t) {
writeSummary([&apos;실행 번호&apos;: cfg(&apos;runNo&apos;), &apos;실행 ID&apos;: vars.get(&apos;run_log_id&apos;), &apos;판정&apos;: &apos;집계 스크립트 오류로 판정하지 못함: &apos; + t])
SampleResult.setSuccessful(false); SampleResult.setResponseMessage(&apos;집계 스크립트 오류: &apos; + t)
}
