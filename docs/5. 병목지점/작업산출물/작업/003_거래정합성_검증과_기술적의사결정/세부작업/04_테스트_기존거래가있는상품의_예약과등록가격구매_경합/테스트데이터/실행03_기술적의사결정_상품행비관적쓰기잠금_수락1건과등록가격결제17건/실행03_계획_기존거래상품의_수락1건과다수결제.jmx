        <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="기존 주문 읽기(실행03_기존주문.csv)" enabled="true">
          <stringProp name="TestPlan.comments">기존 주문 그룹이 쓴 한 줄을 읽는다: order_id.</stringProp>
