      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="준비: 상품 등록과 구매자마다 대화 시작(2·3단계)" enabled="true">
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">0</intProp>
