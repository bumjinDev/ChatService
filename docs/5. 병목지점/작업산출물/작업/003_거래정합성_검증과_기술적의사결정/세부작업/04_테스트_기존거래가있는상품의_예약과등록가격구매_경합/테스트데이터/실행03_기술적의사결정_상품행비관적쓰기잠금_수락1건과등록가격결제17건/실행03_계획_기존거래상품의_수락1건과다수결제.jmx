          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="응답 확인(6. 기존 예약 구매자가 개당 9,000원으로 4개 제안)" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters">6|기존 예약 구매자가 개당 9,000원으로 4개 제안|201|준비_기존예약구매자_가격제안응답.json|status=PENDING;quantity=4;amount=9000;reservation=null|offerId=offer_rsv</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput
import java.time.Duration
import java.time.Instant
import java.time.LocalDate
import java.time.LocalDateTime
import java.time.ZoneId
import java.time.format.DateTimeFormatter
import java.util.concurrent.BrokenBarrierException
import java.util.concurrent.ConcurrentHashMap
import java.util.concurrent.ConcurrentLinkedQueue
import java.util.concurrent.CyclicBarrier
import java.util.concurrent.TimeUnit
import java.util.concurrent.TimeoutException
import java.util.concurrent.atomic.AtomicInteger

// ---- 공통 도우미. JMeter 속성 이름은 모두 「mpay.」로 시작한다.
String PFX = &apos;mpay.&apos;
def getp = { String k -&gt; props.get(PFX + k) }
def setp = { String k, Object v -&gt; if (v == null) { props.remove(PFX + k) } else { props.put(PFX + k, v) } }
ZoneId KST = ZoneId.of(&apos;Asia/Seoul&apos;)
def fmtMs = { long ms -&gt; DateTimeFormatter.ofPattern(&quot;yyyy-MM-dd&apos;T&apos;HH:mm:ss.SSSXXX&quot;).withZone(KST).format(Instant.ofEpochMilli(ms)) }
def nowText = { -&gt; fmtMs(System.currentTimeMillis()) }
// 결과 폴더: 실행 시작 그룹이 만들고 실행NN_실행정보.csv의 result_dir 열에 적는다. 다른 그룹은 CSV Data Set Config가 이 값을 변수로 넣는다.
def outDir = { -&gt; String d = vars.get(&apos;result_dir&apos;); if (!d || d == &apos;&lt;EOF&gt;&apos;) { throw new IllegalStateException(&apos;결과 폴더 변수(result_dir)가 없음. 실행NN_실행정보.csv를 읽는 CSV Data Set Config 확인&apos;) }; new File(d) }
// 테스트데이터의 실행 폴더: 계획 파일이 있는 폴더
def dataDir = { -&gt; new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir()) }
def cell = { Object v -&gt; String s = (v == null ? &apos;&apos; : String.valueOf(v)); (s.contains(&apos;,&apos;) || s.contains(&apos;&quot;&apos;) || s.contains(&apos;\n&apos;) || s.contains(&apos;\r&apos;)) ? (&apos;&quot;&apos; + s.replace(&apos;&quot;&apos;, &apos;&quot;&quot;&apos;) + &apos;&quot;&apos;) : s }
String BOM = &apos;﻿&apos;
def appendCsv = { String name, List header, List row -&gt;
    synchronized (props) {
        File f = new File(outDir(), name)
        if (!f.exists()) { f.setText(BOM + header.collect { cell(it) }.join(&apos;,&apos;) + &apos;\n&apos;, &apos;UTF-8&apos;) }
        f.append(row.collect { cell(it) }.join(&apos;,&apos;) + &apos;\n&apos;, &apos;UTF-8&apos;)
    }
}
def writeCsv = { String name, List header, List rows -&gt;
    StringBuilder sb = new StringBuilder(BOM + header.collect { cell(it) }.join(&apos;,&apos;) + &apos;\n&apos;)
    rows.each { r -&gt; sb.append(r.collect { cell(it) }.join(&apos;,&apos;)).append(&apos;\n&apos;) }
    new File(outDir(), name).setText(sb.toString(), &apos;UTF-8&apos;)
}
def saveText = { String name, String text -&gt; new File(outDir(), name).setText(text == null ? &apos;&apos; : text, &apos;UTF-8&apos;) }
def saveJson = { String name, Object obj -&gt; saveText(name, JsonOutput.prettyPrint(JsonOutput.toJson(obj))) }
def readJson = { String name -&gt; File f = new File(outDir(), name); f.exists() ? new JsonSlurper().parse(f, &apos;UTF-8&apos;) : null }
def parse = { String body -&gt; try { return new JsonSlurper().parseText(body) } catch (Exception e) { return null } }
// 실행 설정: 계획 전체의 CSV Data Set Config가 실행NN_실행설정.csv에서 넣은 변수를 아래 실행 설정 확인이 한 번 확인해 둔 값
def cfg = { String k -&gt; Map m = vars.getObject(&apos;mpay_cfg&apos;) as Map; if (m == null) { throw new IllegalStateException(&apos;실행 설정 오류: &apos; + (vars.get(&apos;mpay_cfg_error&apos;) ?: &apos;실행 설정 변수가 없음&apos;)) }; m.get(k) }
def cfgLong = { String k -&gt; (cfg(k) as String) as long }
// 역할: seller(판매자), order(기존 주문 구매자), rsv(기존 예약 구매자), offer(새 흥정 구매자), pay01~(새 등록 가격 구매자)
def payKeys = { -&gt; int k = ((cfg(&apos;payCount&apos;) ?: 0) as int); k &gt; 0 ? (1..k).collect { &apos;pay&apos; + String.format(&apos;%02d&apos;, it) } : [] }
def buyerKeys = { -&gt; [&apos;order&apos;, &apos;rsv&apos;, &apos;offer&apos;] + payKeys() }
def allKeys = { -&gt; [&apos;seller&apos;] + buyerKeys() }
Map ROLE_FIXED = [seller: &apos;판매자&apos;, order: &apos;기존 주문 구매자&apos;, rsv: &apos;기존 예약 구매자&apos;, offer: &apos;새 흥정 구매자&apos;]
Map FILE_FIXED = [seller: &apos;판매자&apos;, order: &apos;기존주문구매자&apos;, rsv: &apos;기존예약구매자&apos;, offer: &apos;새흥정구매자&apos;]
def roleKo = { String k -&gt; k == &apos;accept&apos; ? &apos;판매자(새 가격 제안 수락)&apos; : (k.startsWith(&apos;pay&apos;) ? (&apos;새 등록 가격 구매자 &apos; + k.substring(3)) : ROLE_FIXED[k]) }
def roleFile = { String k -&gt; k.startsWith(&apos;pay&apos;) ? (&apos;새등록가격구매자&apos; + k.substring(3)) : FILE_FIXED[k] }
def reqIdOf = { String k -&gt; k == &apos;accept&apos; ? &apos;accept-new&apos; : (&apos;pay-&apos; + k.substring(3)) }
def mid = { String k -&gt; (cfg(&apos;members&apos;) as Map)?.get(k) }
// 앞 그룹에서 넘겨받은 구매자별 대화 ID(CSV Data Set Config가 넣은 conv_order, conv_rsv, … 변수)
def convMap = { -&gt; buyerKeys().collectEntries { k -&gt; [(k): vars.get(&apos;conv_&apos; + k)] } }
List STEP_HEADER = [&apos;순서&apos;, &apos;행동&apos;, &apos;결과&apos;, &apos;확인한 내용&apos;, &apos;확인 시각(이 PC)&apos;]
def stepOk = { String no, String action, String detail -&gt; appendCsv(&apos;준비_단계별확인.csv&apos;, STEP_HEADER, [no, action, &apos;통과&apos;, detail, nowText()]) }
def stepNote = { String no, String action, String detail -&gt; appendCsv(&apos;준비_단계별확인.csv&apos;, STEP_HEADER, [no, action, &apos;기록&apos;, detail, nowText()]) }
def writeSummary = { Map m -&gt;
    StringBuilder sb = new StringBuilder(BOM + &apos;항목,값\n&apos;)
    m.each { k, v -&gt; sb.append(cell(k)).append(&apos;,&apos;).append(cell(v)).append(&apos;\n&apos;) }
    saveText(&apos;실행_요약.csv&apos;, sb.toString())
}
List SAMPLE_HEADER = [&apos;시작 시각(이 PC)&apos;, &apos;걸린 시간(ms)&apos;, &apos;이름&apos;, &apos;응답 코드&apos;, &apos;응답 메시지&apos;, &apos;스레드&apos;, &apos;성공&apos;, &apos;받은 바이트&apos;, &apos;보낸 바이트&apos;, &apos;첫 바이트까지(ms)&apos;, &apos;연결 시간(ms)&apos;, &apos;URL&apos;]
// 요청 기록(계획_결과.csv). 결과 기록 처리기가 모아 둔 기록을 실행 폴더에 쓴다. 실행 폴더가 정해지기 전에는 모아 두기만 한다.
def flushSampleLog = { -&gt;
    if (!vars.get(&apos;result_dir&apos;) || vars.get(&apos;result_dir&apos;) == &apos;&lt;EOF&gt;&apos;) return
    def q = props.get(PFX + &apos;samplelog&apos;)
    if (q == null) return
    List lines = []
    def r
    while ((r = q.poll()) != null) lines &lt;&lt; r
    if (lines.isEmpty()) return
    synchronized (props) {
        File f = new File(outDir(), &apos;계획_결과.csv&apos;)
        if (!f.exists()) f.setText(BOM + SAMPLE_HEADER.join(&apos;,&apos;) + &apos;\n&apos;, &apos;UTF-8&apos;)
        StringBuilder sb = new StringBuilder()
        lines.each { x -&gt; sb.append(([fmtMs(x[0] as long)] + x.drop(1)).collect { cell(it) }.join(&apos;,&apos;)).append(&apos;\n&apos;) }
        f.append(sb.toString(), &apos;UTF-8&apos;)
    }
}
// 그룹 안의 요청이 실패하면 실패 내용을 준비_단계별확인.csv에 남기고 실행을 멈춘다. 이 그룹이 다음 그룹에 넘길 CSV는 쓰지 않는다.
def failRun = { def res, String no, String action, String detail -&gt;
    appendCsv(&apos;준비_단계별확인.csv&apos;, STEP_HEADER, [no, action, &apos;실패&apos;, detail, nowText()])
    vars.put(&apos;group_failed&apos;, no + &apos;. &apos; + action + &apos;: &apos; + detail)
    res.setSuccessful(false)
    res.setResponseMessage(no + &apos;. &apos; + action + &apos; 실패: &apos; + detail)
    res.setStopTest(true)
}
// 실행 시작 그룹의 실패: 결과 폴더에 아무 파일도 쓰지 않고, 화면의 결과에만 남긴 뒤 멈춘다.
def failStart = { def res, String detail -&gt;
    vars.put(&apos;group_failed&apos;, detail)
    res.setSuccessful(false)
    res.setResponseMessage(&apos;시작하지 않음(서버 요청 0건, 결과 폴더에 쓴 파일 없음): &apos; + detail)
    res.setResponseData(&apos;시작하지 않음(서버 요청 0건, 결과 폴더에 쓴 파일 없음): &apos; + detail, &apos;UTF-8&apos;)
    res.setStopTest(true)
}
// 그룹에 필요한 실행 설정이나 CSV가 없을 때: 요청을 보내지 않고 멈춘다.
def stopGroup = { def res, String groupName, String why -&gt;
    vars.put(&apos;group_failed&apos;, why)
    res.setSuccessful(false)
    res.setResponseMessage(groupName + &apos; 실행 안 함: &apos; + why)
    res.setResponseData(groupName + &apos; 실행 안 함: &apos; + why, &apos;UTF-8&apos;)
    res.setStopTest(true)
}
// 다음 그룹에 넘기는 CSV. 테스트데이터의 실행 폴더에 실행NN_이름.csv로 쓴다(회원 파일, 회원 가입 결과 파일과 같은 곳). 다음 그룹은 CSV Data Set Config로 읽는다.
def handoffFile = { String name -&gt; new File(dataDir(), &apos;실행&apos; + cfg(&apos;runNo&apos;) + &apos;_&apos; + name + &apos;.csv&apos;) }
def writeHandoff = { String name, List header, List rows -&gt;
    StringBuilder sb = new StringBuilder(BOM + header.collect { cell(it) }.join(&apos;,&apos;) + &apos;\n&apos;)
    rows.each { r -&gt; sb.append(r.collect { cell(it) }.join(&apos;,&apos;)).append(&apos;\n&apos;) }
    handoffFile(name).setText(sb.toString(), &apos;UTF-8&apos;)
}
// 응답 본문 모음: 여러 구매자의 응답을 파일 하나에 모은다.
def collectPut = { String file, String key, Object body -&gt;
    synchronized (props) {
        Map c = getp(&apos;collect&apos;) as Map
        if (c == null) { c = new LinkedHashMap(); setp(&apos;collect&apos;, c) }
        Map m = c[file] as Map
        if (m == null) { m = new LinkedHashMap(); c[file] = m }
        m[key] = body
    }
}
def collectFlush = { -&gt;
    Map c = getp(&apos;collect&apos;) as Map
    if (c == null) return
    c.each { file, m -&gt; saveJson(file as String, m) }
    setp(&apos;collect&apos;, null)
}

// ---- 실행 설정 확인. 계획 전체에 둔 CSV Data Set Config 「실행 설정 읽기」가 실행NN_실행설정.csv의 둘째 줄을 첫 줄의 항목 이름으로 변수에 넣는다.
List SETTING_KEYS = [&apos;totalRequests&apos;, &apos;quantityCondition&apos;, &apos;productQuantity&apos;, &apos;startMode&apos;, &apos;slots&apos;, &apos;targetVersion&apos;, &apos;techApplied&apos;, &apos;repeatNote&apos;,
                     &apos;serverProtocol&apos;, &apos;serverHost&apos;, &apos;serverPort&apos;, &apos;contextPath&apos;, &apos;dbMode&apos;, &apos;dbUrl&apos;, &apos;dbUser&apos;, &apos;ojdbcJar&apos;,
                     &apos;connectTimeoutMs&apos;, &apos;responseTimeoutMs&apos;, &apos;gatherTimeoutMs&apos;, &apos;deadlineMarginMin&apos;, &apos;loginMaxAgeMin&apos;, &apos;memberPrefix&apos;]
def loadSettings = { File planDir, Map raw -&gt;
    // 계획 파일은 테스트데이터의 실행 폴더(실행NN_…) 안에 두고, 실행 번호는 그 폴더 이름에서 읽는다.
    def fm = (planDir.getName() =~ /^실행(\d{2})_.+$/)
    if (!fm.matches() || fm.group(1) == &apos;00&apos;) return [error: &apos;계획 파일이 테스트데이터의 실행 폴더(실행NN_…) 안에 있지 않음(&apos; + planDir.getName() + &apos;)&apos;]
    String folderRunNo = fm.group(1)
    Map c = [:]
    raw.each { k, v -&gt; c[k] = (v == null || v == &apos;&lt;EOF&gt;&apos;) ? &apos;&apos; : String.valueOf(v).trim() }
    List&lt;String&gt; errs = []
    c.runNo = folderRunNo
    def need = { String k -&gt; if (!c[k]) errs &lt;&lt; (k + &apos; 값이 비어 있음&apos;) }
    [&apos;totalRequests&apos;, &apos;quantityCondition&apos;, &apos;productQuantity&apos;, &apos;startMode&apos;, &apos;serverProtocol&apos;, &apos;serverHost&apos;, &apos;serverPort&apos;,
     &apos;connectTimeoutMs&apos;, &apos;responseTimeoutMs&apos;, &apos;gatherTimeoutMs&apos;, &apos;deadlineMarginMin&apos;, &apos;loginMaxAgeMin&apos;, &apos;memberPrefix&apos;, &apos;dbMode&apos;].each { need(it) }
    if (c.dbMode != &apos;review&apos;) [&apos;dbUrl&apos;, &apos;dbUser&apos;, &apos;ojdbcJar&apos;].each { need(it) }
    if (!errs.isEmpty()) return [error: errs.join(&apos;; &apos;)]
    [&apos;totalRequests&apos;, &apos;productQuantity&apos;, &apos;connectTimeoutMs&apos;, &apos;responseTimeoutMs&apos;, &apos;gatherTimeoutMs&apos;, &apos;deadlineMarginMin&apos;, &apos;loginMaxAgeMin&apos;, &apos;serverPort&apos;].each {
        if (!(c[it] ==~ /\d+/)) errs &lt;&lt; (it + &apos;는 0 이상의 정수&apos;) }
    if (!(c.quantityCondition in [&apos;수량충분&apos;, &apos;수량부족&apos;])) errs &lt;&lt; &apos;quantityCondition은 수량충분 또는 수량부족&apos;
    if (!(c.startMode in [&apos;입력시간분산&apos;, &apos;모두함께&apos;])) errs &lt;&lt; &apos;startMode는 입력시간분산 또는 모두함께&apos;
    if (!(c.serverProtocol in [&apos;http&apos;, &apos;https&apos;])) errs &lt;&lt; &apos;serverProtocol은 http 또는 https&apos;
    if (!(c.dbMode in [&apos;oracle&apos;, &apos;review&apos;])) errs &lt;&lt; &apos;dbMode는 oracle(실제 실행) 또는 review(실행 파일 검토용 대역 서버)&apos;
    if (!(c.memberPrefix ==~ /[a-z]{1,8}/)) errs &lt;&lt; &apos;memberPrefix는 영문 소문자 1~8자&apos;
    if (c.contextPath &amp;&amp; !(c.contextPath ==~ /\/[A-Za-z0-9_\-\/]*[A-Za-z0-9_\-]/)) errs &lt;&lt; &apos;contextPath는 /로 시작하고 /로 끝나지 않음(예: /ChatService)&apos;
    if (!errs.isEmpty()) return [error: errs.join(&apos;; &apos;)]
    int total = c.totalRequests as int
    int k = total - 1
    long s = c.productQuantity as long
    if (total &lt; 2) errs &lt;&lt; &apos;totalRequests는 2 이상(새 수락 1건과 새 결제 1건 이상)&apos;
    if (total &gt; 40) errs &lt;&lt; &apos;totalRequests는 40 이하(이 계획의 출발 맞추기와 결과 파일을 확인한 범위)&apos;
    long cap = s - 7
    if (cap &lt; 2) errs &lt;&lt; &apos;상품 등록 수량은 9개 이상(기존 주문 3개와 기존 예약 4개를 뺀 뒤 새 흥정 구매자가 2개를 제안할 수 있어야 함)&apos;
    if (c.quantityCondition == &apos;수량충분&apos; &amp;&amp; cap &lt; k + 2) errs &lt;&lt; (&apos;수량충분이면 상품 등록 수량은 &apos; + (k + 9) + &apos;개 이상(새 요청이 확보하려는 &apos; + (k + 2) + &apos;개와 기존 거래 7개)&apos;)
    if (c.quantityCondition == &apos;수량부족&apos; &amp;&amp; cap &gt;= k + 2) errs &lt;&lt; (&apos;수량부족이면 상품 등록 수량은 &apos; + (k + 8) + &apos;개 이하&apos;)
    // 실행 폴더 이름에 적은 결제 건수와 실행 설정이 같아야 한다. 수량 조건과 출발 방식은 폴더 이름에 없으므로 실행 설정의 값만 쓴다.
    String wantPart = &apos;수락1건과등록가격결제&apos; + k + &apos;건&apos;
    if (!planDir.getName().contains(wantPart)) errs &lt;&lt; (&apos;실행 폴더 이름의 요청 수가 실행 설정(새 등록 가격 결제 &apos; + k + &apos;건)과 다름(&apos; + planDir.getName() + &apos;)&apos;)
    List slots = []
    if (c.startMode == &apos;모두함께&apos;) {
        slots = [[0, k, true]]
    } else {
        String spec = c.slots ?: &apos;&apos;
        if (!spec) errs &lt;&lt; &apos;입력시간분산이면 slots 값이 필요함(예: 30:2,60:4,90:6+수락,120:3,180:2)&apos;
        spec.split(&apos;,&apos;).findAll { it.trim() }.each { String part -&gt;
            def m = (part.trim() =~ /^(\d+):(\d+)(\+수락)?$/)
            if (!m.matches()) { errs &lt;&lt; (&apos;slots 항목 형식이 맞지 않음: &apos; + part.trim()); return }
            slots &lt;&lt; [m.group(1) as int, m.group(2) as int, m.group(3) != null]
        }
        if (errs.isEmpty()) {
            if ((slots.sum { it[1] } ?: 0) != k) errs &lt;&lt; (&apos;slots의 결제 건수 합계 &apos; + slots.sum { it[1] } + &apos;가 새 결제 요청 수 &apos; + k + &apos;와 다름&apos;)
            if (slots.count { it[2] } != 1) errs &lt;&lt; &apos;slots에서 수락을 넣는 출발 시점은 하나여야 함&apos;
            if (slots.collect { it[0] }.toSet().size() != slots.size()) errs &lt;&lt; &apos;slots의 출발 시점이 겹침&apos;
            if (slots.any { (it[1] + (it[2] ? 1 : 0)) &lt; 1 }) errs &lt;&lt; &apos;요청이 하나도 없는 출발 시점이 있음&apos;
            slots = slots.sort { it[0] }
        }
    }
    if (!errs.isEmpty()) return [error: errs.join(&apos;; &apos;)]
    c.slotList = slots
    c.payCount = k
    // 회원 ID: 앞부분 + 실행 번호 + 역할(판매자 sl, 기존 주문 구매자 od, 기존 예약 구매자 rv, 새 흥정 구매자 of, 새 등록 가격 구매자 p01~)
    String pre = c.memberPrefix + c.runNo
    Map members = [seller: pre + &apos;sl&apos;, order: pre + &apos;od&apos;, rsv: pre + &apos;rv&apos;, offer: pre + &apos;of&apos;]
    for (int i = 1; i &lt;= k; i++) members[&apos;pay&apos; + String.format(&apos;%02d&apos;, i)] = pre + &apos;p&apos; + String.format(&apos;%02d&apos;, i)
    c.members = members
    return [cfg: c]
}
def assignSlots = { List slots -&gt;
    Map m = [:]
    int n = 1
    slots.eachWithIndex { sl, i -&gt;
        int cnt = sl[1] as int
        for (int x = 0; x &lt; cnt; x++) { m[&apos;pay&apos; + String.format(&apos;%02d&apos;, n)] = i; n++ }
        if (sl[2]) m[&apos;accept&apos;] = i
    }
    return m
}
// 서버 로그에 남는 테스트 이름
def testLogNameOf = { Map c -&gt; &apos;기존 거래가 있는 상품의 가격 제안 수락 1건과 등록 가격 결제 &apos; + c.payCount + &apos;건&apos; }
// 이 스레드에서 실행 설정을 한 번 확인해 둔다. 확인에 실패하면 오류 내용만 남기고, cfg()를 부를 때 그 내용으로 멈춘다.
if (vars.getObject(&apos;mpay_cfg&apos;) == null &amp;&amp; vars.get(&apos;mpay_cfg_error&apos;) == null) {
    try {
        File planDir0 = new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir())
        Map loaded0 = loadSettings(planDir0, SETTING_KEYS.collectEntries { [(it): vars.get(it)] })
        if (loaded0.error) { vars.put(&apos;mpay_cfg_error&apos;, loaded0.error as String) } else { vars.putObject(&apos;mpay_cfg&apos;, loaded0.cfg) }
    } catch (Throwable t0) { vars.put(&apos;mpay_cfg_error&apos;, &apos;실행 설정 확인 오류: &apos; + t0) }
}
try {

String[] a = Parameters.split(&apos;\\|&apos;, -1)
String no = a[0], action = a[1], expectCode = a[2], file = a[3]
String checks = a.length &gt; 4 ? a[4] : &apos;&apos;
String keeps = a.length &gt; 5 ? a[5] : &apos;&apos;
String body = prev.getResponseDataAsString()
String code = prev.getResponseCode()
def j = parse(body)
if (file.startsWith(&apos;@&apos;)) collectPut(file.substring(1), vars.get(&apos;role_key&apos;) ?: &apos;-&apos;, j ?: body)
else if (file) saveText(file, body)
def pathGet = { def obj, String path -&gt;
    def cur = obj
    for (String part : path.split(&apos;\\.&apos;)) {
        if (cur == null) return null
        if (part ==~ /\d+/) { cur = (cur instanceof List &amp;&amp; cur.size() &gt; (part as int)) ? cur[part as int] : null }
        else if (part == &apos;size&apos;) { cur = (cur instanceof List) ? cur.size() : null }
        else { cur = (cur instanceof Map) ? cur[part] : null }
    }
    return cur
}
def expand = { String v -&gt; v.replaceAll(/\{([A-Za-z_0-9]+)\}/) { all, key -&gt; String.valueOf(vars.get(key)) } }
List&lt;String&gt; problems = []
if (code != expectCode) problems &lt;&lt; (&apos;응답 &apos; + code + &apos;(기대 &apos; + expectCode + &apos;)&apos; + ((j instanceof Map &amp;&amp; j.code) ? (&apos;, 오류 코드 &apos; + j.code) : &apos;&apos;))
else if (j == null &amp;&amp; (checks || keeps)) problems &lt;&lt; &apos;응답 본문을 읽지 못함&apos;
if (problems.isEmpty()) {
    for (String c : checks.split(&apos;;&apos;)) {
        if (!c.trim()) continue
        int i = c.indexOf(&apos;=&apos;)
        String path = c.substring(0, i)
        String want = expand(c.substring(i + 1))
        def got = pathGet(j, path)
        String gotText = (got == null ? &apos;null&apos; : String.valueOf(got))
        if (gotText != want) problems &lt;&lt; (path + &apos;=&apos; + gotText + &apos;(기대 &apos; + want + &apos;)&apos;)
    }
}
String who = vars.get(&apos;role&apos;) ? (vars.get(&apos;role&apos;) + &apos; &apos;) : &apos;&apos;
if (!problems.isEmpty()) { failRun(prev, no, action, who + prev.getSampleLabel() + &apos;: &apos; + problems.join(&apos;, &apos;)); return }
for (String kv : keeps.split(&apos;;&apos;)) {
    if (!kv.trim()) continue
    int i = kv.indexOf(&apos;=&apos;)
    String v = String.valueOf(pathGet(j, kv.substring(0, i)))
    vars.put(kv.substring(i + 1), v)
}

} catch (Throwable t) {
String[] a2 = Parameters.split(&apos;\\|&apos;, -1)
failRun(prev, a2[0], a2[1], &apos;확인 스크립트 오류: &apos; + t)
}
</stringProp>
