        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="기존 예약 구매자 가격 제안(4개, 개당 9,000원)">
          <stringProp name="HTTPSampler.connect_timeout">${connectTimeoutMs}</stringProp>
