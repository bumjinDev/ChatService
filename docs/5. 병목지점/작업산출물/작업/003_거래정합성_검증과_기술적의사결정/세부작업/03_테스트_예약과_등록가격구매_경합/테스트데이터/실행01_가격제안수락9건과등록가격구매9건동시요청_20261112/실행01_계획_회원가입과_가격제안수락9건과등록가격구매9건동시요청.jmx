      <hashTree>
        <SyncTimer guiclass="TestBeanGUI" testclass="SyncTimer" testname="동기화 타이머(18개 요청이 모두 준비되면 같은 순간에 보냄, 최대 10초 대기)" enabled="true">
          <stringProp name="TestPlan.comments">스레드 18개가 모두 요청 직전에 도착하면 18개 요청을 같은 순간에 보낸다. 10초 안에 모이지 않으면 더 기다리지 않고 보낸다. 스레드마다 수락이나 결제 가운데 하나만 보내므로 이 타이머에 도착하는 요청도 18개다.</stringProp>
