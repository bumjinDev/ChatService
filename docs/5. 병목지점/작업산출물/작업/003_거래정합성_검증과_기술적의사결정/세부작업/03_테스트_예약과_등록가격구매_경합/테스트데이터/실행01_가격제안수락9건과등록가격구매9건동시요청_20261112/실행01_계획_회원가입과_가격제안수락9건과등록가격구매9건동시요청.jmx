            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="응답 코드, 오류 코드, 주문 ID를 속성에 넣고 응답 본문 저장(실행 폴더의 구매_등록가격구매자번호_응답)" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
// 응답 코드, 오류 코드, 응답에 담긴 주문 ID, 요청 시각과 걸린 시간을 속성에 넣고, 응답 본문을 실행 폴더에 저장한다.
int n = ctx.getThreadNum() - 8
String body = prev.getResponseDataAsString()
String errorCode = &apos;-&apos;
String orderId = &apos;-&apos;
boolean isJson = false
try {
    def j = new JsonSlurper().parseText(body)
    isJson = true
    if (j instanceof Map) {
        if (j.code) errorCode = String.valueOf(j.code)
        if (j.orderId != null) orderId = String.valueOf(j.orderId)
    }
} catch (Exception ignored) {
}
props.put(&apos;rsvbuy.buy_code_&apos; + n, prev.getResponseCode() ?: &apos;&apos;)
props.put(&apos;rsvbuy.buy_error_&apos; + n, errorCode)
props.put(&apos;rsvbuy.buy_order_&apos; + n, orderId)
props.put(&apos;rsvbuy.buy_start_&apos; + n, String.valueOf(prev.getStartTime()))
props.put(&apos;rsvbuy.buy_elapsed_&apos; + n, String.valueOf(prev.getTime()))
new File(vars.get(&apos;outDir&apos;), &apos;구매_등록가격구매자&apos; + vars.get(&apos;cur_no&apos;) + &apos;_응답&apos; + (isJson ? &apos;.json&apos; : &apos;.txt&apos;)).setText(body, &apos;UTF-8&apos;)
</stringProp>
            </JSR223PostProcessor>
