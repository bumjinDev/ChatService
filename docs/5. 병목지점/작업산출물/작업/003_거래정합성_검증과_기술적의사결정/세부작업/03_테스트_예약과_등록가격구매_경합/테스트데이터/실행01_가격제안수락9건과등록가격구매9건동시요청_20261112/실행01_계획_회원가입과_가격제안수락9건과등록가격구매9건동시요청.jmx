          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="로그인 토큰과 상품 ID 확인, 회원 CSV에서 구매자 18명 읽기, 대화 ID·제안 ID·결제 금액 정하기" enabled="true">
          <stringProp name="TestPlan.comments">로그인 그룹이 넣은 로그인 토큰과 「준비: 상품 등록」 그룹이 넣은 상품 ID가 있는지 확인한다. 하나라도 없으면 조회하지 않고 이 그룹을 멈춘다. 준비 그룹들이 넣은 대화 ID와 제안 ID, 등록 가격 구매자의 결제 금액을 역할·번호별 변수에 넣는다.</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">// 회원 CSV에서 run_id가 runId와 같은 줄을 모두 읽는다. 엑셀로 저장하면 「01」이 「1」로 바뀌므로 숫자로 비교한다.
String runId = vars.get(&apos;runId&apos;)
def sameRun = { String v -&gt; (v != null &amp;&amp; v.isInteger() &amp;&amp; runId.isInteger()) ? (v as int) == (runId as int) : v == runId }
List&lt;String&gt; lines = new File(vars.get(&apos;memberFile&apos;)).readLines(&apos;UTF-8&apos;)
List&lt;String&gt; cols = (lines[0].replace(&apos;﻿&apos;, &apos;&apos;).trim().split(&apos;,&apos;) as List)
List&lt;Map&lt;String, String&gt;&gt; rows = []
for (String line : lines.drop(1)) {
    if (line.trim().isEmpty()) continue
    List&lt;String&gt; vals = (line.trim().split(&apos;,&apos;, -1) as List)
    Map&lt;String, String&gt; row = [:]
    for (int i = 0; i &lt; cols.size(); i++) { row[cols[i]] = vals[i] }
    if (sameRun(row[&apos;run_id&apos;])) rows &lt;&lt; row
}
Map&lt;String, String&gt; seller = rows.find { it[&apos;role&apos;] == &apos;판매자&apos; }
List&lt;Map&lt;String, String&gt;&gt; offerBuyers = rows.findAll { it[&apos;role&apos;] == &apos;흥정 구매자&apos; }.sort { it[&apos;buyer_no&apos;] as int }
List&lt;Map&lt;String, String&gt;&gt; listedBuyers = rows.findAll { it[&apos;role&apos;] == &apos;등록 가격 구매자&apos; }.sort { it[&apos;buyer_no&apos;] as int }
if (seller == null || offerBuyers.size() != 9 || listedBuyers.size() != 9) {
    throw new IllegalStateException(&apos;회원 CSV에 실행 번호 &apos; + runId + &apos;의 판매자 1명, 흥정 구매자 9명, 등록 가격 구매자 9명이 없습니다. 판매자 &apos; +
            (seller == null ? 0 : 1) + &apos;명, 흥정 구매자 &apos; + offerBuyers.size() + &apos;명, 등록 가격 구매자 &apos; + listedBuyers.size() + &apos;명&apos;)
}
vars.put(&apos;seller_id&apos;, seller[&apos;member_id&apos;])
vars.put(&apos;seller_pw&apos;, seller[&apos;password&apos;])
// 흥정 구매자는 「ob_번호」, 등록 가격 구매자는 「lb_번호」 열쇠로 변수에 넣는다. 흥정 구매자의 수량은 제안 수량, 등록 가격 구매자의 수량은 구매 수량이다.
offerBuyers.eachWithIndex { b, idx -&gt;
    String key = &apos;ob_&apos; + (idx + 1)
    vars.put(&apos;id_&apos; + key, b[&apos;member_id&apos;])
    vars.put(&apos;pw_&apos; + key, b[&apos;password&apos;])
    vars.put(&apos;csvqty_&apos; + key, b[&apos;offer_quantity&apos;])
}
listedBuyers.eachWithIndex { b, idx -&gt;
    String key = &apos;lb_&apos; + (idx + 1)
    vars.put(&apos;id_&apos; + key, b[&apos;member_id&apos;])
    vars.put(&apos;pw_&apos; + key, b[&apos;password&apos;])
    vars.put(&apos;csvqty_&apos; + key, b[&apos;purchase_quantity&apos;])
}

def pickBuyer = { int k -&gt;
    boolean offerSide = k &lt;= 9
    int n = offerSide ? k : k - 9
    [key: (offerSide ? &apos;ob_&apos; : &apos;lb_&apos;) + n, role: offerSide ? &apos;흥정 구매자&apos; : &apos;등록 가격 구매자&apos;,
     fileRole: offerSide ? &apos;흥정구매자&apos; : &apos;등록가격구매자&apos;, no: String.format(&apos;%02d&apos;, n)]
}

// 로그인 그룹이 속성에 넣은 로그인 토큰을 읽는다. 하나라도 없으면 이 그룹의 요청을 보내지 않고 멈춘다.
String sellerToken = (props.get(&apos;rsvbuy.seller_token&apos;) ?: &apos;NOT_FOUND&apos;) as String
List&lt;String&gt; missing = []
if (sellerToken == &apos;NOT_FOUND&apos;) missing &lt;&lt; &apos;판매자&apos;
for (int k = 1; k &lt;= 18; k++) {
    def b = pickBuyer(k)
    if (((props.get(&apos;rsvbuy.token_&apos; + b.key) ?: &apos;NOT_FOUND&apos;) as String) == &apos;NOT_FOUND&apos;) missing &lt;&lt; (b.role + &apos; &apos; + b.no)
}
if (!missing.isEmpty()) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseMessage(&apos;로그인 토큰 없음: &apos; + missing.join(&apos;, &apos;) + &apos;. 같은 JMeter 창에서 「로그인」 그룹을 먼저 실행해야 한다&apos;)
    SampleResult.setStopThread(true)
    return
}
vars.put(&apos;seller_token&apos;, sellerToken)

// 「준비: 상품 등록」 그룹이 속성에 넣은 상품 ID를 읽는다. 없으면 이 그룹의 요청을 보내지 않고 멈춘다.
String productId = (props.get(&apos;rsvbuy.product_id&apos;) ?: &apos;NOT_FOUND&apos;) as String
if (productId == &apos;NOT_FOUND&apos;) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseMessage(&apos;상품 ID 없음. 같은 JMeter 창에서 「준비: 상품 등록」 그룹을 먼저 실행해야 한다&apos;)
    SampleResult.setStopThread(true)
    return
}
vars.put(&apos;product_id&apos;, productId)

// 준비 그룹들이 속성에 넣은 대화 ID와 제안 ID, 등록 가격 구매자의 결제 금액(등록 가격 × 구매 수량)을 역할·번호별 변수에 넣는다.
for (int n = 1; n &lt;= 9; n++) {
    vars.put(&apos;conv_ob_&apos; + n, (props.get(&apos;rsvbuy.conv_ob_&apos; + n) ?: &apos;NOT_FOUND&apos;) as String)
    vars.put(&apos;offer_ob_&apos; + n, (props.get(&apos;rsvbuy.offer_ob_&apos; + n) ?: &apos;NOT_FOUND&apos;) as String)
    vars.put(&apos;conv_lb_&apos; + n, (props.get(&apos;rsvbuy.conv_lb_&apos; + n) ?: &apos;NOT_FOUND&apos;) as String)
    vars.put(&apos;charge_lb_&apos; + n, String.valueOf((vars.get(&apos;productPrice&apos;) as long) * (vars.get(&apos;csvqty_lb_&apos; + n) as long)))
}
vars.put(&apos;run_log_id&apos;, (props.get(&apos;rsvbuy.run_log_id&apos;) ?: &apos;-&apos;) as String)
vars.put(&apos;check_index&apos;, &apos;0&apos;)
vars.put(&apos;wallet_index&apos;, &apos;0&apos;)
SampleResult.setResponseData(&apos;상품ID=&apos; + productId + &apos;, 실행ID=&apos; + vars.get(&apos;run_log_id&apos;), &apos;UTF-8&apos;)
</stringProp>
        </JSR223Sampler>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="판매자의 상품 상세 조회(요청 전 상태)" enabled="true">
          <stringProp name="TestPlan.comments">판매자가 상품 상세를 조회해 남은 수량과 구매 가능 수량이 50개인지 확인한다.</stringProp>
          <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
          <stringProp name="HTTPSampler.path">/ChatService/api/products/${product_id}</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="판매자 로그인 쿠키" enabled="true">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Cookie</stringProp>
                <stringProp name="Header.value">Authorization=${seller_token}</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="응답 코드 200" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49586">200</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message"></stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">8</intProp>
          </ResponseAssertion>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="남은 수량과 구매 가능 수량을 변수에 넣고 응답 본문 저장(실행 폴더의 요청전_판매자_상품상세응답.json)" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper
// 판매자가 본 상품의 남은 수량과 구매 가능 수량을 변수에 넣고, 응답 본문을 실행 폴더에 저장한다.
String body = prev.getResponseDataAsString()
new File(vars.get(&apos;outDir&apos;), &apos;요청전_판매자_상품상세응답.json&apos;).setText(body, &apos;UTF-8&apos;)
try {
    def j = new JsonSlurper().parseText(body)
    vars.put(&apos;pre_remaining&apos;, String.valueOf(j.remainingQuantity))
    vars.put(&apos;pre_available&apos;, String.valueOf(j.availableQuantity))
} catch (Exception e) {
    vars.put(&apos;pre_remaining&apos;, &apos;확인못함&apos;)
    vars.put(&apos;pre_available&apos;, &apos;확인못함&apos;)
}
</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
        <LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="구매자 18명마다 판매자의 대화 상세 조회(요청 전 상태)" enabled="true">
          <stringProp name="LoopController.loops">18</stringProp>
          <boolProp name="LoopController.continue_forever">true</boolProp>
        </LoopController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="판매자의 ${cur_role} ${cur_no} 대화 상세 조회(요청 전 상태)" enabled="true">
            <stringProp name="TestPlan.comments">판매자가 이 구매자의 대화 상세를 조회한다. 흥정 구매자의 대화에는 응답 대기 가격 제안 1건이 있고, 등록 가격 구매자의 대화에는 가격 제안이 없어야 한다. 두 대화 모두 예약과 주문이 없어야 한다.</stringProp>
            <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
            <stringProp name="HTTPSampler.path">/ChatService/api/conversations/${cur_conv}</stringProp>
            <stringProp name="HTTPSampler.method">GET</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
              <collectionProp name="Arguments.arguments"/>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="이번 반복의 구매자 정하기" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">def pickBuyer = { int k -&gt;
    boolean offerSide = k &lt;= 9
    int n = offerSide ? k : k - 9
    [key: (offerSide ? &apos;ob_&apos; : &apos;lb_&apos;) + n, role: offerSide ? &apos;흥정 구매자&apos; : &apos;등록 가격 구매자&apos;,
     fileRole: offerSide ? &apos;흥정구매자&apos; : &apos;등록가격구매자&apos;, no: String.format(&apos;%02d&apos;, n)]
}

// 이번 반복에서 판매자가 대화 상세를 조회할 구매자를 정한다. 반복 1~9는 흥정 구매자 01~09, 반복 10~18은 등록 가격 구매자 01~09다.
int k = (vars.get(&apos;check_index&apos;) as int) + 1
vars.put(&apos;check_index&apos;, String.valueOf(k))
def b = pickBuyer(k)
vars.put(&apos;cur_key&apos;, b.key)
vars.put(&apos;cur_role&apos;, b.role)
vars.put(&apos;cur_file_role&apos;, b.fileRole)
vars.put(&apos;cur_no&apos;, b.no)
vars.put(&apos;cur_conv&apos;, vars.get(&apos;conv_&apos; + b.key))
</stringProp>
            </JSR223PreProcessor>
