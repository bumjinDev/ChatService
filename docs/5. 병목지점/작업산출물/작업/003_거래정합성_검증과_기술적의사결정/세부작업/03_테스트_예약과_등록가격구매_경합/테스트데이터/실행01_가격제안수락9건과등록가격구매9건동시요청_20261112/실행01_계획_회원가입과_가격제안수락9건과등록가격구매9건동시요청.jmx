String productId = vars.get(&apos;product_id&apos;)
props.put(&apos;rsvbuy.product_id&apos;, productId ?: &apos;NOT_FOUND&apos;)
if (productId == null || productId == &apos;NOT_FOUND&apos;) {
    prev.setSuccessful(false)
    prev.setResponseMessage(&apos;상품 ID를 받지 못함&apos;)
}
</stringProp>
