              <stringProp name="script">// 이 흥정 구매자의 제안 ID를 번호별 속성에 넣고, 가격 제안 응답 본문을 실행 폴더에 저장한다.
props.put(&apos;rsvbuy.offer_&apos; + vars.get(&apos;cur_key&apos;), vars.get(&apos;cur_offer&apos;) ?: &apos;NOT_FOUND&apos;)
new File(vars.get(&apos;outDir&apos;), &apos;준비_흥정구매자&apos; + vars.get(&apos;cur_no&apos;) + &apos;_가격제안응답.json&apos;).setText(prev.getResponseDataAsString(), &apos;UTF-8&apos;)
</stringProp>
            </JSR223PostProcessor>
