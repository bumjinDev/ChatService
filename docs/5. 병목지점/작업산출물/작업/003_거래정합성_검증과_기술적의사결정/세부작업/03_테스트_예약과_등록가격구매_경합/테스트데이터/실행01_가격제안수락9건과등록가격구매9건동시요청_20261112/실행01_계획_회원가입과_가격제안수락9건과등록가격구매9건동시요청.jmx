      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="준비: 요청 전 상태 확인" enabled="true">
        <stringProp name="TestPlan.comments">판매자의 상품 상세와 대화 상세 18건, 등록 가격 구매자의 잔액 9건을 조회해 요청 전 상태를 확인하고, 경합 그룹과 저장 상태 확인 그룹이 쓸 값을 JMeter 속성에 넣는다. 이 그룹의 요청은 경합의 요청 수에 들어가지 않는다.</stringProp>
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">0</intProp>
