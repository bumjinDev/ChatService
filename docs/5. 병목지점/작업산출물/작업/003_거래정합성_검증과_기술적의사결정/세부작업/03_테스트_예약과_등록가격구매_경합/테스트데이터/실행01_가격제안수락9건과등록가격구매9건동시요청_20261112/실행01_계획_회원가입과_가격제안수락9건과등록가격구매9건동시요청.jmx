            <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="JSON 헤더, 판매자 로그인 쿠키, 서버 로그용 테스트명·실행 ID·요청 ID" enabled="true">
              <collectionProp name="HeaderManager.headers">
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">Content-Type</stringProp>
                  <stringProp name="Header.value">application/json</stringProp>
                </elementProp>
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">Cookie</stringProp>
                  <stringProp name="Header.value">Authorization=${seller_token}</stringProp>
                </elementProp>
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">X-Test-Log-Name</stringProp>
                  <stringProp name="Header.value">${test_log_name}</stringProp>
                </elementProp>
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">X-Test-Log-Run-Id</stringProp>
                  <stringProp name="Header.value">${run_log_id}</stringProp>
                </elementProp>
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">X-Test-Log-Request-Id</stringProp>
                  <stringProp name="Header.value">${req_log_id}</stringProp>
                </elementProp>
              </collectionProp>
            </HeaderManager>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="응답 코드, 오류 코드, 예약을 속성에 넣고 응답 본문 저장(실행 폴더의 수락_흥정구매자번호_응답)" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
// 응답 코드, 오류 코드, 응답에 담긴 예약, 요청 시각과 걸린 시간을 속성에 넣고, 응답 본문을 실행 폴더에 저장한다.
int n = ctx.getThreadNum() + 1
String body = prev.getResponseDataAsString()
String errorCode = &apos;-&apos;
String reservationId = &apos;-&apos;
String reservationQty = &apos;-&apos;
boolean isJson = false
try {
    def j = new JsonSlurper().parseText(body)
    isJson = true
    if (j instanceof Map) {
        if (j.code) errorCode = String.valueOf(j.code)
        if (j.reservation) {
            reservationId = String.valueOf(j.reservation.reservationId)
            reservationQty = String.valueOf(j.reservation.quantity)
        }
    }
} catch (Exception ignored) {
}
props.put(&apos;rsvbuy.accept_code_&apos; + n, prev.getResponseCode() ?: &apos;&apos;)
props.put(&apos;rsvbuy.accept_error_&apos; + n, errorCode)
props.put(&apos;rsvbuy.accept_reservation_&apos; + n, reservationId)
props.put(&apos;rsvbuy.accept_reservation_qty_&apos; + n, reservationQty)
props.put(&apos;rsvbuy.accept_start_&apos; + n, String.valueOf(prev.getStartTime()))
props.put(&apos;rsvbuy.accept_elapsed_&apos; + n, String.valueOf(prev.getTime()))
new File(vars.get(&apos;outDir&apos;), &apos;수락_흥정구매자&apos; + vars.get(&apos;cur_no&apos;) + &apos;_응답&apos; + (isJson ? &apos;.json&apos; : &apos;.txt&apos;)).setText(body, &apos;UTF-8&apos;)
</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="응답 구분: 성공과 수량 부족은 통과, 기타 오류와 응답 미확인은 실패로 표시" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
// 성공(200)과 수량 부족(409이고 오류 코드가 예약 가능 수량 부족·판매 종료 가운데 하나)은 통과로, 그 밖의 응답과 응답을 받지 못한 요청은 실패로 표시한다.
List&lt;String&gt; shortageCodes = [&apos;RESERVATION_QUANTITY_EXCEEDED&apos;, &apos;PRODUCT_NOT_ON_SALE&apos;]
String code = SampleResult.getResponseCode()
String errorCode = &apos;-&apos;
try {
    def j = new JsonSlurper().parseText(SampleResult.getResponseDataAsString())
    if (j instanceof Map &amp;&amp; j.code) errorCode = String.valueOf(j.code)
} catch (Exception ignored) {
}
if (code == &apos;200&apos;) {
    SampleResult.setResponseMessage(&apos;성공&apos;)
} else if (code == &apos;409&apos; &amp;&amp; shortageCodes.contains(errorCode)) {
    SampleResult.setSuccessful(true)
    SampleResult.setResponseMessage(&apos;수량부족: &apos; + errorCode)
} else {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage((code ==~ /\d{3}/ ? &apos;기타오류: &apos; : &apos;미확인: &apos;) + code + &apos; &apos; + errorCode)
}
</stringProp>
            </JSR223Assertion>
