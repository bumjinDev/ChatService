          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="경합 결과와 확인에 쓸 값 읽기" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">// 수락·결제 경합 그룹이 속성에 남긴 값과 로그인 그룹·준비 그룹이 넘긴 값을 이 스레드의 변수로 읽는다.
// 이 그룹을 같은 JMeter 창에서 다시 실행할 때 이전 확인 결과가 섞이지 않도록 저장 상태 확인 속성을 지운다.
props.keySet().findAll { it.toString().startsWith(&apos;rsvbuy.post_&apos;) }.each { props.remove(it) }
vars.put(&apos;seller_token&apos;, (props.get(&apos;rsvbuy.seller_token&apos;) ?: &apos;&apos;) as String)
vars.put(&apos;product_id&apos;, (props.get(&apos;rsvbuy.product_id&apos;) ?: &apos;NOT_FOUND&apos;) as String)
vars.put(&apos;check_index&apos;, &apos;0&apos;)
vars.put(&apos;wallet_index&apos;, &apos;0&apos;)
int accepts = (1..9).count { props.get(&apos;rsvbuy.accept_code_&apos; + it) != null }
int buys = (1..9).count { props.get(&apos;rsvbuy.buy_code_&apos; + it) != null }
SampleResult.setResponseData(&apos;수락 응답을 기록한 요청 &apos; + accepts + &apos;건, 결제 응답을 기록한 요청 &apos; + buys + &apos;건, 상품ID=&apos; + vars.get(&apos;product_id&apos;), &apos;UTF-8&apos;)
</stringProp>
        </JSR223Sampler>
