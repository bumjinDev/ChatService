            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="응답 코드 200" enabled="true">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="49586">200</stringProp>
              </collectionProp>
              <stringProp name="Assertion.custom_message"></stringProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">8</intProp>
            </ResponseAssertion>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="잔액을 속성에 넣고 응답 본문 저장(실행 폴더의 종료후_등록가격구매자번호_잔액응답.json)" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
// 경합 뒤 이 등록 가격 구매자의 잔액을 속성에 넣고, 응답 본문을 실행 폴더에 저장한다.
String key = vars.get(&apos;cur_key&apos;)
String body = prev.getResponseDataAsString()
new File(vars.get(&apos;outDir&apos;), &apos;종료후_등록가격구매자&apos; + vars.get(&apos;cur_no&apos;) + &apos;_잔액응답.json&apos;).setText(body, &apos;UTF-8&apos;)
try {
    def j = new JsonSlurper().parseText(body)
    if (!(j instanceof Map) || j.balance == null) throw new IllegalStateException(&apos;잔액 응답이 아님&apos;)
    props.put(&apos;rsvbuy.post_balance_&apos; + key, String.valueOf(j.balance))
    props.put(&apos;rsvbuy.post_wallet_read_&apos; + key, &apos;Y&apos;)
} catch (Exception e) {
    props.put(&apos;rsvbuy.post_wallet_read_&apos; + key, &apos;N&apos;)
}
</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>
        </hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="요청별종료후확인과 전체종료후확인 쓰기(실행 폴더의 종료후확인.log)" enabled="true">
          <stringProp name="TestPlan.comments">수락 요청마다 응답과 저장된 가격 제안·예약을, 결제 요청마다 응답과 저장된 주문·잔액을 맞춰 보고, 실행 전체의 유효 예약 합계, 주문 수량 합계, 주문 건수, 남은 수량, 상품 상태, 수락과 결제의 응답 구분별 건수, 결과 확인 기준 위반을 서버 로그와 같은 형식으로 종료후확인.log에 쓴다. 결과 확인 기준 위반이 있으면 이 표본을 실패로 표시한다.</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import java.net.URLDecoder
import java.time.Instant
import java.time.OffsetDateTime
import java.time.ZoneId
import java.time.format.DateTimeFormatter
import org.apache.jmeter.services.FileServer

List&lt;String&gt; allKeys = ((1..9).collect { &apos;ob_&apos; + it }) + ((1..9).collect { &apos;lb_&apos; + it })


// 요청마다 응답과 저장된 상태를 맞춰 본 줄(요청별종료후확인)과 실행 전체를 확인한 줄(전체종료후확인)을 서버 로그와 같은 형식으로 실행 폴더의 종료후확인.log에 쓴다.
// 항목과 위반 목록은 세부 작업 03 세부작업기록의 「2. 계획」을 따른다. 수락 9줄은 작업명세 04, 결제 9줄은 작업명세 05의 항목이다.
def p = { String name -&gt; (props.get(&apos;rsvbuy.&apos; + name) ?: &apos;-&apos;) as String }
String runLogId = p(&apos;run_log_id&apos;)
String testName = URLDecoder.decode(p(&apos;test_log_name&apos;), &apos;UTF-8&apos;)
String jmxName = FileServer.getFileServer().getScriptName()
String productId = p(&apos;product_id&apos;)
long saleQty = (vars.get(&apos;productQuantity&apos;) as long)
Instant checkedAt = Instant.now()
def fmt = DateTimeFormatter.ofPattern(&quot;yyyy-MM-dd&apos;T&apos;HH:mm:ss.SSSSSSXXX&quot;)
def line = { String feature, String stage, String reqId, List items -&gt;
    StringBuilder sb = new StringBuilder()
    sb.append(OffsetDateTime.now(ZoneId.of(&apos;Asia/Seoul&apos;)).format(fmt)).append(&apos; - &apos;).append(testName).append(&apos; - &apos;).append(feature).append(&apos; - &apos;)
      .append(jmxName).append(&apos; - 수락·결제 경합 뒤 저장 상태 확인 | 실행ID=&apos;).append(runLogId).append(&apos; 요청ID=&apos;).append(reqId)
      .append(&apos; 단계=&apos;).append(stage).append(&apos; |&apos;)
    for (int i = 0; i + 1 &lt; items.size(); i += 2) { sb.append(&apos; &apos;).append(items[i]).append(&apos;=&apos;).append(items[i + 1]) }
    sb.toString()
}
def kindOf = { String codeProp, String okCode, List&lt;String&gt; shortageCodes -&gt;
    String code = p(codeProp)
    String error = p(codeProp.replace(&apos;_code_&apos;, &apos;_error_&apos;))
    if (props.get(&apos;rsvbuy.&apos; + codeProp) == null) return &apos;미확인&apos;
    if (code == okCode) return &apos;성공&apos;
    if (code == &apos;409&apos; &amp;&amp; shortageCodes.contains(error)) return &apos;수량부족&apos;
    if (code ==~ /\d{3}/) return &apos;기타오류&apos;
    return &apos;미확인&apos;
}
// HTTP 응답 코드를 받지 못한 요청은 응답상태를 「응답없음(예외 이름)」으로 적는다.
def shown = { String code -&gt; (code ==~ /\d{3}/) ? code : (&apos;응답없음(&apos; + (code.contains(&apos;.&apos;) ? code.substring(code.lastIndexOf(&apos;.&apos;) + 1) : code) + &apos;)&apos;) }

// 대화 18건에서 유효 예약 합계, 주문 수량 합계와 건수, 상품의 남은 수량과 판매 상태를 읽는다.
// 유효 예약은 예약 중 상태이면서 만료 시각이 확인 시각보다 뒤인 예약이다. 예약 중 상태인데 만료 시각이 지난 예약은 합계에 넣지 않고 위반으로 적는다.
long activeSum = 0
long orderQtySum = 0
int orderCount = 0
boolean allRead = true
boolean expiredSeen = false
String remaining = &apos;-&apos;
String productStatus = &apos;-&apos;
for (String key : allKeys) {
    boolean read = p(&apos;post_read_&apos; + key) == &apos;Y&apos;
    if (!read) { allRead = false; continue }
    if (remaining == &apos;-&apos;) {
        remaining = p(&apos;post_remaining_&apos; + key)
        productStatus = p(&apos;post_status_&apos; + key)
    }
    if (p(&apos;post_order_count_&apos; + key).isInteger()) orderCount += (p(&apos;post_order_count_&apos; + key) as int)
    if (p(&apos;post_order_qty_&apos; + key).isLong()) orderQtySum += (p(&apos;post_order_qty_&apos; + key) as long)
    if (p(&apos;post_res_status_&apos; + key) == &apos;ACTIVE&apos; &amp;&amp; p(&apos;post_res_qty_&apos; + key).isLong()) {
        boolean beforeExpiry = false
        try { beforeExpiry = Instant.parse(p(&apos;post_res_expires_&apos; + key)).isAfter(checkedAt) } catch (Exception ignored) { }
        if (beforeExpiry) activeSum += (p(&apos;post_res_qty_&apos; + key) as long) else expiredSeen = true
    }
}

List&lt;String&gt; out = []
int aSuccess = 0, aShortage = 0, aOther = 0, aUnknown = 0
int bSuccess = 0, bShortage = 0, bOther = 0, bUnknown = 0
List&lt;String&gt; partial = []          // 성공한 수락에 제안 수량 전부가 예약되지 않은 요청의 제안 ID
List&lt;String&gt; offerMismatch = []    // 수락 상태와 예약이 맞지 않는 요청의 제안 ID
List&lt;String&gt; acceptLeftover = []   // 수량 부족으로 거절된 수락 요청에 수락이나 예약이 남은 요청의 제안 ID
List&lt;String&gt; noOrderOnSuccess = [] // 성공한 결제에 주문이 없거나 주문 수량이 요청 수량과 다른 등록 가격 구매자
List&lt;String&gt; walletMismatch = []   // 주문과 잔액이 맞지 않는 등록 가격 구매자
List&lt;String&gt; buyLeftover = []      // 수량 부족으로 거절된 결제 요청에 주문이 남은 등록 가격 구매자

// 수락 9줄
for (int n = 1; n &lt;= 9; n++) {
    String key = &apos;ob_&apos; + n
    String no = String.format(&apos;%02d&apos;, n)
    String offerId = p(&apos;offer_&apos; + key)
    String code = p(&apos;accept_code_&apos; + n)
    String error = p(&apos;accept_error_&apos; + n)
    String kind = kindOf(&apos;accept_code_&apos; + n, &apos;200&apos;, [&apos;RESERVATION_QUANTITY_EXCEEDED&apos;, &apos;PRODUCT_NOT_ON_SALE&apos;])
    switch (kind) { case &apos;성공&apos;: aSuccess++; break; case &apos;수량부족&apos;: aShortage++; break; case &apos;기타오류&apos;: aOther++; break; default: aUnknown++ }

    boolean read = p(&apos;post_read_&apos; + key) == &apos;Y&apos;
    String offerStatus = read ? p(&apos;post_offer_status_&apos; + key) : &apos;확인못함&apos;
    String offerQty = read ? p(&apos;post_offer_qty_&apos; + key) : &apos;확인못함&apos;
    boolean resOfOffer = read &amp;&amp; p(&apos;post_res_offer_&apos; + key) == offerId
    String resId = read ? (resOfOffer ? p(&apos;post_res_id_&apos; + key) : &apos;-&apos;) : &apos;확인못함&apos;
    String resQty = read ? (resOfOffer ? p(&apos;post_res_qty_&apos; + key) : &apos;-&apos;) : &apos;확인못함&apos;
    String resStatus = read ? (resOfOffer ? p(&apos;post_res_status_&apos; + key) : &apos;-&apos;) : &apos;확인못함&apos;

    boolean match = false
    if (read) {
        if (offerStatus == &apos;ACCEPTED&apos;) {
            match = resOfOffer &amp;&amp; p(&apos;post_res_product_&apos; + key) == productId &amp;&amp; p(&apos;post_res_conv_&apos; + key) == p(&apos;conv_&apos; + key) &amp;&amp;
                    resQty == offerQty &amp;&amp; resStatus == &apos;ACTIVE&apos;
        } else {
            match = !resOfOffer
        }
        if (!match) offerMismatch &lt;&lt; offerId
        if (kind == &apos;수량부족&apos; &amp;&amp; (offerStatus == &apos;ACCEPTED&apos; || resOfOffer)) acceptLeftover &lt;&lt; offerId
    }
    if (kind == &apos;성공&apos; &amp;&amp; !(read &amp;&amp; offerStatus == &apos;ACCEPTED&apos; &amp;&amp; resOfOffer &amp;&amp; resQty == offerQty)) partial &lt;&lt; offerId

    out &lt;&lt; line(&apos;가격 제안 수락&apos;, &apos;요청별종료후확인&apos;, &apos;accept-&apos; + no, [&apos;제안ID&apos;, offerId, &apos;구매자ID&apos;, p(&apos;buyer_&apos; + key), &apos;요청수량&apos;, p(&apos;qty_&apos; + key),
            &apos;응답상태&apos;, shown(code), &apos;오류코드&apos;, error, &apos;응답구분&apos;, kind, &apos;제안상태&apos;, offerStatus, &apos;예약ID&apos;, resId, &apos;예약수량&apos;, resQty,
            &apos;예약상태&apos;, resStatus, &apos;수락예약일치&apos;, match ? &apos;일치&apos; : &apos;불일치&apos;])
}

// 결제 9줄
for (int n = 1; n &lt;= 9; n++) {
    String key = &apos;lb_&apos; + n
    String no = String.format(&apos;%02d&apos;, n)
    String buyerId = p(&apos;buyer_&apos; + key)
    String qty = p(&apos;qty_&apos; + key)
    String charge = p(&apos;charge_&apos; + key)
    String code = p(&apos;buy_code_&apos; + n)
    String error = p(&apos;buy_error_&apos; + n)
    String kind = kindOf(&apos;buy_code_&apos; + n, &apos;201&apos;, [&apos;INSUFFICIENT_STOCK&apos;, &apos;PRODUCT_RESERVED&apos;, &apos;PRODUCT_NOT_ON_SALE&apos;])
    switch (kind) { case &apos;성공&apos;: bSuccess++; break; case &apos;수량부족&apos;: bShortage++; break; case &apos;기타오류&apos;: bOther++; break; default: bUnknown++ }

    boolean convRead = p(&apos;post_read_&apos; + key) == &apos;Y&apos;
    boolean walletRead = p(&apos;post_wallet_read_&apos; + key) == &apos;Y&apos;
    String countText = p(&apos;post_order_count_&apos; + key)
    int count = (convRead &amp;&amp; countText.isInteger()) ? (countText as int) : 0
    String orderId = convRead ? p(&apos;post_order_id_&apos; + key) : &apos;확인못함&apos;
    String orderQty = convRead ? p(&apos;post_order_qty_&apos; + key) : &apos;확인못함&apos;
    String paid = convRead ? p(&apos;post_order_paid_&apos; + key) : &apos;확인못함&apos;
    String tradeStatus = convRead ? p(&apos;post_order_status_&apos; + key) : &apos;확인못함&apos;
    String balance = walletRead ? p(&apos;post_balance_&apos; + key) : &apos;확인못함&apos;
    if (!walletRead) allRead = false

    // 주문잔액일치: 주문이 있으면 잔액이 「충전 금액 − 결제금액」, 주문이 없으면 잔액이 충전 금액일 때 일치
    boolean match = false
    if (convRead &amp;&amp; walletRead &amp;&amp; balance.isLong() &amp;&amp; charge.isLong()) {
        long b = balance as long
        long c = charge as long
        match = (count &gt; 0) ? (paid.isLong() &amp;&amp; b == c - (paid as long)) : (b == c)
    }
    if (convRead &amp;&amp; walletRead &amp;&amp; !match) walletMismatch &lt;&lt; buyerId
    if (kind == &apos;성공&apos; &amp;&amp; !(convRead &amp;&amp; count &gt; 0 &amp;&amp; orderQty == qty)) noOrderOnSuccess &lt;&lt; buyerId
    if (kind == &apos;수량부족&apos; &amp;&amp; convRead &amp;&amp; count &gt; 0) buyLeftover &lt;&lt; buyerId

    out &lt;&lt; line(&apos;결제&apos;, &apos;요청별종료후확인&apos;, &apos;buy-&apos; + no, [&apos;구매자ID&apos;, buyerId, &apos;요청수량&apos;, qty, &apos;응답상태&apos;, shown(code), &apos;오류코드&apos;, error, &apos;응답구분&apos;, kind,
            &apos;주문ID&apos;, orderId, &apos;주문수량&apos;, orderQty, &apos;결제금액&apos;, paid, &apos;거래상태&apos;, tradeStatus, &apos;잔액&apos;, balance, &apos;주문잔액일치&apos;, match ? &apos;일치&apos; : &apos;불일치&apos;])
}

List&lt;String&gt; violations = []
if (activeSum + orderQtySum &gt; saleQty) violations &lt;&lt; (&apos;유효 예약 합계와 주문 수량 합계를 더한 값이 판매 수량 &apos; + saleQty + &apos;개를 넘음&apos;)
if (!partial.isEmpty()) violations &lt;&lt; (&apos;성공한 수락에 제안 수량 전부가 예약되지 않음(제안ID &apos; + partial.join(&apos;·&apos;) + &apos;)&apos;)
if (!offerMismatch.isEmpty()) violations &lt;&lt; (&apos;수락 상태와 예약이 맞지 않음(제안ID &apos; + offerMismatch.join(&apos;·&apos;) + &apos;)&apos;)
if (!noOrderOnSuccess.isEmpty()) violations &lt;&lt; (&apos;성공한 구매에 주문이 없거나 주문 수량이 요청 수량과 다름(구매자ID &apos; + noOrderOnSuccess.join(&apos;·&apos;) + &apos;)&apos;)
if (!remaining.isLong() || (remaining as long) != saleQty - orderQtySum) violations &lt;&lt; &apos;상품의 남은 수량이 판매 수량에서 주문 수량 합계를 뺀 값과 다름&apos;
if (remaining.isLong()) {
    String expectedStatus = ((remaining as long) == 0) ? &apos;SOLD&apos; : &apos;ON_SALE&apos;
    if (productStatus != expectedStatus) violations &lt;&lt; &apos;상품 상태가 남은 수량과 맞지 않음&apos;
}
if (!walletMismatch.isEmpty()) violations &lt;&lt; (&apos;주문과 잔액이 맞지 않음(구매자ID &apos; + walletMismatch.join(&apos;·&apos;) + &apos;)&apos;)
if (!acceptLeftover.isEmpty()) violations &lt;&lt; (&apos;수량 부족으로 거절된 수락 요청에 수락이나 예약이 남음(제안ID &apos; + acceptLeftover.join(&apos;·&apos;) + &apos;)&apos;)
if (!buyLeftover.isEmpty()) violations &lt;&lt; (&apos;수량 부족으로 거절된 결제 요청에 주문이 남음(구매자ID &apos; + buyLeftover.join(&apos;·&apos;) + &apos;)&apos;)
if (!allRead) violations &lt;&lt; &apos;저장 상태를 읽지 못한 대화나 잔액 조회 있음&apos;
if (expiredSeen) violations &lt;&lt; &apos;만료 시각이 지난 뒤 확인한 예약 있음&apos;

out &lt;&lt; line(&apos;가격 제안 수락과 결제&apos;, &apos;전체종료후확인&apos;, &apos;-&apos;, [&apos;유효예약합계&apos;, activeSum, &apos;주문수량합계&apos;, orderQtySum, &apos;주문건수&apos;, orderCount,
        &apos;남은수량&apos;, remaining, &apos;상품상태&apos;, productStatus,
        &apos;수락성공수&apos;, aSuccess, &apos;수락수량부족수&apos;, aShortage, &apos;수락기타오류수&apos;, aOther, &apos;수락미확인수&apos;, aUnknown,
        &apos;결제성공수&apos;, bSuccess, &apos;결제수량부족수&apos;, bShortage, &apos;결제기타오류수&apos;, bOther, &apos;결제미확인수&apos;, bUnknown,
        &apos;결과확인기준위반&apos;, violations.isEmpty() ? &apos;없음&apos; : violations.join(&apos;; &apos;)])

new File(vars.get(&apos;outDir&apos;), &apos;종료후확인.log&apos;).setText(out.join(&apos;\n&apos;) + &apos;\n&apos;, &apos;UTF-8&apos;)
SampleResult.setSuccessful(violations.isEmpty())
SampleResult.setResponseMessage(violations.isEmpty() ? &apos;결과 확인 기준 위반 없음&apos; : &apos;결과 확인 기준 위반 있음&apos;)
SampleResult.setResponseData(out.join(&apos;\n&apos;), &apos;UTF-8&apos;)
</stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
