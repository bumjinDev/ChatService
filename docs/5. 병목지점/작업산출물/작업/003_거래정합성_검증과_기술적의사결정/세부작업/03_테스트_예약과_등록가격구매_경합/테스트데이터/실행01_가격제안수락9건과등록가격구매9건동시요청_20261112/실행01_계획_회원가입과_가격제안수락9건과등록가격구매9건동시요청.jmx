            <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="판매자 로그인 쿠키" enabled="true">
              <collectionProp name="HeaderManager.headers">
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">Cookie</stringProp>
                  <stringProp name="Header.value">Authorization=${seller_token}</stringProp>
                </elementProp>
              </collectionProp>
            </HeaderManager>
            <hashTree/>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="응답 코드 200" enabled="true">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="49586">200</stringProp>
              </collectionProp>
              <stringProp name="Assertion.custom_message"></stringProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">8</intProp>
            </ResponseAssertion>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="가격 제안, 예약, 주문을 변수에 넣고 응답 본문 저장(실행 폴더의 요청전_역할번호_대화상세응답.json)" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
// 판매자가 본 대화 상세에서 이 구매자의 가격 제안 수, 흥정 구매자이면 자기 가격 제안의 상태와 수량, 예약, 주문 수를 변수에 넣고, 응답 본문을 실행 폴더에 저장한다.
String key = vars.get(&apos;cur_key&apos;)
String body = prev.getResponseDataAsString()
new File(vars.get(&apos;outDir&apos;), &apos;요청전_&apos; + vars.get(&apos;cur_file_role&apos;) + vars.get(&apos;cur_no&apos;) + &apos;_대화상세응답.json&apos;).setText(body, &apos;UTF-8&apos;)
try {
    def j = new JsonSlurper().parseText(body)
    if (!(j instanceof Map) || j.product == null) throw new IllegalStateException(&apos;대화 상세 응답이 아님&apos;)
    vars.put(&apos;pre_offer_count_&apos; + key, String.valueOf(j.offers ? j.offers.size() : 0))
    if (key.startsWith(&apos;ob_&apos;)) {
        def offer = j.offers?.find { String.valueOf(it.offerId) == vars.get(&apos;offer_&apos; + key) }
        vars.put(&apos;pre_offer_status_&apos; + key, offer ? String.valueOf(offer.status) : &apos;없음&apos;)
        vars.put(&apos;pre_offer_qty_&apos; + key, offer ? String.valueOf(offer.quantity) : &apos;없음&apos;)
    }
    vars.put(&apos;pre_reservation_&apos; + key, j.reservation ? String.valueOf(j.reservation.reservationId) : &apos;-&apos;)
    vars.put(&apos;pre_order_count_&apos; + key, String.valueOf(j.orders ? j.orders.size() : 0))
} catch (Exception e) {
    [&apos;pre_offer_count_&apos;, &apos;pre_offer_status_&apos;, &apos;pre_offer_qty_&apos;, &apos;pre_reservation_&apos;, &apos;pre_order_count_&apos;].each { vars.put(it + key, &apos;확인못함&apos;) }
}
</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>
        </hashTree>
        <LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="등록 가격 구매자 9명마다 잔액 조회(요청 전 상태)" enabled="true">
          <stringProp name="LoopController.loops">9</stringProp>
          <boolProp name="LoopController.continue_forever">true</boolProp>
        </LoopController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="등록 가격 구매자 ${cur_no} 잔액 조회(요청 전 상태)" enabled="true">
            <stringProp name="TestPlan.comments">등록 가격 구매자가 자기 잔액을 조회해 잔액이 결제 금액과 같은지 확인한다.</stringProp>
            <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
            <stringProp name="HTTPSampler.path">/ChatService/api/wallet</stringProp>
            <stringProp name="HTTPSampler.method">GET</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
              <collectionProp name="Arguments.arguments"/>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="이번 반복의 등록 가격 구매자 정하기" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">// 이번 반복에서 잔액을 조회할 등록 가격 구매자를 정한다. 로그인 토큰은 로그인 그룹이 넣은 속성에서 읽는다.
int n = (vars.get(&apos;wallet_index&apos;) as int) + 1
vars.put(&apos;wallet_index&apos;, String.valueOf(n))
vars.put(&apos;cur_key&apos;, &apos;lb_&apos; + n)
vars.put(&apos;cur_no&apos;, String.format(&apos;%02d&apos;, n))
vars.put(&apos;cur_token&apos;, (props.get(&apos;rsvbuy.token_lb_&apos; + n) ?: &apos;NOT_FOUND&apos;) as String)
</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
            <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="등록 가격 구매자 로그인 쿠키" enabled="true">
              <collectionProp name="HeaderManager.headers">
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">Cookie</stringProp>
                  <stringProp name="Header.value">Authorization=${cur_token}</stringProp>
                </elementProp>
              </collectionProp>
            </HeaderManager>
            <hashTree/>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="응답 코드 200" enabled="true">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="49586">200</stringProp>
              </collectionProp>
              <stringProp name="Assertion.custom_message"></stringProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">8</intProp>
            </ResponseAssertion>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="잔액을 변수에 넣고 응답 본문 저장(실행 폴더의 요청전_등록가격구매자번호_잔액응답.json)" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
// 요청 전 이 등록 가격 구매자의 잔액을 변수에 넣고, 응답 본문을 실행 폴더에 저장한다.
String key = vars.get(&apos;cur_key&apos;)
String body = prev.getResponseDataAsString()
new File(vars.get(&apos;outDir&apos;), &apos;요청전_등록가격구매자&apos; + vars.get(&apos;cur_no&apos;) + &apos;_잔액응답.json&apos;).setText(body, &apos;UTF-8&apos;)
try {
    def j = new JsonSlurper().parseText(body)
    if (!(j instanceof Map) || j.balance == null) throw new IllegalStateException(&apos;잔액 응답이 아님&apos;)
    vars.put(&apos;pre_balance_&apos; + key, String.valueOf(j.balance))
} catch (Exception e) {
    vars.put(&apos;pre_balance_&apos; + key, &apos;확인못함&apos;)
}
</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>
        </hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="요청 전 상태 확인과 경합에 넘길 값 정하기(실행 폴더의 준비_ID와_요청전상태.csv, 준비_요청전상태_요약.csv)" enabled="true">
          <stringProp name="TestPlan.comments">구매자 18명의 역할, 회원 ID, 대화 ID, 흥정 구매자의 제안 ID·제안 수량·제안 상태, 등록 가격 구매자의 구매 수량·결제 금액·요청 전 잔액, 가격 제안 수, 예약, 주문 수, 서버 로그용 요청 ID를 준비_ID와_요청전상태.csv에 쓴다. 남은 수량과 구매 가능 수량이 50개이고, 대화가 18건이고, 응답 대기 가격 제안이 9건(제안 수량 합계 30개)이고, 등록 가격 구매자 9명 모두 잔액이 결제 금액과 같고, 예약과 주문이 없으면 「기본 구성과 같음」으로 표시한다. 다르더라도 다음 그룹은 그대로 실행한다.</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import java.net.URLEncoder

def pickBuyer = { int k -&gt;
    boolean offerSide = k &lt;= 9
    int n = offerSide ? k : k - 9
    [key: (offerSide ? &apos;ob_&apos; : &apos;lb_&apos;) + n, role: offerSide ? &apos;흥정 구매자&apos; : &apos;등록 가격 구매자&apos;,
     fileRole: offerSide ? &apos;흥정구매자&apos; : &apos;등록가격구매자&apos;, no: String.format(&apos;%02d&apos;, n)]
}

// 구매자 18명의 ID와 요청 전 상태를 실행 폴더의 준비_ID와_요청전상태.csv에 쓰고, 요청 전 상태가 기본 구성과 같은지 확인한다.
// 속성에는 빈 값을 넣을 수 없으므로 값이 없으면 「-」를 넣는다.
def put = { String name, Object value -&gt; props.put(name, value == null ? &apos;-&apos; : value.toString()) }
long expectedQty = (vars.get(&apos;productQuantity&apos;) as long)
long expectedOfferSum = (1..9).collect { (vars.get(&apos;csvqty_ob_&apos; + it) as long) }.sum()
StringBuilder csv = new StringBuilder(&apos;﻿role,buyer_no,buyer_id,conversation_id,offer_id,offer_quantity,offer_status,purchase_quantity,payment_amount,balance,offer_count,reservation_id,order_count,request_log_id\n&apos;)
int conversations = 0
int pending = 0
long offerQtySum = 0
int balanceMatches = 0
long offers = 0
int reservations = 0
long orders = 0
boolean readable = true
for (int k = 1; k &lt;= 18; k++) {
    def b = pickBuyer(k)
    String key = b.key
    boolean offerSide = key.startsWith(&apos;ob_&apos;)
    String reqId = (offerSide ? &apos;accept-&apos; : &apos;buy-&apos;) + b.no
    List row = [b.role, b.no, vars.get(&apos;id_&apos; + key), vars.get(&apos;conv_&apos; + key),
                offerSide ? vars.get(&apos;offer_&apos; + key) : &apos;-&apos;, offerSide ? vars.get(&apos;pre_offer_qty_&apos; + key) : &apos;0&apos;, offerSide ? vars.get(&apos;pre_offer_status_&apos; + key) : &apos;-&apos;,
                offerSide ? &apos;0&apos; : vars.get(&apos;csvqty_&apos; + key), offerSide ? &apos;-&apos; : vars.get(&apos;charge_&apos; + key), offerSide ? &apos;-&apos; : vars.get(&apos;pre_balance_&apos; + key),
                vars.get(&apos;pre_offer_count_&apos; + key), vars.get(&apos;pre_reservation_&apos; + key), vars.get(&apos;pre_order_count_&apos; + key), reqId]
    csv.append(row.join(&apos;,&apos;)).append(&apos;\n&apos;)
    if ((vars.get(&apos;conv_&apos; + key) ?: &apos;NOT_FOUND&apos;) != &apos;NOT_FOUND&apos;) conversations++
    if (offerSide) {
        if (vars.get(&apos;pre_offer_status_&apos; + key) == &apos;PENDING&apos;) pending++
        if ((vars.get(&apos;pre_offer_qty_&apos; + key) ?: &apos;&apos;).isLong()) offerQtySum += (vars.get(&apos;pre_offer_qty_&apos; + key) as long) else readable = false
    } else {
        if (vars.get(&apos;pre_balance_&apos; + key) == vars.get(&apos;charge_&apos; + key)) balanceMatches++
    }
    if ((vars.get(&apos;pre_offer_count_&apos; + key) ?: &apos;&apos;).isLong()) offers += (vars.get(&apos;pre_offer_count_&apos; + key) as long) else readable = false
    if (vars.get(&apos;pre_reservation_&apos; + key) != &apos;-&apos;) reservations++
    if ((vars.get(&apos;pre_order_count_&apos; + key) ?: &apos;&apos;).isLong()) orders += (vars.get(&apos;pre_order_count_&apos; + key) as long) else readable = false
    // 수락·결제 경합 그룹과 저장 상태 확인 그룹이 쓸 값을 속성에 넣는다. 로그인 토큰은 로그인 그룹이 속성에 넣는다.
    // 흥정 구매자의 요청 수량은 요청 전에 대화 상세로 읽은 제안 수량, 등록 가격 구매자의 요청 수량은 회원 CSV의 구매 수량이다.
    put(&apos;rsvbuy.buyer_&apos; + key, vars.get(&apos;id_&apos; + key))
    put(&apos;rsvbuy.conv_&apos; + key, vars.get(&apos;conv_&apos; + key))
    put(&apos;rsvbuy.qty_&apos; + key, offerSide ? vars.get(&apos;pre_offer_qty_&apos; + key) : vars.get(&apos;csvqty_&apos; + key))
    if (offerSide) put(&apos;rsvbuy.offer_&apos; + key, vars.get(&apos;offer_&apos; + key)) else put(&apos;rsvbuy.charge_&apos; + key, vars.get(&apos;charge_&apos; + key))
}
put(&apos;rsvbuy.product_id&apos;, vars.get(&apos;product_id&apos;))
put(&apos;rsvbuy.run_log_id&apos;, vars.get(&apos;run_log_id&apos;))
put(&apos;rsvbuy.test_log_name&apos;, URLEncoder.encode(vars.get(&apos;testLogName&apos;), &apos;UTF-8&apos;))
new File(vars.get(&apos;outDir&apos;), &apos;준비_ID와_요청전상태.csv&apos;).setText(csv.toString(), &apos;UTF-8&apos;)

boolean same = readable &amp;&amp; vars.get(&apos;pre_remaining&apos;) == String.valueOf(expectedQty) &amp;&amp; vars.get(&apos;pre_available&apos;) == String.valueOf(expectedQty) &amp;&amp;
        conversations == 18 &amp;&amp; pending == 9 &amp;&amp; offerQtySum == expectedOfferSum &amp;&amp; balanceMatches == 9 &amp;&amp; offers == 9 &amp;&amp; reservations == 0 &amp;&amp; orders == 0
String result = same ? &apos;기본 구성과 같음&apos; : &apos;기본 구성과 다름&apos;
List summary = [vars.get(&apos;product_id&apos;), vars.get(&apos;pre_remaining&apos;), vars.get(&apos;pre_available&apos;), conversations, pending, offerQtySum, balanceMatches, offers, reservations, orders, result]
new File(vars.get(&apos;outDir&apos;), &apos;준비_요청전상태_요약.csv&apos;).setText(
        &apos;﻿product_id,remaining_quantity,available_quantity,conversation_count,pending_offer_count,offer_quantity_sum,balance_match_count,offer_count,reservation_count,order_count,check_result\n&apos; +
        summary.join(&apos;,&apos;) + &apos;\n&apos;, &apos;UTF-8&apos;)
SampleResult.setSuccessful(same)
SampleResult.setResponseMessage(&apos;요청 전 상태: &apos; + result)
SampleResult.setResponseData(&apos;상품ID=&apos; + vars.get(&apos;product_id&apos;) + &apos;, 남은 수량=&apos; + vars.get(&apos;pre_remaining&apos;) + &apos;, 판매자가 본 구매 가능 수량=&apos; + vars.get(&apos;pre_available&apos;) +
        &apos;, 대화=&apos; + conversations + &apos;건, 응답 대기 제안=&apos; + pending + &apos;건, 제안 수량 합계=&apos; + offerQtySum + &apos;개, 잔액이 결제 금액과 같은 등록 가격 구매자=&apos; + balanceMatches +
        &apos;명, 가격 제안=&apos; + offers + &apos;건, 예약=&apos; + reservations + &apos;건, 주문=&apos; + orders + &apos;건, 확인 결과=&apos; + result + &apos;, 실행ID=&apos; + vars.get(&apos;run_log_id&apos;), &apos;UTF-8&apos;)
</stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="수락·결제 경합: 가격 제안 수락 9건과 등록 가격 결제 9건을 같은 순간에 보냄" enabled="true">
        <stringProp name="TestPlan.comments">스레드 18개가 각각 요청 하나를 맡는다. 스레드 1~9는 흥정 구매자 01~09의 가격 제안 수락을, 스레드 10~18은 등록 가격 구매자 01~09의 결제를 보낸다. 동기화 타이머로 18개 요청을 같은 순간에 보낸다. 요청을 같은 순간에 보냈다는 사실만으로 서버의 수량 확인과 저장이 겹쳤다고 보지 않고, 서버 로그로 확인한다.</stringProp>
        <intProp name="ThreadGroup.num_threads">18</intProp>
        <intProp name="ThreadGroup.ramp_time">0</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
