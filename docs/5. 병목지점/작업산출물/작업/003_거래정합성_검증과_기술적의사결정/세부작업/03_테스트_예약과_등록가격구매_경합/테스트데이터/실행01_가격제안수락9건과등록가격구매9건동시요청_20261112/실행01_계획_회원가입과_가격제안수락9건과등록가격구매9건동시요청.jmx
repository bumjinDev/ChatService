      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="준비: 충전 9건" enabled="true">
        <stringProp name="TestPlan.comments">등록 가격 구매자마다 결제 금액만큼 충전한다. 흥정 구매자는 충전하지 않는다. 같은 회원에게 이 그룹을 다시 실행하면 잔액이 결제 금액보다 많아지므로, 이미 결제 금액만큼 충전한 회원으로 상품을 다시 준비할 때는 이 그룹을 실행하지 않는다.</stringProp>
        <intProp name="ThreadGroup.num_threads">1</intProp>
