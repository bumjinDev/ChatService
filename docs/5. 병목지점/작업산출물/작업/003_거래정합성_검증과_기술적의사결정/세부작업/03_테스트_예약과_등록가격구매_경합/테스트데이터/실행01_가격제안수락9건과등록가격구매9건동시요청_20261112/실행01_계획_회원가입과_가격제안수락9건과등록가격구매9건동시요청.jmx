          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="스레드 번호로 결제할 등록 가격 구매자 정하기" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">// 이 스레드가 결제할 등록 가격 구매자를 스레드 번호로 정한다. 스레드 10은 등록 가격 구매자 01이, 스레드 18은 등록 가격 구매자 09가 결제한다.
int n = ctx.getThreadNum() - 8
String no = String.format(&apos;%02d&apos;, n)
vars.put(&apos;cur_no&apos;, no)
vars.put(&apos;cur_qty&apos;, (props.get(&apos;rsvbuy.qty_lb_&apos; + n) ?: &apos;&apos;) as String)
vars.put(&apos;cur_token&apos;, (props.get(&apos;rsvbuy.token_lb_&apos; + n) ?: &apos;&apos;) as String)
vars.put(&apos;product_id&apos;, (props.get(&apos;rsvbuy.product_id&apos;) ?: &apos;NOT_FOUND&apos;) as String)
vars.put(&apos;run_log_id&apos;, (props.get(&apos;rsvbuy.run_log_id&apos;) ?: &apos;&apos;) as String)
