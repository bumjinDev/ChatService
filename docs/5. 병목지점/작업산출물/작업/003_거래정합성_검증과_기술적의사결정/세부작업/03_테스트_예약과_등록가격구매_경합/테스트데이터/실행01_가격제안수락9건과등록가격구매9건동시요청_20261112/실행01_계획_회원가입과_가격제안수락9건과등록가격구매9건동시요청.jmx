          </HTTPSamplerProxy>
          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="이번 반복의 등록 가격 구매자 정하기" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">// 이번 반복에서 잔액을 조회할 등록 가격 구매자를 정한다. 로그인 토큰은 로그인 그룹이 넣은 속성에서 읽는다.
int n = (vars.get(&apos;wallet_index&apos;) as int) + 1
vars.put(&apos;wallet_index&apos;, String.valueOf(n))
vars.put(&apos;cur_key&apos;, &apos;lb_&apos; + n)
vars.put(&apos;cur_no&apos;, String.format(&apos;%02d&apos;, n))
vars.put(&apos;cur_token&apos;, (props.get(&apos;rsvbuy.token_lb_&apos; + n) ?: &apos;NOT_FOUND&apos;) as String)
</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
            <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="등록 가격 구매자 로그인 쿠키" enabled="true">
              <collectionProp name="HeaderManager.headers">
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">Cookie</stringProp>
                  <stringProp name="Header.value">Authorization=${cur_token}</stringProp>
                </elementProp>
