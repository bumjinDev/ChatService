          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="이번 반복의 흥정 구매자 정하기" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">// 이번 반복에서 가격 제안을 등록할 흥정 구매자를 정한다. 제안 수량은 회원 CSV의 제안 수량이다.
int n = (vars.get(&apos;offer_index&apos;) as int) + 1
vars.put(&apos;offer_index&apos;, String.valueOf(n))
String key = &apos;ob_&apos; + n
vars.put(&apos;cur_key&apos;, key)
vars.put(&apos;cur_no&apos;, String.format(&apos;%02d&apos;, n))
vars.put(&apos;cur_token&apos;, (props.get(&apos;rsvbuy.token_&apos; + key) ?: &apos;NOT_FOUND&apos;) as String)
vars.put(&apos;cur_conv&apos;, (props.get(&apos;rsvbuy.conv_&apos; + key) ?: &apos;NOT_FOUND&apos;) as String)
vars.put(&apos;cur_qty&apos;, vars.get(&apos;csvqty_&apos; + key))
</stringProp>
            </JSR223PreProcessor>
