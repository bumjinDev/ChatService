        <LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="구매자 18명마다 판매자의 대화 상세 조회(경합 뒤)" enabled="true">
          <stringProp name="LoopController.loops">18</stringProp>
          <boolProp name="LoopController.continue_forever">true</boolProp>
        </LoopController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="판매자의 ${cur_role} ${cur_no} 대화 상세 조회(경합 뒤)" enabled="true">
            <stringProp name="TestPlan.comments">판매자가 이 구매자의 대화 상세를 조회해 저장된 가격 제안 상태, 예약, 주문과 상품의 남은 수량·판매 상태를 확인한다. 판매 종료 상품도 조회된다.</stringProp>
            <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
            <stringProp name="HTTPSampler.path">/ChatService/api/conversations/${cur_conv}</stringProp>
            <stringProp name="HTTPSampler.method">GET</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
              <collectionProp name="Arguments.arguments"/>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="이번 반복의 구매자 정하기" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">def pickBuyer = { int k -&gt;
    boolean offerSide = k &lt;= 9
    int n = offerSide ? k : k - 9
    [key: (offerSide ? &apos;ob_&apos; : &apos;lb_&apos;) + n, role: offerSide ? &apos;흥정 구매자&apos; : &apos;등록 가격 구매자&apos;,
     fileRole: offerSide ? &apos;흥정구매자&apos; : &apos;등록가격구매자&apos;, no: String.format(&apos;%02d&apos;, n)]
}

// 이번 반복에서 판매자가 대화 상세를 조회할 구매자를 정한다. 반복 1~9는 흥정 구매자 01~09, 반복 10~18은 등록 가격 구매자 01~09다.
int k = (vars.get(&apos;check_index&apos;) as int) + 1
vars.put(&apos;check_index&apos;, String.valueOf(k))
def b = pickBuyer(k)
vars.put(&apos;cur_key&apos;, b.key)
vars.put(&apos;cur_role&apos;, b.role)
vars.put(&apos;cur_file_role&apos;, b.fileRole)
vars.put(&apos;cur_no&apos;, b.no)
vars.put(&apos;cur_conv&apos;, (props.get(&apos;rsvbuy.conv_&apos; + b.key) ?: &apos;NOT_FOUND&apos;) as String)
</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
            <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="판매자 로그인 쿠키" enabled="true">
              <collectionProp name="HeaderManager.headers">
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">Cookie</stringProp>
                  <stringProp name="Header.value">Authorization=${seller_token}</stringProp>
                </elementProp>
              </collectionProp>
            </HeaderManager>
            <hashTree/>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="응답 코드 200" enabled="true">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="49586">200</stringProp>
              </collectionProp>
              <stringProp name="Assertion.custom_message"></stringProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">8</intProp>
            </ResponseAssertion>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="가격 제안, 예약, 주문, 상품의 남은 수량·판매 상태를 속성에 넣고 응답 본문 저장(실행 폴더의 종료후_역할번호_대화상세응답.json)" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
// 경합 뒤 판매자가 본 대화 상세에서 가격 제안, 예약, 주문, 상품의 남은 수량·판매 상태를 속성에 넣고, 응답 본문을 실행 폴더에 저장한다.
String key = vars.get(&apos;cur_key&apos;)
String body = prev.getResponseDataAsString()
new File(vars.get(&apos;outDir&apos;), &apos;종료후_&apos; + vars.get(&apos;cur_file_role&apos;) + vars.get(&apos;cur_no&apos;) + &apos;_대화상세응답.json&apos;).setText(body, &apos;UTF-8&apos;)
def put = { String name, Object value -&gt; props.put(&apos;rsvbuy.post_&apos; + name + &apos;_&apos; + key, value == null ? &apos;-&apos; : String.valueOf(value)) }
try {
    def j = new JsonSlurper().parseText(body)
    if (!(j instanceof Map) || j.product == null) throw new IllegalStateException(&apos;대화 상세 응답이 아님&apos;)
    if (key.startsWith(&apos;ob_&apos;)) {
        def offer = j.offers?.find { String.valueOf(it.offerId) == props.get(&apos;rsvbuy.offer_&apos; + key) }
        put(&apos;offer_status&apos;, offer ? offer.status : &apos;없음&apos;)
        put(&apos;offer_qty&apos;, offer ? offer.quantity : &apos;없음&apos;)
    }
    def r = j.reservation
    put(&apos;res_id&apos;, r ? r.reservationId : &apos;-&apos;)
    put(&apos;res_offer&apos;, r ? r.offerId : &apos;-&apos;)
    put(&apos;res_product&apos;, r ? r.productId : &apos;-&apos;)
    put(&apos;res_conv&apos;, r ? r.conversationId : &apos;-&apos;)
    put(&apos;res_qty&apos;, r ? r.quantity : &apos;-&apos;)
    put(&apos;res_status&apos;, r ? r.status : &apos;-&apos;)
    put(&apos;res_expires&apos;, r ? r.expiresAt : &apos;-&apos;)
    List orders = (j.orders ?: []) as List
    put(&apos;order_count&apos;, orders.size())
    put(&apos;order_id&apos;, orders ? orders.collect { String.valueOf(it.orderId) }.join(&apos;·&apos;) : &apos;-&apos;)
    put(&apos;order_qty&apos;, orders ? orders.collect { (it.quantity ?: 0) as long }.sum() : &apos;-&apos;)
    put(&apos;order_paid&apos;, orders ? orders.collect { (it.paidAmount ?: 0) as long }.sum() : &apos;-&apos;)
    put(&apos;order_status&apos;, orders ? orders.collect { String.valueOf(it.tradeStatus) }.join(&apos;·&apos;) : &apos;-&apos;)
    put(&apos;remaining&apos;, j.product.remainingQuantity)
    put(&apos;status&apos;, j.product.status)
    put(&apos;read&apos;, &apos;Y&apos;)
} catch (Exception e) {
    put(&apos;read&apos;, &apos;N&apos;)
}
</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>
        </hashTree>
        <LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="등록 가격 구매자 9명마다 잔액 조회(경합 뒤)" enabled="true">
