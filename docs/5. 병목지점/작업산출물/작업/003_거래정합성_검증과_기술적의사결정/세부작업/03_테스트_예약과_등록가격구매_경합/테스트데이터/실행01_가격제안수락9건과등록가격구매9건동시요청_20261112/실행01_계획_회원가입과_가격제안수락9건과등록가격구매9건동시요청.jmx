            <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="대화 ID 꺼내기(변수 cur_conv에)" enabled="true">
              <stringProp name="JSONPostProcessor.referenceNames">cur_conv</stringProp>
              <stringProp name="JSONPostProcessor.jsonPathExprs">$.conversationId</stringProp>
              <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
              <stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND</stringProp>
            </JSONPostProcessor>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="대화 ID를 역할·번호별 속성에 넣기" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">// 이 구매자의 대화 ID를 역할·번호별 속성에 넣는다. 「준비: 가격 제안 등록 9건」, 「준비: 요청 전 상태 확인」, 저장 상태 확인 그룹이 이 속성을 읽는다.
props.put(&apos;rsvbuy.conv_&apos; + vars.get(&apos;cur_key&apos;), vars.get(&apos;cur_conv&apos;) ?: &apos;NOT_FOUND&apos;)
</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>
        </hashTree>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="준비: 가격 제안 등록 9건" enabled="true">
        <stringProp name="TestPlan.comments">흥정 구매자마다 자기 대화에 가격 제안을 하나 등록하고, 제안 ID를 JMeter 속성에 넣는다. 같은 대화에 응답 대기 제안이 이미 있으면 새 제안은 409로 거절되므로, 이 그룹을 다시 실행하려면 「준비: 상품 등록」부터 다시 실행한다.</stringProp>
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">0</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="회원 CSV에서 흥정 구매자 9명의 제안 수량 읽기, 로그인 토큰과 대화 ID 확인" enabled="true">
          <stringProp name="TestPlan.comments">회원 CSV에서 이 실행 번호의 흥정 구매자 9명의 제안 수량을 읽고, 로그인 토큰과 「준비: 대화 시작 18건」 그룹이 넣은 대화 ID가 있는지 확인한다. 하나라도 없으면 가격 제안을 등록하지 않고 이 그룹을 멈춘다.</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">// 회원 CSV에서 run_id가 runId와 같은 줄을 모두 읽는다. 엑셀로 저장하면 「01」이 「1」로 바뀌므로 숫자로 비교한다.
String runId = vars.get(&apos;runId&apos;)
def sameRun = { String v -&gt; (v != null &amp;&amp; v.isInteger() &amp;&amp; runId.isInteger()) ? (v as int) == (runId as int) : v == runId }
List&lt;String&gt; lines = new File(vars.get(&apos;memberFile&apos;)).readLines(&apos;UTF-8&apos;)
List&lt;String&gt; cols = (lines[0].replace(&apos;﻿&apos;, &apos;&apos;).trim().split(&apos;,&apos;) as List)
List&lt;Map&lt;String, String&gt;&gt; rows = []
for (String line : lines.drop(1)) {
    if (line.trim().isEmpty()) continue
    List&lt;String&gt; vals = (line.trim().split(&apos;,&apos;, -1) as List)
    Map&lt;String, String&gt; row = [:]
    for (int i = 0; i &lt; cols.size(); i++) { row[cols[i]] = vals[i] }
    if (sameRun(row[&apos;run_id&apos;])) rows &lt;&lt; row
}
Map&lt;String, String&gt; seller = rows.find { it[&apos;role&apos;] == &apos;판매자&apos; }
List&lt;Map&lt;String, String&gt;&gt; offerBuyers = rows.findAll { it[&apos;role&apos;] == &apos;흥정 구매자&apos; }.sort { it[&apos;buyer_no&apos;] as int }
List&lt;Map&lt;String, String&gt;&gt; listedBuyers = rows.findAll { it[&apos;role&apos;] == &apos;등록 가격 구매자&apos; }.sort { it[&apos;buyer_no&apos;] as int }
if (seller == null || offerBuyers.size() != 9 || listedBuyers.size() != 9) {
    throw new IllegalStateException(&apos;회원 CSV에 실행 번호 &apos; + runId + &apos;의 판매자 1명, 흥정 구매자 9명, 등록 가격 구매자 9명이 없습니다. 판매자 &apos; +
            (seller == null ? 0 : 1) + &apos;명, 흥정 구매자 &apos; + offerBuyers.size() + &apos;명, 등록 가격 구매자 &apos; + listedBuyers.size() + &apos;명&apos;)
}
vars.put(&apos;seller_id&apos;, seller[&apos;member_id&apos;])
vars.put(&apos;seller_pw&apos;, seller[&apos;password&apos;])
// 흥정 구매자는 「ob_번호」, 등록 가격 구매자는 「lb_번호」 열쇠로 변수에 넣는다. 흥정 구매자의 수량은 제안 수량, 등록 가격 구매자의 수량은 구매 수량이다.
offerBuyers.eachWithIndex { b, idx -&gt;
    String key = &apos;ob_&apos; + (idx + 1)
    vars.put(&apos;id_&apos; + key, b[&apos;member_id&apos;])
    vars.put(&apos;pw_&apos; + key, b[&apos;password&apos;])
    vars.put(&apos;csvqty_&apos; + key, b[&apos;offer_quantity&apos;])
}
listedBuyers.eachWithIndex { b, idx -&gt;
    String key = &apos;lb_&apos; + (idx + 1)
    vars.put(&apos;id_&apos; + key, b[&apos;member_id&apos;])
    vars.put(&apos;pw_&apos; + key, b[&apos;password&apos;])
    vars.put(&apos;csvqty_&apos; + key, b[&apos;purchase_quantity&apos;])
}

def pickBuyer = { int k -&gt;
    boolean offerSide = k &lt;= 9
    int n = offerSide ? k : k - 9
    [key: (offerSide ? &apos;ob_&apos; : &apos;lb_&apos;) + n, role: offerSide ? &apos;흥정 구매자&apos; : &apos;등록 가격 구매자&apos;,
     fileRole: offerSide ? &apos;흥정구매자&apos; : &apos;등록가격구매자&apos;, no: String.format(&apos;%02d&apos;, n)]
}

// 로그인 그룹이 속성에 넣은 로그인 토큰을 읽는다. 하나라도 없으면 이 그룹의 요청을 보내지 않고 멈춘다.
String sellerToken = (props.get(&apos;rsvbuy.seller_token&apos;) ?: &apos;NOT_FOUND&apos;) as String
List&lt;String&gt; missing = []
if (sellerToken == &apos;NOT_FOUND&apos;) missing &lt;&lt; &apos;판매자&apos;
for (int k = 1; k &lt;= 18; k++) {
    def b = pickBuyer(k)
    if (((props.get(&apos;rsvbuy.token_&apos; + b.key) ?: &apos;NOT_FOUND&apos;) as String) == &apos;NOT_FOUND&apos;) missing &lt;&lt; (b.role + &apos; &apos; + b.no)
}
if (!missing.isEmpty()) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseMessage(&apos;로그인 토큰 없음: &apos; + missing.join(&apos;, &apos;) + &apos;. 같은 JMeter 창에서 「로그인」 그룹을 먼저 실행해야 한다&apos;)
    SampleResult.setStopThread(true)
    return
}
vars.put(&apos;seller_token&apos;, sellerToken)

// 「준비: 대화 시작 18건」 그룹이 넣은 흥정 구매자 9명의 대화 ID를 확인한다. 하나라도 없으면 가격 제안을 등록하지 않고 멈춘다.
List&lt;String&gt; noConv = (1..9).findAll { ((props.get(&apos;rsvbuy.conv_ob_&apos; + it) ?: &apos;NOT_FOUND&apos;) as String) == &apos;NOT_FOUND&apos; }.collect { &apos;흥정 구매자 &apos; + String.format(&apos;%02d&apos;, it) }
if (!noConv.isEmpty()) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseMessage(&apos;대화 ID 없음: &apos; + noConv.join(&apos;, &apos;) + &apos;. 같은 JMeter 창에서 「준비: 대화 시작 18건」 그룹을 먼저 실행해야 한다&apos;)
    SampleResult.setStopThread(true)
    return
}
// 이 그룹에서 새로 등록하는 가격 제안의 ID만 속성에 남도록, 이전에 넣은 제안 ID를 지운다.
props.keySet().findAll { it.toString().startsWith(&apos;rsvbuy.offer_&apos;) }.each { props.remove(it) }
vars.put(&apos;offer_index&apos;, &apos;0&apos;)
SampleResult.setResponseData(&apos;runId=&apos; + runId + &apos;, 흥정 구매자=&apos; + offerBuyers.size() + &apos;명&apos;, &apos;UTF-8&apos;)
</stringProp>
        </JSR223Sampler>
        <hashTree/>
        <LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="흥정 구매자 9명마다 가격 제안 등록">
          <stringProp name="TestPlan.comments">회원 CSV의 흥정 구매자 순서대로 9번 반복한다. 반복마다 흥정 구매자 한 명이 가격 제안을 하나 등록한다.</stringProp>
          <stringProp name="LoopController.loops">9</stringProp>
          <boolProp name="LoopController.continue_forever">true</boolProp>
        </LoopController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="흥정 구매자 ${cur_no}의 가격 제안(${cur_qty}개, 개당 9,000원)">
            <stringProp name="TestPlan.comments">흥정 구매자가 회원 CSV의 제안 수량을 개당 9,000원에 사겠다고 판매자에게 제안한다. 이 제안은 응답 대기로 남는다.</stringProp>
            <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
            <stringProp name="HTTPSampler.path">/ChatService/api/conversations/${cur_conv}/offers</stringProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">{&quot;amount&quot;:${offerAmount},&quot;quantity&quot;:${cur_qty},&quot;requestId&quot;:&quot;${__UUID()}&quot;}</stringProp>
