        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="등록 가격 구매자 ${cur_no} 등록 가격 결제(${cur_qty}개)">
            <stringProp name="TestPlan.comments">이 스레드에 정해진 등록 가격 구매자가 가격 제안 없이 등록 가격으로 구매 수량만큼 결제한다. 결제가 성공하면 주문이 저장되고 잔액과 남은 수량이 줄어든다. 요청 헤더에 서버 로그의 테스트명, 실행 ID, 요청 ID를 담는다. 수량 부족으로 거절되거나 응답을 받지 못해도 다시 보내지 않는다.</stringProp>
            <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
