new File(vars.get(&apos;outDir&apos;), &apos;준비_등록가격구매자&apos; + vars.get(&apos;cur_no&apos;) + &apos;_충전응답.json&apos;).setText(prev.getResponseDataAsString(), &apos;UTF-8&apos;)
</stringProp>
