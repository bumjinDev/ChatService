        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="판매자의 흥정 구매자 ${cur_no} 가격 제안 수락(${cur_qty}개 예약)">
            <stringProp name="TestPlan.comments">판매자가 이 스레드에 정해진 흥정 구매자의 가격 제안을 수락한다. 수락과 함께 그 제안 수량만큼 예약이 만들어진다. 요청 헤더에 서버 로그의 테스트명, 실행 ID, 요청 ID를 담는다. 수량 부족으로 거절되거나 응답을 받지 못해도 다시 보내지 않는다.</stringProp>
            <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
            <stringProp name="HTTPSampler.path">/ChatService/api/offers/${cur_offer}/accept</stringProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
              <collectionProp name="Arguments.arguments"/>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="스레드 번호로 수락할 가격 제안 정하기" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">// 이 스레드가 수락할 가격 제안을 스레드 번호로 정한다. 스레드 1은 흥정 구매자 01의 제안을, 스레드 9는 흥정 구매자 09의 제안을 수락한다.
int n = ctx.getThreadNum() + 1
String no = String.format(&apos;%02d&apos;, n)
vars.put(&apos;cur_no&apos;, no)
vars.put(&apos;cur_offer&apos;, (props.get(&apos;rsvbuy.offer_ob_&apos; + n) ?: &apos;NOT_FOUND&apos;) as String)
vars.put(&apos;cur_qty&apos;, (props.get(&apos;rsvbuy.qty_ob_&apos; + n) ?: &apos;&apos;) as String)
vars.put(&apos;seller_token&apos;, (props.get(&apos;rsvbuy.seller_token&apos;) ?: &apos;&apos;) as String)
vars.put(&apos;run_log_id&apos;, (props.get(&apos;rsvbuy.run_log_id&apos;) ?: &apos;&apos;) as String)
vars.put(&apos;test_log_name&apos;, (props.get(&apos;rsvbuy.test_log_name&apos;) ?: &apos;&apos;) as String)
vars.put(&apos;req_log_id&apos;, &apos;accept-&apos; + no)
</stringProp>
            </JSR223PreProcessor>
