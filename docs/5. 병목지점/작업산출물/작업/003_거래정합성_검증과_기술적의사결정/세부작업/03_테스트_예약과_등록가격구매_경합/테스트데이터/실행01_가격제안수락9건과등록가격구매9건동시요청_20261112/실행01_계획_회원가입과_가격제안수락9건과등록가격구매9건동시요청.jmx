              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">{&quot;amount&quot;:${cur_charge},&quot;requestId&quot;:&quot;${__UUID()}&quot;}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="이번 반복의 등록 가격 구매자 정하기" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">// 이번 반복에서 충전할 등록 가격 구매자를 정한다. 충전 금액은 등록 가격 × 구매 수량(결제 금액)이다.
int n = (vars.get(&apos;charge_index&apos;) as int) + 1
vars.put(&apos;charge_index&apos;, String.valueOf(n))
String key = &apos;lb_&apos; + n
vars.put(&apos;cur_no&apos;, String.format(&apos;%02d&apos;, n))
vars.put(&apos;cur_token&apos;, (props.get(&apos;rsvbuy.token_&apos; + key) ?: &apos;NOT_FOUND&apos;) as String)
vars.put(&apos;cur_charge&apos;, String.valueOf((vars.get(&apos;productPrice&apos;) as long) * (vars.get(&apos;csvqty_&apos; + key) as long)))
</stringProp>
            </JSR223PreProcessor>
