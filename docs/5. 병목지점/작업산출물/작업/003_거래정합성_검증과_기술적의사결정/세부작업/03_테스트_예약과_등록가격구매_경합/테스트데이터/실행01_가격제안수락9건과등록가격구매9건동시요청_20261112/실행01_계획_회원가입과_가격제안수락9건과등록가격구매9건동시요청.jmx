vars.put(&apos;req_log_id&apos;, &apos;buy-&apos; + no)
</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
            <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="JSON 헤더, 등록 가격 구매자 로그인 쿠키, 서버 로그용 테스트명·실행 ID·요청 ID" enabled="true">
              <collectionProp name="HeaderManager.headers">
                <elementProp name="" elementType="Header">
