            <hashTree/>
            <ResultSaver guiclass="ResultSaverGui" testclass="ResultSaver" testname="응답 본문 저장(실행 폴더의 A_발송등록응답)" enabled="true">
              <stringProp name="FileSaver.filename">${outDir}\A_발송등록응답</stringProp>
