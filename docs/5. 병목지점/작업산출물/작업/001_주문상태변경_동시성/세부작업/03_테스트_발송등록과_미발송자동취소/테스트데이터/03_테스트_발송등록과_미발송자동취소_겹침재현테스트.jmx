                  <stringProp name="Argument.value">{&quot;carrierName&quot;:&quot;${carrier_name}&quot;,&quot;trackingNumber&quot;:&quot;${tracking_number}&quot;,&quot;requestId&quot;:&quot;${__UUID()}&quot;}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
