<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="S1-3 겹침 재현 테스트">
      <stringProp name="TestPlan.comments">작업명세 04의 「4. 겹침 재현 테스트」. 항목(스레드 그룹)을 하나씩 오른쪽 클릭 → Start로 실행한다. 초록 실행 버튼은 쓰지 않는다. 계획 전체가 실행되어 주문 만들기와 테스트가 모두 다시 실행된다.
- 1. 로그인: 회원 가입 결과 CSV(joinResultFile)의 테스트케이스2·3 판매자·구매자로 로그인하고, 로그인 토큰을 테스트케이스별 파일(테스트데이터 폴더의 …_테스트케이스N_로그인토큰.csv)에 쓴다. 토큰은 1시간 뒤 만료된다.
- 테스트케이스N 주문 만들기: 처리 기준 시각을 사전 준비 시각(테스트 데이터 CSV의 prepare_instant)으로 고정한 뒤, 그 테스트케이스의 로그인 토큰으로 상품 등록, 충전, 결제를 하고 고정을 푼다. 테스트케이스마다 한 번만 실행한다.
- 테스트케이스N 테스트: 스레드 1이 처리 기준 시각을 발송 기한 0.5초 전(CSV의 test_instant)으로 고정한 뒤 요청 A(발송 등록)를 보내고, 스레드 2가 요청 B(미발송 자동 취소, now는 CSV의 unshipped_cancel_now)를 보내며, 스레드 3(재개 제어)이 CSV의 first_resume 순서로 재개한 뒤 고정을 푼다.
테스트케이스N 주문 만들기와 테스트케이스N 테스트는 결과를 outDir 폴더에 남긴다. 실행마다 outDir을 그 실행의 폴더로 바꾼다.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments">
          <elementProp name="dataDir" elementType="Argument">
            <stringProp name="Argument.name">dataDir</stringProp>
            <stringProp name="Argument.value">E:\devSpace\SpringBootProjects\ChatService\docs\5. 병목지점\작업산출물\작업\001_주문상태변경_동시성\세부작업\03_테스트_발송등록과_미발송자동취소\테스트데이터</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">테스트 데이터 CSV, 회원 가입 결과 CSV, 로그인 토큰 파일이 있는 폴더</stringProp>
          </elementProp>
          <elementProp name="joinResultFile" elementType="Argument">
            <stringProp name="Argument.name">joinResultFile</stringProp>
            <stringProp name="Argument.value">E:\devSpace\SpringBootProjects\ChatService\docs\5. 병목지점\작업산출물\작업\001_주문상태변경_동시성\세부작업\03_테스트_발송등록과_미발송자동취소\테스트데이터\03_테스트_발송등록과_미발송자동취소_회원가입결과.csv</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">회원 가입 jmx가 만든 가입 결과 CSV</stringProp>
          </elementProp>
          <elementProp name="outDir" elementType="Argument">
            <stringProp name="Argument.name">outDir</stringProp>
            <stringProp name="Argument.value">E:\devSpace\SpringBootProjects\ChatService\docs\5. 병목지점\작업산출물\작업\001_주문상태변경_동시성\세부작업\03_테스트_발송등록과_미발송자동취소\실행결과_원본\실행01_테스트케이스2_지갑조회직후중지_자동취소먼저_20261022</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">이번 실행의 결과를 남길 실행 폴더 전체 경로. 실행마다 그 실행의 폴더로 바꾼다</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
