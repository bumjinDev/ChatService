<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="S1-2 테스트케이스2 이후 자동 처리">
      <stringProp name="TestPlan.comments">작업명세 03 「4.3 예상 결과(가설)」 표 아래의 「구매자 취소가 먼저 커밋된 경우」를 확인하는 계획이다. 테스트케이스2(실행02)의 주문을 모의 배송 완료와 확인 기간 만료 자동 완료까지 진행한다. 항목(스레드 그룹)을 하나씩 오른쪽 클릭 → Start로 실행한다.
- 1. 로그인: 테스트케이스2 회원 CSV(memberFile)의 판매자·구매자로 로그인하고, 로그인 토큰을 테스트데이터 폴더의 …_테스트케이스2_로그인토큰.csv에 쓴다. 토큰은 1시간 뒤 만료된다.
- 2. 이후 자동 처리: 테스트 지원 API로 모의 배송 완료를 실행하고, 주문 조회 응답의 상품 확인 기한을 now로 넣어 확인 기간 만료 자동 완료를 실행한 뒤, 판매자와 구매자가 최종 주문을 조회한다. 한 번만 실행한다.
2는 결과를 outDir 폴더(실행03 원본 폴더)에 남긴다.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments">
          <elementProp name="dataDir" elementType="Argument">
            <stringProp name="Argument.name">dataDir</stringProp>
            <stringProp name="Argument.value">E:\devSpace\SpringBootProjects\ChatService\docs\5. 병목지점\작업산출물\작업\001_주문상태변경_동시성\세부작업\02_테스트_발송등록과_구매자취소\테스트데이터</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">테스트 데이터 CSV, 회원 가입 결과 CSV, 로그인 토큰 파일이 있는 폴더</stringProp>
          </elementProp>
          <elementProp name="memberFile" elementType="Argument">
            <stringProp name="Argument.name">memberFile</stringProp>
            <stringProp name="Argument.value">E:\devSpace\SpringBootProjects\ChatService\docs\5. 병목지점\작업산출물\작업\001_주문상태변경_동시성\세부작업\02_테스트_발송등록과_구매자취소\테스트데이터\02_테스트_발송등록과_구매자취소_테스트케이스2_회원.csv</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">테스트케이스2 판매자·구매자의 회원 정보 CSV. 회원 가입 jmx가 가입할 때 읽은 파일이다</stringProp>
          </elementProp>
          <elementProp name="outDir" elementType="Argument">
            <stringProp name="Argument.name">outDir</stringProp>
            <stringProp name="Argument.value">E:\devSpace\SpringBootProjects\ChatService\docs\5. 병목지점\작업산출물\작업\001_주문상태변경_동시성\세부작업\02_테스트_발송등록과_구매자취소\실행결과_원본\실행03_테스트케이스2_모의배송완료와확인기간만료자동완료_20261020</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">이번 실행(실행03)의 결과를 남길 실행 폴더 전체 경로</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
