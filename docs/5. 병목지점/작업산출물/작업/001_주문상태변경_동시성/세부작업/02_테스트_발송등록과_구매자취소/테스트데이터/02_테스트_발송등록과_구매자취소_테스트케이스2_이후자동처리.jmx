          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="테스트케이스2 로그인 토큰 파일 쓰기" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">// 테스트케이스2의 판매자·구매자 로그인 토큰을 테스트케이스2 토큰 파일에 쓴다. 이전 토큰 파일은 덮어쓴다.
// 맨 앞의 \uFEFF는 엑셀이 UTF-8로 읽게 하는 표시(BOM)다.
File f = new File(vars.get(&apos;dataDir&apos;), &apos;02_테스트_발송등록과_구매자취소_테스트케이스2_로그인토큰.csv&apos;)
List row = [vars.get(&apos;seller_id&apos;), vars.get(&apos;seller_token&apos;), vars.get(&apos;buyer_id&apos;), vars.get(&apos;buyer_token&apos;)]
f.setText(&apos;\uFEFFseller_id,seller_token,buyer_id,buyer_token\n&apos; + row.join(&apos;,&apos;) + &apos;\n&apos;, &apos;UTF-8&apos;)</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
      </hashTree>
