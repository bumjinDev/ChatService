        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="C-3. 모의 배송 완료 실행">
          <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
