          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="가입 결과 CSV에 테스트케이스1 줄 쓰기" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters">테스트케이스1</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">// 가입 결과 CSV 끝에 이 테스트케이스의 줄을 붙인다. 테스트케이스 이름은 위 「파라미터」 칸의 값이다.
List row = [args[0],
            vars.get(&apos;seller_id&apos;), vars.get(&apos;seller_pw&apos;), vars.get(&apos;seller_join_code&apos;),
            vars.get(&apos;buyer_id&apos;), vars.get(&apos;buyer_pw&apos;), vars.get(&apos;buyer_join_code&apos;)]
new File(vars.get(&apos;joinResultFile&apos;)).append(row.join(&apos;,&apos;) + &apos;\n&apos;, &apos;UTF-8&apos;)
</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
      </hashTree>
