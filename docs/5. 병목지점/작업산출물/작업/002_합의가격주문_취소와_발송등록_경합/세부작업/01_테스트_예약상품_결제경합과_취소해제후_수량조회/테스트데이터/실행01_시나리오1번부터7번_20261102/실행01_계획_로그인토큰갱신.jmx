  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="세부 작업 01 실행 01: 로그인 토큰 갱신">
      <stringProp name="TestPlan.comments">네 회원으로 다시 로그인하고, 실행 폴더의 로그인토큰.csv를 새 토큰으로 다시 쓴다. 다른 요청은 보내지 않는다. 서버는 로그인 토큰을 30분 동안만 인정하므로, 토큰이 만료된 뒤 통합 계획의 그룹을 이어서 실행하기 전에 이 계획을 실행한다.</stringProp>
      <boolProp name="TestPlan.serialize_threadgroups">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments">
          <elementProp name="runId" elementType="Argument">
            <stringProp name="Argument.name">runId</stringProp>
            <stringProp name="Argument.value">01</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">실행 번호 두 자리. 회원 CSV의 run_id</stringProp>
          </elementProp>
          <elementProp name="outDir" elementType="Argument">
            <stringProp name="Argument.name">outDir</stringProp>
            <stringProp name="Argument.value">E:\devSpace\SpringBootProjects\ChatService\docs\5. 병목지점\작업산출물\작업\002_합의가격주문_취소와_발송등록_경합\세부작업\01_테스트_예약상품_결제경합과_취소해제후_수량조회\실행결과_원본\실행01_시나리오1번부터7번_20261102</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">이번 실행의 결과 폴더 전체 경로. 로그인토큰.csv를 이 폴더에 다시 쓴다</stringProp>
          </elementProp>
          <elementProp name="memberFile" elementType="Argument">
