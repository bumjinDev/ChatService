      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="회원 CSV에서 실행 번호의 회원 읽기" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">// 회원 CSV에서 run_id가 runId와 같은 줄을 찾아 네 회원의 ID와 비밀번호를 변수에 넣는다.
String runId = vars.get(&apos;runId&apos;)
File memberFile = new File(vars.get(&apos;memberFile&apos;))
List&lt;String&gt; lines = memberFile.readLines(&apos;UTF-8&apos;)
List&lt;String&gt; cols = (lines[0].replace(&apos;\uFEFF&apos;, &apos;&apos;).trim().split(&apos;,&apos;) as List)
Map&lt;String, String&gt; row = null
for (String line : lines.drop(1)) {
    if (line.trim().isEmpty()) continue
    List&lt;String&gt; vals = (line.trim().split(&apos;,&apos;, -1) as List)
    if (vals[cols.indexOf(&apos;run_id&apos;)] == runId) {
        row = [:]
        for (int i = 0; i &lt; cols.size(); i++) { row[cols[i]] = vals[i] }
        break
    }
}
if (row == null) throw new IllegalStateException(&apos;회원 CSV에 실행 번호 &apos; + runId + &apos;의 줄이 없습니다.&apos;)
[&apos;seller_id&apos;, &apos;cancel_buyer_id&apos;, &apos;listed_buyer_id&apos;, &apos;offer_buyer_id&apos;, &apos;password&apos;].each { vars.put(it, row[it]) }
</stringProp>
        </JSR223Sampler>
