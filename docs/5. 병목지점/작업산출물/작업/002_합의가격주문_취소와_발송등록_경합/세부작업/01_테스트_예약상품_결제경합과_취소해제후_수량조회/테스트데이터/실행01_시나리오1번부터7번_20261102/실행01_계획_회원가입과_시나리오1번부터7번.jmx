        <GenericController guiclass="LogicControllerGui" testclass="GenericController" testname="같은 순간에 출발하는 첫 요청(두 스레드가 모두 준비되면 함께 보냄)" enabled="true">
          <stringProp name="TestPlan.comments">추가 제안 구매자의 결제와 정가 구매자의 조회를 모은 묶음이다. 두 스레드가 이 묶음의 요청 직전에 모이면 두 요청을 함께 보낸다.</stringProp>
        </GenericController>
        <hashTree>
          <SyncTimer guiclass="TestBeanGUI" testclass="SyncTimer" testname="동기화 타이머(두 스레드, 최대 10초 대기)" enabled="true">
            <stringProp name="TestPlan.comments">두 스레드가 모두 요청 직전에 도착하면 두 요청을 같은 순간에 보낸다. 10초 안에 두 스레드가 모이지 않으면 더 기다리지 않고 보낸다.</stringProp>
            <intProp name="groupSize">2</intProp>
            <longProp name="timeoutInMs">10000</longProp>
          </SyncTimer>
          <hashTree/>
          <IfController guiclass="IfControllerPanel" testclass="IfController" testname="스레드 1: 추가 제안 구매자" enabled="true">
            <stringProp name="TestPlan.comments">스레드 1만 이 요청을 보낸다. 스레드 1은 추가 제안 구매자를 맡는다.</stringProp>
            <stringProp name="IfController.condition">${__jexl3(${__threadNum} == 1)}</stringProp>
            <boolProp name="IfController.evaluateAll">false</boolProp>
            <boolProp name="IfController.useExpression">true</boolProp>
          </IfController>
          <hashTree>
            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="추가 제안 구매자의 합의 가격 3개 결제" enabled="true">
              <stringProp name="TestPlan.comments">거래 시나리오 구성안 「6.2. 추가 제안 구매자의 3개 제안이 먼저 수락된 경우」. 추가 제안 구매자가 예약한 3개를 합의 가격 개당 110,000원으로 결제한다.</stringProp>
              <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
              <stringProp name="HTTPSampler.path">/ChatService/api/orders</stringProp>
              <stringProp name="HTTPSampler.method">POST</stringProp>
              <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
              <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
              <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
                <collectionProp name="Arguments.arguments">
                  <elementProp name="" elementType="HTTPArgument">
                    <boolProp name="HTTPArgument.always_encode">false</boolProp>
                    <stringProp name="Argument.value">{&quot;productId&quot;:${product_id},&quot;quantity&quot;:${offerQuantity},&quot;recipientName&quot;:&quot;추가 제안 구매자&quot;,&quot;shippingAddress&quot;:&quot;${shippingAddress}&quot;,&quot;offerId&quot;:${offer_offer},&quot;requestId&quot;:&quot;${__UUID()}&quot;}</stringProp>
                    <stringProp name="Argument.metadata">=</stringProp>
                  </elementProp>
                </collectionProp>
              </elementProp>
            </HTTPSamplerProxy>
            <hashTree>
              <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="JSON 헤더와 추가 제안 구매자 로그인 쿠키" enabled="true">
                <collectionProp name="HeaderManager.headers">
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">Content-Type</stringProp>
                    <stringProp name="Header.value">application/json</stringProp>
                  </elementProp>
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">Cookie</stringProp>
                    <stringProp name="Header.value">Authorization=${offer_token}</stringProp>
                  </elementProp>
                </collectionProp>
              </HeaderManager>
              <hashTree/>
              <ResultSaver guiclass="ResultSaverGui" testclass="ResultSaver" testname="응답 본문 저장(실행 폴더의 추가제안수락성공_6번_추가제안구매자_합의결제응답)" enabled="true">
                <stringProp name="FileSaver.filename">${outDir}\추가제안수락성공_6번_추가제안구매자_합의결제응답</stringProp>
                <boolProp name="FileSaver.errorsonly">false</boolProp>
                <boolProp name="FileSaver.successonly">false</boolProp>
                <boolProp name="FileSaver.skipautonumber">true</boolProp>
                <boolProp name="FileSaver.skipsuffix">false</boolProp>
              </ResultSaver>
              <hashTree/>
            </hashTree>
          </hashTree>
          <IfController guiclass="IfControllerPanel" testclass="IfController" testname="스레드 2: 정가 구매자" enabled="true">
            <stringProp name="TestPlan.comments">스레드 2만 이 요청을 보낸다. 스레드 2는 정가 구매자를 맡는다.</stringProp>
            <stringProp name="IfController.condition">${__jexl3(${__threadNum} == 2)}</stringProp>
            <boolProp name="IfController.evaluateAll">false</boolProp>
            <boolProp name="IfController.useExpression">true</boolProp>
          </IfController>
          <hashTree>
            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="정가 구매자의 상품 상세 조회" enabled="true">
              <stringProp name="TestPlan.comments">거래 시나리오 구성안 「6.2. 추가 제안 구매자의 3개 제안이 먼저 수락된 경우」. 정가 구매자가 앞서 사지 못한 2개를 지금 살 수 있는지 상품을 다시 조회한다. 응답의 구매 가능 수량을 결제 조건에 쓴다.</stringProp>
              <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
              <stringProp name="HTTPSampler.path">/ChatService/api/products/${product_id}</stringProp>
              <stringProp name="HTTPSampler.method">GET</stringProp>
              <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
              <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
              <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
                <collectionProp name="Arguments.arguments"/>
              </elementProp>
