        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="스레드 2: 정가 구매자의 조회 뒤 결제" enabled="true">
          <stringProp name="TestPlan.comments">스레드 2인 정가 구매자만, 상품 조회를 마친 뒤 이 묶음의 결제 요청을 보낸다.</stringProp>
          <stringProp name="IfController.condition">${__jexl3(${__threadNum} == 2)}</stringProp>
          <boolProp name="IfController.evaluateAll">false</boolProp>
          <boolProp name="IfController.useExpression">true</boolProp>
        </IfController>
        <hashTree>
          <IfController guiclass="IfControllerPanel" testclass="IfController" testname="구매 가능 수량이 2개 이상일 때만 결제(명세의 구매 계기)" enabled="true">
            <stringProp name="TestPlan.comments">거래 시나리오 구성안 「6.2. 추가 제안 구매자의 3개 제안이 먼저 수락된 경우」. 정가 구매자는 조회 결과에서 필요한 2개를 살 수 있다고 판단하면 결제를 요청한다. 앞 조회의 구매 가능 수량이 2개 이상일 때만 결제 요청을 보낸다.</stringProp>
            <stringProp name="IfController.condition">${__groovy(vars.get(&apos;listed_available&apos;)?.isInteger() &amp;&amp; vars.get(&apos;listed_available&apos;).toInteger() &gt;= vars.get(&apos;listedQuantity&apos;).toInteger(),)}</stringProp>
            <boolProp name="IfController.evaluateAll">false</boolProp>
            <boolProp name="IfController.useExpression">true</boolProp>
