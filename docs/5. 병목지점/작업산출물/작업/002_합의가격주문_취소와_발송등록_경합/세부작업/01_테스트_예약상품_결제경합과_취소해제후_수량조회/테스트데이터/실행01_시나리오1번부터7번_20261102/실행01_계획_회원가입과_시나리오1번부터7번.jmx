              <ResultSaver guiclass="ResultSaverGui" testclass="ResultSaver" testname="응답 본문 저장(실행 폴더의 정가결제성공_6번_추가제안구매자_등록가격결제응답)" enabled="true">
                <stringProp name="FileSaver.filename">${outDir}\정가결제성공_6번_추가제안구매자_등록가격결제응답</stringProp>
