        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="상품, 대화, 제안, 예약 ID와 처리 기준 시각 쓰기(실행 폴더의 준비단계_ID와_처리기준시각.csv)" enabled="true">
          <stringProp name="TestPlan.comments">처리 기준 시각과 상품, 대화, 제안, 예약 ID를 실행 폴더의 준비단계_ID와_처리기준시각.csv에 쓴다. 이 그룹 뒤에 실행하는 그룹들은 이 파일에서 ID를 읽는다.</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">// 시나리오 3번 이후 그룹이 읽을 준비 단계의 ID와 처리 기준 시각을 실행 폴더에 쓴다. 처리 기준 시각과 상품·대화·제안·예약 ID다.
File f = new File(vars.get(&apos;outDir&apos;), &apos;준비단계_ID와_처리기준시각.csv&apos;)
List&lt;String&gt; cols = [&apos;run_id&apos;, &apos;t0&apos;, &apos;product_id&apos;, &apos;conv_cancel&apos;, &apos;conv_listed&apos;, &apos;conv_offer&apos;, &apos;offer_cancel&apos;, &apos;offer_offer&apos;, &apos;reservation_cancel_1&apos;]
List&lt;String&gt; vals = [vars.get(&apos;runId&apos;), vars.get(&apos;t0&apos;), vars.get(&apos;product_id&apos;), vars.get(&apos;conv_cancel&apos;), vars.get(&apos;conv_listed&apos;), vars.get(&apos;conv_offer&apos;),
                     vars.get(&apos;offer_cancel&apos;), vars.get(&apos;offer_offer&apos;), vars.get(&apos;reservation_cancel_1&apos;)]
f.setText(&apos;\uFEFF&apos; + cols.join(&apos;,&apos;) + &apos;\n&apos; + vals.join(&apos;,&apos;) + &apos;\n&apos;, &apos;UTF-8&apos;)
SampleResult.setResponseData(cols.join(&apos;,&apos;) + &apos;\n&apos; + vals.join(&apos;,&apos;), &apos;UTF-8&apos;)
</stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="시나리오 2번: 결제와 수락 경합(세 요청을 같은 순간에 보냄)">
        <stringProp name="TestPlan.comments">거래 시나리오 구성안 「2. 두 구매자의 결제와 판매자의 제안 수락이 겹친다」. 주문 취소 구매자의 합의 가격 3개 결제, 정가 구매자의 등록 가격 2개 결제, 판매자의 추가 제안 3개 수락을 스레드 세 개가 같은 순간에 보낸다. 주문 취소 구매자에게 예약된 3개를 빼면 남은 4개에 정가 구매자의 2개 결제와 추가 제안 구매자의 3개 예약을 모두 허용할 수는 없다. 정가 구매자의 결제가 성공하면 정가 결제 성공 흐름으로, 판매자의 수락이 성공하면 추가 제안 수락 성공 흐름으로 이어진다.</stringProp>
        <intProp name="ThreadGroup.num_threads">3</intProp>
        <intProp name="ThreadGroup.ramp_time">0</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
