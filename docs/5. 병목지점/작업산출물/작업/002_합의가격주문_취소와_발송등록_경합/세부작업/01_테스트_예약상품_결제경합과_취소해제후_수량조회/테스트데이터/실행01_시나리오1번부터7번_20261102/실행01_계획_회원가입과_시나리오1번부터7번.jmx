        <GenericController guiclass="LogicControllerGui" testclass="GenericController" testname="ID 얻기(시나리오 요청이 아니라 다음 요청에 쓸 ID를 얻는 조회)">
          <stringProp name="TestPlan.comments">시나리오 참여자의 행동이 아니라, 다음 요청에 쓸 ID를 응답에서 얻는 조회를 모은 묶음이다.</stringProp>
