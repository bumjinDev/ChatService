              </collectionProp>
            </HeaderManager>
            <hashTree/>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="응답 코드 200" enabled="true">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="49586">200</stringProp>
              </collectionProp>
              <stringProp name="Assertion.custom_message"></stringProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">8</intProp>
            </ResponseAssertion>
            <hashTree/>
            <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="가장 최근 예약의 reservationId를 변수 reservation_cancel_2에 저장" enabled="true">
              <stringProp name="JSONPostProcessor.referenceNames">reservation_cancel_2</stringProp>
              <stringProp name="JSONPostProcessor.jsonPathExprs">$.reservation.reservationId</stringProp>
              <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
              <stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND</stringProp>
            </JSONPostProcessor>
            <hashTree/>
            <ResultSaver guiclass="ResultSaverGui" testclass="ResultSaver" testname="응답 본문 저장(실행 폴더의 추가제안수락성공_5번_ID얻기_주문취소구매자_대화상세응답)" enabled="true">
              <stringProp name="FileSaver.filename">${outDir}\추가제안수락성공_5번_ID얻기_주문취소구매자_대화상세응답</stringProp>
              <boolProp name="FileSaver.errorsonly">false</boolProp>
              <boolProp name="FileSaver.successonly">false</boolProp>
              <boolProp name="FileSaver.skipautonumber">true</boolProp>
              <boolProp name="FileSaver.skipsuffix">false</boolProp>
            </ResultSaver>
            <hashTree/>
          </hashTree>
