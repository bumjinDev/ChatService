        <hashTree/>
        <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="CSV 데이터 셋 설정(회원 CSV를 한 줄씩 읽기, 끝나면 멈춤)" enabled="true">
          <stringProp name="filename">${memberFile}</stringProp>
          <stringProp name="fileEncoding">UTF-8</stringProp>
          <stringProp name="variableNames">run_id,seller_id,cancel_buyer_id,listed_buyer_id,offer_buyer_id,password</stringProp>
          <boolProp name="ignoreFirstLine">true</boolProp>
          <stringProp name="delimiter">,</stringProp>
          <boolProp name="quotedData">true</boolProp>
          <boolProp name="recycle">false</boolProp>
          <boolProp name="stopThread">true</boolProp>
          <stringProp name="shareMode">shareMode.thread</stringProp>
        </CSVDataSet>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="실행 ${run_id} 판매자 가입" enabled="true">
          <stringProp name="TestPlan.comments">회원 CSV에 있는 이 실행의 판매자 ID와 비밀번호로 판매자 계정을 가입시킨다.</stringProp>
          <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
          <stringProp name="HTTPSampler.path">/ChatService/members/join</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{&quot;id&quot;:&quot;${seller_id}&quot;,&quot;pw&quot;:&quot;${password}&quot;,&quot;nickName&quot;:&quot;${seller_id}&quot;,&quot;tel&quot;:&quot;010-0000-0000&quot;,&quot;email&quot;:&quot;${seller_id}@example.com&quot;}</stringProp>
