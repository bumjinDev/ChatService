            <hashTree>
              <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="정가 구매자 로그인 쿠키" enabled="true">
                <collectionProp name="HeaderManager.headers">
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">Cookie</stringProp>
                    <stringProp name="Header.value">Authorization=${listed_token}</stringProp>
                  </elementProp>
                </collectionProp>
              </HeaderManager>
              <hashTree/>
              <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="구매 가능 수량(availableQuantity)을 변수 listed_available에 저장" enabled="true">
                <stringProp name="JSONPostProcessor.referenceNames">listed_available</stringProp>
                <stringProp name="JSONPostProcessor.jsonPathExprs">$.availableQuantity</stringProp>
                <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
                <stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND</stringProp>
              </JSONPostProcessor>
              <hashTree/>
              <ResultSaver guiclass="ResultSaverGui" testclass="ResultSaver" testname="응답 본문 저장(실행 폴더의 추가제안수락성공_6번_정가구매자_상품조회응답)" enabled="true">
                <stringProp name="FileSaver.filename">${outDir}\추가제안수락성공_6번_정가구매자_상품조회응답</stringProp>
                <boolProp name="FileSaver.errorsonly">false</boolProp>
                <boolProp name="FileSaver.successonly">false</boolProp>
                <boolProp name="FileSaver.skipautonumber">true</boolProp>
                <boolProp name="FileSaver.skipsuffix">false</boolProp>
              </ResultSaver>
              <hashTree/>
            </hashTree>
