        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="로그인 토큰 파일 쓰기(실행 폴더의 로그인토큰.csv)" enabled="true">
          <stringProp name="TestPlan.comments">네 회원의 로그인 토큰을 실행 폴더의 로그인토큰.csv에 쓴다. 이 그룹 뒤에 실행하는 그룹들은 로그인하지 않고 이 파일의 토큰을 읽는다. 서버는 로그인 확인 정보를 30분만 보관하므로, 마지막 로그인에서 30분이 지났으면 로그인 토큰 갱신 계획으로 이 파일을 다시 써야 한다.</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">// 네 회원의 로그인 토큰을 실행 폴더의 로그인토큰.csv에 쓴다. 같은 파일이 있으면 덮어쓴다. 맨 앞의 \uFEFF는 엑셀이 UTF-8로 읽게 하는 표시(BOM)다.
File f = new File(vars.get(&apos;outDir&apos;), &apos;로그인토큰.csv&apos;)
List&lt;String&gt; vals = [vars.get(&apos;seller_token&apos;), vars.get(&apos;cancel_token&apos;), vars.get(&apos;listed_token&apos;), vars.get(&apos;offer_token&apos;)]
f.setText(&apos;\uFEFFseller_token,cancel_token,listed_token,offer_token\n&apos; + vals.join(&apos;,&apos;) + &apos;\n&apos;, &apos;UTF-8&apos;)
SampleResult.setResponseData(&apos;로그인토큰.csv 저장: &apos; + f.getPath(), &apos;UTF-8&apos;)
</stringProp>
        </JSR223Sampler>
        <hashTree/>
