        </hashTree>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="시나리오 1번: 준비(처리 기준 시각 고정, 로그인, 충전, 상품 등록, 대화, 제안과 수락)" enabled="true">
        <stringProp name="TestPlan.comments">거래 시나리오 구성안 「1. 주문 취소 구매자가 3개를 예약하고 다른 구매자들도 구매를 준비한다」. 판매자가 모니터 7개를 개당 120,000원에 등록하고, 세 구매자가 각각 대화를 시작한다. 주문 취소 구매자가 3개를 개당 100,000원에 제안하고 판매자가 수락해, 주문 취소 구매자에게 3개가 예약된다. 추가 제안 구매자는 3개를 개당 110,000원에 제안하고 응답 대기로 둔다. 정가 구매자는 2개를 결제하기 전에 본인의 구매 가능 수량을 확인한다. 이 요청들 앞에 처리 기준 시각 고정, 네 회원의 로그인, 세 구매자의 600,000원 충전을 보낸다.</stringProp>
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">0</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="실행 폴더 만들기, 회원 CSV에서 실행 번호의 회원 읽기, 처리 기준 시각 정하기" enabled="true">
          <stringProp name="TestPlan.comments">실행 폴더를 만들고, 회원 CSV에서 이 실행 번호의 네 회원 ID와 비밀번호를 읽고, 지금 시각을 초 단위로 끊어 처리 기준 시각으로 정한다. 같은 JMeter 창에서 다시 실행할 때, 이전 실행에서 「시나리오 2번: 결제와 수락 경합(세 요청을 같은 순간에 보냄)」 그룹이 남긴 응답 코드와 이어갈 흐름 값, 지금은 쓰지 않는 동기화 값이 남지 않도록 지운다.</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">// 회원 CSV에서 run_id가 runId와 같은 줄을 찾아 네 회원의 ID와 비밀번호를 변수에 넣는다.
String runId = vars.get(&apos;runId&apos;)
File memberFile = new File(vars.get(&apos;memberFile&apos;))
List&lt;String&gt; lines = memberFile.readLines(&apos;UTF-8&apos;)
List&lt;String&gt; cols = (lines[0].replace(&apos;\uFEFF&apos;, &apos;&apos;).trim().split(&apos;,&apos;) as List)
Map&lt;String, String&gt; row = null
for (String line : lines.drop(1)) {
    if (line.trim().isEmpty()) continue
    List&lt;String&gt; vals = (line.trim().split(&apos;,&apos;, -1) as List)
    if (vals[cols.indexOf(&apos;run_id&apos;)] == runId) {
        row = [:]
        for (int i = 0; i &lt; cols.size(); i++) { row[cols[i]] = vals[i] }
        break
    }
}
if (row == null) throw new IllegalStateException(&apos;회원 CSV에 실행 번호 &apos; + runId + &apos;의 줄이 없습니다.&apos;)
[&apos;seller_id&apos;, &apos;cancel_buyer_id&apos;, &apos;listed_buyer_id&apos;, &apos;offer_buyer_id&apos;, &apos;password&apos;].each { vars.put(it, row[it]) }

// 같은 JMeter 창에서 다시 실행할 때 이전 실행의 2번 응답 코드, 흐름, 6번 공유 장벽이 남지 않도록 지운다.
[&apos;step2_cancel_code&apos;, &apos;step2_listed_code&apos;, &apos;step2_accept_code&apos;, &apos;flow&apos;, &apos;barrier_step6&apos;].each { props.remove(it) }
// 이번 실행의 결과를 남길 실행 폴더를 만든다. 이미 있으면 그대로 둔다.
new File(vars.get(&apos;outDir&apos;)).mkdirs()
// 처리 기준 시각: 지금 시각을 초 단위로 끊은 값. 바로 다음 요청이 서버의 처리 기준 시각을 이 값으로 고정한다.
String t0 = java.time.Instant.now().truncatedTo(java.time.temporal.ChronoUnit.SECONDS).toString()
vars.put(&apos;t0&apos;, t0)
SampleResult.setResponseData(&apos;runId=&apos; + runId + &apos;, t0=&apos; + t0 + &apos;, seller=&apos; + row[&apos;seller_id&apos;] + &apos;, outDir=&apos; + vars.get(&apos;outDir&apos;), &apos;UTF-8&apos;)
</stringProp>
        </JSR223Sampler>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="처리 기준 시각 고정" enabled="true">
          <stringProp name="TestPlan.comments">테스트 제어 요청이다. 서버의 처리 기준 시각을 이 실행의 시작 시각으로 고정한다. 서버는 이 시각으로 예약 만료 시각과 발송 기한을 계산한다. 「종료 정리: 처리 기준 시각 고정 해제」 그룹을 실행할 때까지 고정된다.</stringProp>
          <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
          <stringProp name="HTTPSampler.path">/ChatService/test-support/clock</stringProp>
          <stringProp name="HTTPSampler.method">PUT</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{&quot;instant&quot;:&quot;${t0}&quot;}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="JSON 헤더" enabled="true">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
