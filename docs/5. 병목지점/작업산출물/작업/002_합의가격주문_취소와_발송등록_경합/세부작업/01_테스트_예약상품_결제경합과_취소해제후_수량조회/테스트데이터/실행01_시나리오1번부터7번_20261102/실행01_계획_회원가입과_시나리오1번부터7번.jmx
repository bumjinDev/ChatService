              <stringProp name="JSONPostProcessor.referenceNames">offer_available</stringProp>
              <stringProp name="JSONPostProcessor.jsonPathExprs">$.availableQuantity</stringProp>
              <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
              <stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND</stringProp>
            </JSONPostProcessor>
            <hashTree/>
            <ResultSaver guiclass="ResultSaverGui" testclass="ResultSaver" testname="응답 본문 저장(실행 폴더의 정가결제성공_6번_추가제안구매자_상품조회응답)" enabled="true">
              <stringProp name="FileSaver.filename">${outDir}\정가결제성공_6번_추가제안구매자_상품조회응답</stringProp>
