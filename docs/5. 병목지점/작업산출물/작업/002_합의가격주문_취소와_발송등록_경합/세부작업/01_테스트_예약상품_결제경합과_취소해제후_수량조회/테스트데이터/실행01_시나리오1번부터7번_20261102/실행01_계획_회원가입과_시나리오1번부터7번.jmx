        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="「시나리오 2번: 결제와 수락 경합(세 요청을 같은 순간에 보냄)」 그룹의 응답 코드로 이어갈 흐름 정하기(실행 폴더의 2번_응답코드와_이어갈_흐름.csv)" enabled="true">
          <stringProp name="TestPlan.comments">「시나리오 2번: 결제와 수락 경합(세 요청을 같은 순간에 보냄)」 그룹의 세 응답 코드를 실행 폴더의 2번_응답코드와_이어갈_흐름.csv에 쓴다. 정가 구매자의 결제가 201이고 판매자의 수락이 200이 아니면 정가 결제 성공 흐름, 판매자의 수락이 200이고 정가 구매자의 결제가 201이 아니면 추가 제안 수락 성공 흐름, 그 밖에는 해당없음으로 적는다. 흐름 그룹들은 이 값을 읽지 않으며, 이 결과를 보고 실행할 흐름의 그룹을 고른다.</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">// 2번의 세 응답 코드로 이어갈 흐름을 정하고, 실행 폴더의 2번_응답코드와_이어갈_흐름.csv에 쓴다.
// 정가 구매자의 결제가 201이고 추가 제안 수락이 200이 아니면 정가결제성공흐름,
// 추가 제안 수락이 200이고 정가 구매자의 결제가 201이 아니면 추가제안수락성공흐름, 그 밖에는 해당없음이다.
String c = props.get(&apos;step2_cancel_code&apos;) ?: &apos;응답없음&apos;
String l = props.get(&apos;step2_listed_code&apos;) ?: &apos;응답없음&apos;
String a = props.get(&apos;step2_accept_code&apos;) ?: &apos;응답없음&apos;
String flow = (l == &apos;201&apos; &amp;&amp; a != &apos;200&apos;) ? &apos;정가결제성공흐름&apos; : ((a == &apos;200&apos; &amp;&amp; l != &apos;201&apos;) ? &apos;추가제안수락성공흐름&apos; : &apos;해당없음&apos;)
props.put(&apos;flow&apos;, flow)
File f = new File(vars.get(&apos;outDir&apos;), &apos;2번_응답코드와_이어갈_흐름.csv&apos;)
f.setText(&apos;﻿cancel_payment_code,listed_payment_code,offer_accept_code,flow\n&apos; + [c, l, a, flow].join(&apos;,&apos;) + &apos;\n&apos;, &apos;UTF-8&apos;)
SampleResult.setResponseData(&apos;cancel=&apos; + c + &apos;, listed=&apos; + l + &apos;, accept=&apos; + a + &apos;, flow=&apos; + flow, &apos;UTF-8&apos;)
</stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="정가 결제 성공 흐름 3번: 주문 취소 구매자의 주문 취소(예약취소단계아님)">
        <stringProp name="TestPlan.comments">거래 시나리오 구성안 「3. 주문 취소 구매자가 주문만 취소하고 새 예약이 생긴다」의 정가 결제 성공 흐름. 「시나리오 2번: 결제와 수락 경합(세 요청을 같은 순간에 보냄)」 그룹에서 주문 취소 구매자의 3개 결제와 정가 구매자의 2개 결제가 성공하고, 판매자의 추가 제안 수락은 실패한 뒤다. 주문 취소 구매자가 발송 전에 구매를 철회하고 주문을 취소한다. 이 단계에서는 다른 구매자의 결제를 겹치지 않는다. 취소하면 상품 수량과 결제 금액이 돌아오고, 같은 3개가 주문 취소 구매자에게 새로 예약된다.</stringProp>
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">0</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="CSV 데이터 셋 설정(실행 폴더의 준비단계_ID와_처리기준시각.csv 읽기, 모든 스레드가 같은 줄을 씀)" enabled="true">
          <stringProp name="filename">${outDir}\준비단계_ID와_처리기준시각.csv</stringProp>
          <stringProp name="fileEncoding">UTF-8</stringProp>
          <stringProp name="variableNames">run_id,t0,product_id,conv_cancel,conv_listed,conv_offer,offer_cancel,offer_offer,reservation_cancel_1</stringProp>
          <boolProp name="ignoreFirstLine">true</boolProp>
          <stringProp name="delimiter">,</stringProp>
          <boolProp name="quotedData">true</boolProp>
          <boolProp name="recycle">true</boolProp>
          <boolProp name="stopThread">false</boolProp>
          <stringProp name="shareMode">shareMode.all</stringProp>
        </CSVDataSet>
